const socialLinks = [
  {
    label: "Fanpage",
    value: "Product Builder Community",
    valueVi: "Cộng đồng Product Builder",
    role: "Community Grove",
    roleVi: "Vườn cộng đồng",
    note: "Connect & exchange",
    noteVi: "Kết nối & trao đổi",
    href: "https://www.facebook.com/groups/780925227802493",
    mark: "f",
    className: "bento-card fanpage-card",
  },
  {
    label: "YouTube",
    value: "@trihuynh6703",
    role: "Field Notes",
    roleVi: "Ghi chép thực địa",
    note: "Ideas & experiments",
    noteVi: "Ý tưởng & thử nghiệm",
    href: "https://www.youtube.com/@trihuynh6703",
    mark: "▶",
    className: "bento-card youtube-card",
  },
  {
    label: "GitHub",
    value: "@HuynhTri-dev",
    role: "Code Garden",
    roleVi: "Vườn mã nguồn",
    note: "Personal code & projects",
    noteVi: "Mã nguồn & dự án cá nhân",
    href: "https://github.com/HuynhTri-dev",
    mark: "GH",
    className: "bento-card github-card personal-github-card",
  },
  {
    label: "GitHub",
    value: "@OmnimerTeam",
    role: "Product Lab",
    roleVi: "Phòng thử nghiệm sản phẩm",
    note: "From systems to useful products",
    noteVi: "Từ hệ thống đến sản phẩm hữu ích",
    href: "https://github.com/omnimerteam",
    mark: "GH",
    className: "bento-card github-card omnimer-card",
