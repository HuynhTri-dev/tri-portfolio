---
/**
 * @name contact.astro
 * @description Streamlined, visual-first contact page featuring quick communication channels, avatar profile card, and instant copy actions.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const channels = [
  {
    icon: "fa-solid fa-envelope",
    label: "Email",
    value: "huynhminhtri1109@gmail.com",
    href: "mailto:huynhminhtri1109@gmail.com",
    action: "copy",
    color: "#18c785",
  },
  {
    icon: "fa-solid fa-phone",
    label: "Phone",
    labelVi: "Điện thoại",
    value: "+84 982 294 937",
    href: "tel:+84982294937",
    action: "call",
    color: "#38bdf8",
  },
  {
    icon: "fa-brands fa-linkedin-in",
    label: "LinkedIn",
    value: "Huỳnh Minh Trí",
    href: "https://www.linkedin.com/in/huỳnh-minh-trí-bb71a0259",
    action: "open",
    color: "#60a5fa",
  },
  {
    icon: "fa-brands fa-github",
    label: "GitHub",
    value: "@HuynhTri-dev",
    href: "https://github.com/HuynhTri-dev",
    action: "open",
    color: "#e2e8f0",
  },
  {
    icon: "fa-brands fa-youtube",
    label: "YouTube",
    value: "@trihuynh6703",
    href: "https://www.youtube.com/@trihuynh6703",
    action: "open",
    color: "#f87171",
  },
  {
    icon: "fa-solid fa-users",
    label: "Community",
    labelVi: "Cộng đồng",
    value: "Product Builder Group",
    href: "https://www.facebook.com/groups/780925227802493",
    action: "open",
    color: "#a78bfa",
  },
];

const expertisePills = [
  { icon: "fa-solid fa-robot", text: "Agentic AI & RAG" },
  { icon: "fa-solid fa-server", text: "FastAPI / Node.js Backend" },
  { icon: "fa-solid fa-mobile-screen", text: "Flutter Mobile" },
  { icon: "fa-solid fa-building", text: "Odoo Enterprise Systems" },
  { icon: "fa-solid fa-seedling", text: "Circular AgriTech" },
];
---

<BaseLayout
  title="Contact — Huynh Minh Tri"
  description="Get in touch with Huynh Minh Tri for Software Engineering, Agentic AI, and Product Collaborations."
>
  <section class="contact-wrap shell" aria-labelledby="contact-heading">
    <!-- Visual Profile & Quick Connect Header -->
    <div class="contact-profile-card panel">
      <div class="profile-avatar-wrap">
        <img src="/images/avatar.png" alt="Huynh Minh Tri" class="profile-avatar" />
        <span class="status-beacon" title="Available for opportunities"></span>
      </div>

      <div class="profile-details">
        <div class="status-pill">
          <span class="dot"></span>
          <span data-en="Available for Full-time Roles & AI Projects" data-vi="Sẵn sàng cho vị trí Full-time & Dự án AI">
            Available for Full-time Roles & AI Projects
          </span>
        </div>

        <h1 id="contact-heading" data-en="Let’s create something exceptional." data-vi="Cùng tạo nên sản phẩm đột phá.">
          Let’s create something exceptional.
        </h1>

        <p data-en="Based in Ho Chi Minh City, Vietnam. Open for engineering roles, technical co-building, and custom software systems." data-vi="Tại TP. Hồ Chí Minh, Việt Nam. Sẵn sàng nhận dự án kỹ thuật, phát triển sản phẩm và giải pháp AI.">
          Based in Ho Chi Minh City, Vietnam. Open for engineering roles, technical co-building, and custom software systems.
        </p>

        <!-- Quick Expertise Chips -->
        <div class="expertise-row" aria-label="Core Focus">
          {expertisePills.map((pill) => (
            <span class="pill-chip">
              <i class={pill.icon}></i>
              <span>{pill.text}</span>
            </span>
          ))}
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="profile-cta">
        <a href="mailto:huynhminhtri1109@gmail.com" class="btn-primary-action">
          <i class="fa-solid fa-paper-plane"></i>
          <span data-en="Send Email" data-vi="Gửi Email">Send Email</span>
        </a>
        <a href="/Huynh-Minh-Tri-Software-Engineer-CV.pdf" download class="btn-secondary-action">
          <i class="fa-solid fa-file-arrow-down"></i>
          <span data-en="Download Resume" data-vi="Tải Hồ sơ CV">Download Resume</span>
        </a>
      </div>
    </div>

    <!-- Communication Bento Grid -->
    <div class="channels-grid">
      {channels.map((channel) => (
        <div class="channel-card panel" style={`--accent-color: ${channel.color}`}>
          <div class="channel-icon" aria-hidden="true">
            <i class={channel.icon}></i>
          </div>

          <div class="channel-body">
            <span class="channel-label" data-en={channel.label} data-vi={channel.labelVi ?? channel.label}>
              {channel.label}
            </span>
            <strong class="channel-value">{channel.value}</strong>
          </div>

          <div class="channel-action">
            {channel.action === "copy" ? (
              <button
                type="button"
                class="btn-channel-act"
                data-copy-email-btn
                data-copy-val={channel.value}
                aria-label="Copy email address"
              >
                <i class="fa-regular fa-copy"></i>
                <span data-en="Copy" data-vi="Sao chép">Copy</span>
              </button>
            ) : (
              <a
                href={channel.href}
                target={channel.href.startsWith("http") ? "_blank" : undefined}
                rel={channel.href.startsWith("http") ? "noreferrer" : undefined}
                class="btn-channel-act"
                aria-label={`${channel.label}: ${channel.value}`}
              >
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <span data-en="Open" data-vi="Mở">Open</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-email-btn]");

  copyBtn?.addEventListener("click", async () => {
    const value = copyBtn.dataset.copyVal || "huynhminhtri1109@gmail.com";
    const language = document.documentElement.lang === "vi" ? "vi" : "en";
    const idleLabel = language === "vi" ? "Sao chép" : "Copy";
    const copiedLabel = language === "vi" ? "Đã chép ✓" : "Copied ✓";

    try {
      await navigator.clipboard.writeText(value);
      const span = copyBtn.querySelector("span");
      if (span) span.textContent = copiedLabel;
      copyBtn.classList.add("is-success");
      setTimeout(() => {
        if (span) span.textContent = idleLabel;
        copyBtn.classList.remove("is-success");
      }, 2000);
    } catch {
      window.location.href = `mailto:${value}`;
    }
  });
</script>

<style>
  .contact-wrap {
    padding-top: 110px;
    padding-bottom: 120px;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Profile Card */
  .contact-profile-card {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) auto;
    gap: 36px;
    align-items: center;
    padding: 36px 40px;
    border-radius: 24px;
    background: linear-gradient(160deg, rgb(16 34 26 / 80%), rgb(7 16 12 / 92%));
    border: 1px solid var(--border-default);
    margin-bottom: 32px;
    backdrop-filter: blur(16px);
  }

  .profile-avatar-wrap {
    position: relative;
    width: 130px;
    height: 130px;
    border-radius: 20px;
    overflow: hidden;
    border: 2px solid rgb(24 199 133 / 40%);
    box-shadow: 0 12px 30px -8px rgb(0 0 0 / 60%), 0 0 20px -4px rgb(24 199 133 / 25%);
  }

  .profile-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-beacon {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #18c785;
    border: 2px solid #081611;
    box-shadow: 0 0 8px #18c785;
  }

  .profile-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgb(24 199 133 / 10%);
    border: 1px solid rgb(24 199 133 / 30%);
    color: #4eedb0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    width: fit-content;
  }

  .status-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #18c785;
    box-shadow: 0 0 6px #18c785;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    letter-spacing: -0.05em;
    line-height: 1.1;
    color: var(--text-main);
  }

  .profile-details p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    max-width: 580px;
  }

  .expertise-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }

  .pill-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgb(255 255 255 / 3%);
    border: 1px solid rgb(255 255 255 / 6%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .pill-chip i {
    color: var(--brand-soft);
    font-size: 0.6rem;
  }

  .profile-cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 160px;
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 12px;
    background: var(--brand-green);
    color: #030806;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-primary-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgb(24 199 133 / 40%);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 12px;
    background: rgb(255 255 255 / 4%);
    border: 1px solid rgb(255 255 255 / 12%);
    color: var(--text-main);
    font-size: 0.74rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-secondary-action:hover {
    background: rgb(255 255 255 / 8%);
    border-color: rgb(255 255 255 / 25%);
  }

  /* Bento Channels Grid */
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    border-radius: 16px;
    background: linear-gradient(170deg, rgb(13 28 21 / 65%), rgb(6 14 11 / 80%));
    border: 1px solid var(--border-default);
    transition: all var(--duration-fast) ease;
  }

  .channel-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-color, var(--brand-soft));
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 60%), 0 0 16px -6px var(--accent-color, var(--brand-soft));
  }

  .channel-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgb(255 255 255 / 3%);
    border: 1px solid rgb(255 255 255 / 6%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    color: var(--accent-color, var(--brand-soft));
  }

  .channel-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-label {
    font-size: 0.6rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .channel-value {
    font-size: 0.84rem;
    color: var(--text-main);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-top: 2px;
  }

  .btn-channel-act {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgb(255 255 255 / 4%);
    border: 1px solid rgb(255 255 255 / 8%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--duration-fast) ease;
  }

  .btn-channel-act:hover {
    background: rgb(24 199 133 / 14%);
    border-color: rgb(24 199 133 / 40%);
    color: var(--brand-soft);
  }

  .btn-channel-act.is-success {
    background: rgb(24 199 133 / 25%);
    color: #4eedb0;
    border-color: #4eedb0;
  }

  /* Responsive */
  @media (max-width: 980px) {
    .contact-profile-card {
      grid-template-columns: 110px 1fr;
      padding: 28px 24px;
      gap: 24px;
    }

    .profile-cta {
      grid-column: 1 / -1;
      flex-direction: row;
    }

    .channels-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .contact-wrap {
      padding-top: 50px;
      padding-bottom: 70px;
    }

    .contact-profile-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .profile-avatar-wrap {
      margin: 0 auto;
    }

    .status-pill {
      margin: 0 auto;
    }

    .expertise-row {
      justify-content: center;
    }

    .profile-cta {
      flex-direction: column;
    }

    .channels-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
