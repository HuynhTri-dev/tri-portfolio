  {
    label: "Email",
    value: "huynhminhtri1109@gmail.com",
    href: "mailto:huynhminhtri1109@gmail.com",
    mark: "@",
    className: "bento-card email-card",
    external: false,
  },
  {
    label: "Phone",
    labelVi: "Điện thoại",
    value: "0982 294 937",
    href: "tel:+84982294937",
    mark: "09",
    className: "bento-card phone-card",
    external: false,
  },
  {
    label: "LinkedIn",
    value: "Huỳnh Minh Trí",
    note: "Professional profile",
    noteVi: "Hồ sơ nghề nghiệp",
    href: "https://www.linkedin.com/in/huỳnh-minh-trí-bb71a0259",
    mark: "in",
    className: "bento-card linkedin-card",
    external: true,
