---

<BaseLayout
  title="Contact — Huynh Minh Tri"
  description="Contact Huynh Minh Tri by email, phone, LinkedIn or connect through Facebook, YouTube and GitHub."
>
  <section class="contact-page shell" aria-labelledby="contact-title">
    <div class="canopy canopy-left" aria-hidden="true"></div>
    <div class="canopy canopy-right" aria-hidden="true"></div>
    <div class="vine vine-left" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i>
    </div>
    <div class="vine vine-right" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>

    <header class="contact-hero">
      <div class="hero-copy">
        <span class="section-index">CONTACT HUB / 07 CHANNELS</span>
        <h1 id="contact-title">
          <span data-en="Let’s start a" data-vi="Hãy bắt đầu một"
            >Let’s start a</span
          >
          <strong data-en="conversation." data-vi="cuộc trò chuyện."
            >conversation.</strong
          >
        </h1>
      </div>
      <div class="availability">
        <div class="availability-label">
          <span class="status-dot" aria-hidden="true"></span>
          <strong data-en="Available for" data-vi="Sẵn sàng cho"
            >Available for</strong
          >
        </div>
        <p
          data-en="Backend roles · Product collaborations · Practical AI"
          data-vi="Backend · Hợp tác sản phẩm · AI thực tiễn"
        >
          Backend roles · Product collaborations · Practical AI
        </p>
      </div>
    </header>

    <section class="contact-group" aria-labelledby="direct-title">
      <div class="group-heading">
        <div>
          <span class="group-number">01</span>
          <h2 id="direct-title" data-en="Contact" data-vi="Liên hệ">Contact</h2>
        </div>
        <p
          data-en="The quickest ways to reach me directly."
          data-vi="Những cách nhanh nhất để liên hệ trực tiếp với tôi."
        >
          The quickest ways to reach me directly.
        </p>
      </div>

      <div class="bento-grid direct-grid">
        <article class="bento-card email-card">
          <span class="branch-corner" aria-hidden="true"></span>
          <span class="card-mark" aria-hidden="true">@</span>
          <a
            class="card-arrow"
            href="mailto:huynhminhtri1109@gmail.com"
            aria-label="Email: huynhminhtri1109@gmail.com"
          >
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </a>
          <div class="card-content">
            <small>Email</small>
            <a class="contact-email" href="mailto:huynhminhtri1109@gmail.com">
              huynhminhtri1109@gmail.com
            </a>
            <div class="email-actions">
              <button
                type="button"
                class="copy-email"
                data-copy-email
                data-en="Copy email"
                data-vi="Sao chép email"
              >
                Copy email
              </button>
              <span class="copy-leaf" aria-hidden="true"></span>
            </div>
          </div>
        </article>

        {
          contactMethods.slice(1).map((method) => (
            <a
              class={method.className}
              href={method.href}
              target={method.external ? "_blank" : undefined}
              rel={method.external ? "noreferrer" : undefined}
              aria-label={`${method.label}: ${method.value}`}
            >
              <span class="branch-corner" aria-hidden="true" />
              <span class="card-mark" aria-hidden="true">
                {method.mark}
              </span>
              <span class="card-arrow" aria-hidden="true">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </span>
              <span class="card-content">
                <small
                  data-en={method.label}
                  data-vi={method.labelVi ?? method.label}
                >
                  {method.label}
                </small>
                <strong>{method.value}</strong>
                {method.note && (
                  <span data-en={method.note} data-vi={method.noteVi}>
                    {method.note}
                  </span>
                )}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="contact-group availability-group" aria-labelledby="availability-title">
      <div class="group-heading">
        <div>
          <span class="group-number">02</span>
          <h2 id="availability-title" data-en="Work Availability" data-vi="Sẵn sàng hợp tác">Work Availability</h2>
        </div>
        <p
          data-en="Open for full-time positions, custom contract engineering, and product design."
          data-vi="Sẵn sàng cho các vị trí full-time, dự án phần mềm theo yêu cầu và thiết kế sản phẩm."
        >
          Open for full-time positions, custom contract engineering, and product design.
        </p>
      </div>

      <div class="bento-grid availability-grid">
        <article class="bento-card avail-card">
          <span class="branch-corner" aria-hidden="true"></span>
          <span class="card-mark" aria-hidden="true"><i class="fa-solid fa-briefcase"></i></span>
          <div class="card-content">
            <small data-en="Full-time Roles" data-vi="Vị trí Full-time">Full-time Roles</small>
            <strong data-en="Engineering & Product Design" data-vi="Kỹ thuật & Thiết kế sản phẩm">Engineering & Product Design</strong>
            <p data-en="Full-Stack AI Engineer, Backend Engineer (FastAPI/Node.js), Mobile Developer (Flutter), Web Developer (Design & Code)" data-vi="Full-Stack AI Engineer, Backend Engineer (FastAPI/Node.js), Lập trình di động (Flutter), Lập trình Web (Thiết kế & Lập trình)">
              Full-Stack AI Engineer, Backend Engineer (FastAPI/Node.js), Mobile Developer (Flutter), Web Developer (Design & Code)
            </p>
          </div>
        </article>

        <article class="bento-card avail-card">
          <span class="branch-corner" aria-hidden="true"></span>
          <span class="card-mark" aria-hidden="true"><i class="fa-solid fa-rocket"></i></span>
          <div class="card-content">
            <small data-en="Contract & Freelance" data-vi="Dự án & Freelance">Contract & Freelance</small>
            <strong data-en="AI & Systems Development" data-vi="Phát triển AI & Hệ thống">AI & Systems Development</strong>
            <p data-en="AI Agents Development, Hybrid RAG Systems, Wearable Biometrics Processing Pipeline, Web & Mobile Design" data-vi="Xây dựng AI Agents, Hệ thống Hybrid RAG, Đường ống xử lý sinh hiệu Wearable, Thiết kế Web & App">
              AI Agents Development, Hybrid RAG Systems, Wearable Biometrics Processing Pipeline, Web & Mobile Design
            </p>
          </div>
        </article>

        <article class="bento-card avail-card">
          <span class="branch-corner" aria-hidden="true"></span>
          <span class="card-mark" aria-hidden="true"><i class="fa-solid fa-earth-americas"></i></span>
          <div class="card-content">
            <small data-en="Work Mode" data-vi="Hình thức làm việc">Work Mode</small>
            <strong data-en="Remote & Hybrid Setup" data-vi="Linh hoạt Remote & Hybrid">Remote & Hybrid Setup</strong>
            <p data-en="Remote (Global / Vietnam) or Hybrid (Ho Chi Minh City)" data-vi="Remote (Toàn cầu / Việt Nam) hoặc Hybrid (TP.HCM)">
              Remote (Global / Vietnam) or Hybrid (Ho Chi Minh City)
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="contact-group social-group" aria-labelledby="social-title">
      <div class="group-heading">
        <div>
          <span class="group-number">03</span>
          <h2 id="social-title">Social</h2>
        </div>
        <p
          data-en="Follow the work, ideas and things I am building."
          data-vi="Theo dõi công việc, ý tưởng và những sản phẩm tôi đang xây dựng."
        >
          Follow the work, ideas and things I am building.
        </p>
      </div>

      <div class="bento-grid social-grid">
        <div class="forest-trail" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        {
          socialLinks.map((social, index) => (
            <a
              class={social.className}
              href={social.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${social.label}: ${social.value}`}
              style={`--trail-index: ${index}`}
            >
              <span class="branch-corner" aria-hidden="true" />
              <span class="card-mark" aria-hidden="true">
                {social.mark}
              </span>
              <span class="card-arrow" aria-hidden="true">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </span>
              <span class="card-content">
                <small data-en={social.role} data-vi={social.roleVi}>
                  {social.role}
                </small>
                <span class="platform">{social.label}</span>
                <strong
                  data-en={social.value}
                  data-vi={social.valueVi ?? social.value}
                >
                  {social.value}
                </strong>
                <span
                  data-en={social.note}
                  data-vi={social.noteVi ?? social.note}
                >
                  {social.note}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="forest-floor" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </section>
</BaseLayout>

<script>
  const copyEmailButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");

  copyEmailButton?.addEventListener("click", async () => {
    const email = "huynhminhtri1109@gmail.com";
    const language = document.documentElement.lang === "vi" ? "vi" : "en";
    const idleLabel = language === "vi" ? "Sao chép email" : "Copy email";

    try {
      await navigator.clipboard.writeText(email);
      copyEmailButton.textContent =
        language === "vi" ? "Đã sao chép ✓" : "Copied ✓";
      copyEmailButton.closest(".email-actions")?.classList.add("is-copied");
    } catch {
      window.location.href = `mailto:${email}`;
      return;
    }

    window.setTimeout(() => {
      copyEmailButton.textContent = idleLabel;
      copyEmailButton.closest(".email-actions")?.classList.remove("is-copied");
    }, 1800);
  });
</script>

<style>
  .contact-page {
    position: relative;
    isolation: isolate;
    padding-top: 142px;
    padding-bottom: 72px;
  }

  .contact-page::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: -3;
    width: 100vw;
    transform: translateX(-50%);
    background:
      radial-gradient(
        circle at 48% 11%,
        rgb(91 230 170 / 10%),
        transparent 25rem
      ),
      radial-gradient(
        ellipse at 8% 34%,
        rgb(10 72 50 / 16%),
        transparent 30rem
      ),
      radial-gradient(
        ellipse at 94% 72%,
        rgb(71 47 31 / 14%),
        transparent 28rem
      );
    content: "";
    pointer-events: none;
  }

  .contact-page::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: -2;
    width: 100vw;
    transform: translateX(-50%);
    background-image:
      radial-gradient(circle, rgb(255 255 255 / 5%) 0 0.7px, transparent 0.8px),
      radial-gradient(circle, rgb(117 230 178 / 3%) 0 0.6px, transparent 0.8px);
