---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectDossier from "../../components/project/ProjectDossier.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": entry.data.title,
  "description": entry.data.summary,
  "author": {
    "@type": "Person",
    "name": "Huynh Minh Tri"
  },
  "image": entry.data.image ? new URL(entry.data.image, Astro.site).toString() : new URL("/og.png", Astro.site).toString(),
  "dateCreated": entry.data.period,
  "keywords": entry.data.seoKeywords ? entry.data.seoKeywords.join(", ") : undefined,
};
---

<BaseLayout
  title={`${entry.data.title} — Huynh Minh Tri`}
  description={entry.data.summary}
  type="article"
  image={entry.data.image}
  jsonld={jsonld}
>
  <ProjectDossier project={entry.data} headings={headings}>
    <Content />
  </ProjectDossier>
</BaseLayout>
