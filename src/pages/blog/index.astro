---
/**
 * @name index.astro (blog)
 * @description Visual card grid for engineering blog articles and technical deep dives.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactSection from "../../components/home/ContactSection.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("vi-VN", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(date);
---

<BaseLayout
  title="Blog — Huynh Minh Tri"
  description="Technical field notes, system architectures, and practical lessons from building software."
>
  <section class="blog-index shell" aria-labelledby="blog-title">
    <header class="blog-hero">
      <div class="hero-left">
        <span class="section-index">FIELD NOTES / {String(posts.length).padStart(2, "0")}</span>
        <h1 id="blog-title" data-en="Engineering notes & ideas." data-vi="Ghi chép kỹ thuật & ý tưởng.">
          Engineering notes & ideas.
        </h1>
        <p
          data-en="Practical breakdowns of system designs, AI workflows, and performance optimization."
          data-vi="Phân tích chi tiết về kiến trúc hệ thống, quy trình AI và tối ưu hiệu năng."
        >
          Practical breakdowns of system designs, AI workflows, and performance optimization.
        </p>
      </div>

      <div class="blog-badge panel">
        <strong>{String(posts.length).padStart(2, "0")}</strong>
        <span data-en="Articles Published" data-vi="Bài viết đã đăng">Articles Published</span>
      </div>
    </header>

    <!-- Visual Card Grid -->
    <div class="post-grid">
      {posts.map((post) => (
        <article class="post-card panel">
          <a class="post-media" href={`/blog/${post.id}`} aria-label={post.data.title}>
            <img
              src={post.data.thumbnail}
              alt={post.data.thumbnailAlt}
              loading="lazy"
            />
            <div class="post-media-overlay"></div>
            <time datetime={post.data.pubDate.toISOString()} class="post-time-badge">
              {formatDate(post.data.pubDate)}
            </time>
          </a>

          <div class="post-card-body">
            <h2 class="post-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>

            <p class="post-desc">{post.data.description}</p>

            <div class="post-footer">
              <div class="hashtag-list" aria-label="Hashtags">
                {post.data.hashtags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
              </div>

              <a class="post-action-link" href={`/blog/${post.id}`}>
                <span data-en="Read" data-vi="Đọc">Read</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <div class="empty panel">
        <span data-en="The first note is being written." data-vi="Bài viết đầu tiên đang được chuẩn bị.">
          The first note is being written.
        </span>
      </div>
    )}
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .blog-index {
    padding-top: 104px;
    padding-bottom: 100px;
  }

  .blog-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: 44px 0 48px;
    border-bottom: 1px solid var(--border-default);
    margin-bottom: 48px;
  }

  .section-index {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  h1 {
    margin: 8px 0 10px;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .hero-left p {
    margin: 0;
    max-width: 520px;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .blog-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    border-radius: 16px;
    min-width: 130px;
  }

  .blog-badge strong {
    font-size: 1.6rem;
    font-family: var(--font-mono);
    color: var(--brand-soft);
    line-height: 1;
  }

  .blog-badge span {
    margin-top: 4px;
    font-size: 0.58rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Grid */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(170deg, rgb(14 30 23 / 70%), rgb(7 16 12 / 85%));
    border: 1px solid var(--border-default);
    transition: transform var(--duration-normal) ease, border-color var(--duration-normal) ease, box-shadow var(--duration-normal) ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: rgb(24 199 133 / 45%);
    box-shadow: 0 16px 36px -10px rgb(0 0 0 / 65%), 0 0 24px -4px rgb(24 199 133 / 12%);
  }

  .post-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #040906;
  }

  .post-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .post-card:hover .post-media img {
    transform: scale(1.04);
  }

  .post-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(7 16 12 / 90%) 100%);
    pointer-events: none;
  }

  .post-time-badge {
    position: absolute;
    bottom: 12px;
    left: 14px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgb(7 16 12 / 85%);
    border: 1px solid rgb(24 199 133 / 30%);
    color: #4eedb0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    backdrop-filter: blur(8px);
  }

  .post-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 22px 24px 24px;
  }

  .post-title {
    margin: 0 0 10px;
    font-size: 1.25rem;
    letter-spacing: -0.035em;
    line-height: 1.25;
  }

  .post-title a {
    color: var(--text-main);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .post-title a:hover {
    color: var(--brand-soft);
  }

  .post-desc {
    margin: 0 0 18px;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 4%);
  }

  .hashtag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .hashtag-list span {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgb(255 255 255 / 2%);
  }

  .post-action-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-soft);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--duration-fast) ease;
  }

  .post-action-link:hover {
    transform: translateX(3px);
  }

  .empty {
    margin-top: 30px;
    padding: 80px 24px;
    border-radius: var(--radius-standard);
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 860px) {
    .blog-hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .blog-index {
      padding-top: 50px;
    }

    .post-card-body {
      padding: 18px 20px;
    }

    .post-title {
      font-size: 1.15rem;
    }
  }
</style>
