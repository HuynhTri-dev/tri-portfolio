---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("vi-VN", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(date);
---

<BaseLayout title={`${entry.data.title} — Huynh Minh Tri`} description={entry.data.description}>
  <article class="blog-article shell">
    <a class="back-link" href="/blog">
      <span aria-hidden="true">←</span>
      <span data-en="All notes" data-vi="Tất cả bài viết">All notes</span>
    </a>

    <header class="article-header">
      <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="hashtag-list" aria-label="Hashtags">
        {entry.data.hashtags.map((tag) => <span>#{tag}</span>)}
      </div>
    </header>

    <figure class="article-cover">
      <img src={entry.data.thumbnail} alt={entry.data.thumbnailAlt} />
    </figure>

    <div class="article-layout">
      <aside class="article-aside">
        <div>
          <span data-en="Published" data-vi="Ngày đăng">Published</span>
          <strong>{formatDate(entry.data.pubDate)}</strong>
        </div>
        {entry.data.updatedDate && (
          <div>
            <span data-en="Updated" data-vi="Cập nhật">Updated</span>
            <strong>{formatDate(entry.data.updatedDate)}</strong>
          </div>
        )}
        {headings.length > 0 && (
          <nav aria-label="Table of contents">
            <span data-en="In this note" data-vi="Trong bài viết">In this note</span>
            {headings.filter((heading) => heading.depth === 2).map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        )}
      </aside>

      <div class="article-body">
        <Content />
      </div>
    </div>

    <footer class="article-footer">
      <p data-en="Have a related idea or want to discuss the system?" data-vi="Bạn có ý tưởng liên quan hoặc muốn trao đổi thêm về hệ thống?">
        Have a related idea or want to discuss the system?
      </p>
      <a href="/#contact">
        <span data-en="Start a conversation" data-vi="Bắt đầu trao đổi">Start a conversation</span>
        <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-article {
    padding-top: 118px;
    padding-bottom: 120px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-header {
    max-width: 980px;
    padding: 60px 0 54px;
  }

  time {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 18px 0 24px;
    font-size: clamp(2.8rem, 7vw, 6.6rem);
    letter-spacing: -0.07em;
    line-height: 0.98;
  }

  .article-header > p {
    max-width: 800px;
    color: var(--text-muted);
    font-size: clamp(0.95rem, 1.6vw, 1.14rem);
  }

  .hashtag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 24px;
  }

  .hashtag-list span {
    padding: 6px 10px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.54rem;
  }

  .article-cover {
    aspect-ratio: 16 / 8.2;
    margin: 0 0 72px;
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-feature);
    background: var(--elevated-background);
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: clamp(48px, 8vw, 118px);
    justify-content: center;
  }

  .article-aside {
    display: grid;
    align-content: start;
    gap: 22px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.54rem;
  }

  .article-aside > div {
    display: grid;
    gap: 4px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-default);
  }

  .article-aside strong {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .article-aside nav {
    position: sticky;
    top: 150px;
    display: grid;
    gap: 10px;
  }

  .article-aside nav > span {
    margin-bottom: 4px;
    color: var(--brand-green);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-aside nav a {
    line-height: 1.45;
    transition: color var(--duration-fast) ease;
  }

  .article-aside nav a:hover { color: var(--brand-soft); }

  .article-body {
    min-width: 0;
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.9;
  }

  .article-body :global(h2) {
    margin: 2.8em 0 0.65em;
    color: var(--text-main);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .article-body :global(h2:first-child) { margin-top: 0; }

  .article-body :global(h3) {
    margin: 2.1em 0 0.6em;
    color: var(--text-main);
    font-size: 1.2rem;
  }

  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol) { margin: 0 0 1.35em; }

  .article-body :global(a) {
    color: var(--brand-soft);
    text-decoration: underline;
    text-decoration-color: rgb(117 230 178 / 35%);
    text-underline-offset: 4px;
  }

  .article-body :global(strong) { color: var(--text-main); }

  .article-body :global(blockquote) {
    margin: 2em 0;
    padding: 20px 24px;
    border-left: 2px solid var(--brand-green);
    background: rgb(24 199 133 / 6%);
    color: var(--text-main);
    font-size: 1.05rem;
  }

  .article-body :global(img) {
    width: 100%;
    margin: 2em 0 0.7em;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-standard);
    background: var(--elevated-background);
  }

  .article-body :global(code) {
    padding: 0.18em 0.38em;
    border: 1px solid var(--border-default);
    border-radius: 5px;
    background: rgb(24 199 133 / 7%);
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .article-body :global(pre) {
    margin: 2em 0;
    overflow-x: auto;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-standard);
    background: #030806 !important;
  }

  .article-body :global(pre code) {
    display: block;
    padding: 22px;
    border: 0;
    background: transparent;
  }

  .article-body :global(hr) {
    margin: 3em 0;
    border: 0;
    border-top: 1px solid var(--border-default);
  }

  .article-footer {
    display: flex;
    max-width: 980px;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin: 88px auto 0;
    padding: 34px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-standard);
    background: rgb(24 199 133 / 5%);
  }

  .article-footer p { margin: 0; color: var(--text-muted); }

  .article-footer a {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
    color: var(--brand-soft);
    font-size: 0.72rem;
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .blog-article { padding-top: 70px; }
    .article-cover { margin-bottom: 54px; }
    .article-layout { grid-template-columns: 1fr; }
    .article-aside {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .article-aside nav { display: none; }
  }

  @media (max-width: 540px) {
    .blog-article { padding-top: 54px; padding-bottom: 80px; }
    .article-header { padding: 44px 0 36px; }
    h1 { font-size: clamp(2.5rem, 13vw, 4rem); }
    .article-cover { aspect-ratio: 4 / 3; border-radius: var(--radius-standard); }
    .article-footer { align-items: flex-start; flex-direction: column; padding: 25px; }
  }
</style>
