---
/**
 * @name [slug].astro (/blog/[slug])
 * @description Dynamic blog article reader supporting both static showcase MDX and real-time Cloudflare D1 Knowledge Base posts with verified troubleshooting problems.
 */
import { getCollection, render } from "astro:content";
import { renderMarkdown } from "../../lib/services/markdown.service";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleConsultingCta from "../../components/blog/ArticleConsultingCta.astro";
import { KnowledgeService, type ProblemRecord } from "../../lib/services/knowledge.service";
import "katex/dist/katex.min.css";

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/blog");
}

const service = new KnowledgeService();

// 1. Check if the post exists in static MDX collections
const allStaticPosts = await getCollection("blog", ({ data }) => !data.draft);
const staticEntry = allStaticPosts.find((p) => p.id === slug);

let title = "";
let description = "";
let pubDate = new Date();
let updatedDate: Date | undefined;
let thumbnail = "/images/blog/default.png";
let thumbnailAlt = "Article cover";
let hashtags: string[] = [];
let seoKeywords: string[] = [];
let isKB = false;
let kbCategory = "general";
let summaryForAgents = "";
let headings: { depth: number; slug: string; text: string }[] = [];
let ContentComponent: any = null;
let dynamicHtmlContent = "";

if (staticEntry) {
  const rendered = await render(staticEntry);
  ContentComponent = rendered.Content;
  headings = rendered.headings;
  title = staticEntry.data.title;
  description = staticEntry.data.description;
  pubDate = staticEntry.data.pubDate;
  updatedDate = staticEntry.data.updatedDate;
  thumbnail = staticEntry.data.thumbnail;
  thumbnailAlt = staticEntry.data.thumbnailAlt;
  hashtags = staticEntry.data.hashtags;
  seoKeywords = staticEntry.data.seoKeywords || [];
  isKB = staticEntry.data.isKnowledgeBase;
  kbCategory = staticEntry.data.kbCategory || "general";
  summaryForAgents = staticEntry.data.summaryForAgents || "";
} else {
  // 2. Fallback to Cloudflare D1 Database
  const dbArticle = await service.getArticleBySlug(slug);
  if (!dbArticle) {
    return Astro.redirect("/blog");
  }

  title = dbArticle.title;
  description = dbArticle.description;
  pubDate = new Date(dbArticle.pub_date);
  updatedDate = dbArticle.updated_date ? new Date(dbArticle.updated_date) : undefined;
  thumbnail = dbArticle.thumbnail;
  thumbnailAlt = dbArticle.thumbnail_alt;
  hashtags = dbArticle.hashtags;
  seoKeywords = dbArticle.seo_keywords || [];
  isKB = dbArticle.is_knowledge_base;
  kbCategory = dbArticle.kb_category;
  summaryForAgents = dbArticle.summary_for_agents || "";

  // Render raw markdown to HTML with Prism syntax highlighting
  dynamicHtmlContent = await renderMarkdown(dbArticle.raw_markdown);
}

// 3. Load attached troubleshooting problems from D1
let attachedProblems: (ProblemRecord & { renderedSolution: string })[] = [];
try {
  const rawProblems = await service.getProblemsByParent(slug);
  attachedProblems = await Promise.all(
    rawProblems.map(async (p) => ({
      ...p,
      renderedSolution: await renderMarkdown(p.solution_markdown),
    }))
  );
} catch (err) {
  console.warn("[blog/[slug].astro] Error loading problems:", err);
}

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("vi-VN", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(date);

const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description: description,
  url: articleUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
  author: {
    "@type": "Person",
    name: "Huynh Minh Tri",
    alternateName: ["Huỳnh Minh Trí", "Tri Huynh"],
    url: "https://trihuynh.omnimer.io.vn/",
    sameAs: [
      "https://github.com/HuynhTri-dev",
      "https://www.linkedin.com/in/huỳnh-minh-trí-bb71a0259",
    ],
  },
  publisher: {
    "@type": "Person",
    name: "Huynh Minh Tri",
    url: "https://trihuynh.omnimer.io.vn/",
  },
  image: new URL(thumbnail, Astro.site).toString(),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  keywords: seoKeywords.length ? seoKeywords.join(", ") : hashtags.join(", "),
  articleSection: kbCategory,
  inLanguage: "vi-VN",
};

let jsonld: any = articleSchema;
if (attachedProblems.length > 0) {
  const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: attachedProblems.map((p) => ({
      "@type": "Question",
      name: p.title,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Nguyên nhân: ${p.root_cause || ""}. Cách xử lý đã kiểm chứng: ${p.solution_markdown || ""}`,
      },
    })),
  };
  jsonld = {
    "@context": "https://schema.org",
    "@graph": [articleSchema, faqSchema],
  };
}
---

<BaseLayout 
  title={`${title} — Huynh Minh Tri`} 
  description={description}
  type="article"
  image={thumbnail}
  jsonld={jsonld}
>
  <article class="blog-article shell">
    <div class="top-nav-bar">
      <a class="back-link" href="/blog">
        <span aria-hidden="true">←</span>
        <span data-en="All notes &amp; Knowledge Base" data-vi="Tất cả bài viết &amp; Tri thức">All notes &amp; Knowledge Base</span>
      </a>

      {isKB && (
        <a class="ai-raw-pill" href={`/api/kb/${slug}?format=raw`} target="_blank" rel="noopener">
          <i class="fa-solid fa-robot"></i>
          <span>AI RAW MD (Zero Tokens Waste)</span>
        </a>
      )}
    </div>

    <header class="article-header">
      <div class="header-badge-row">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {isKB && <span class="kb-badge">KNOWLEDGE BASE / {kbCategory.toUpperCase()}</span>}
      </div>

      <h1>{title}</h1>
      <p>{description}</p>
      
      <div class="hashtag-list" aria-label="Hashtags">
        {hashtags.map((tag) => <span>#{tag}</span>)}
      </div>
    </header>

    {thumbnail && (
      <figure class="article-cover">
        <img 
          src={thumbnail} 
          alt={thumbnailAlt} 
          onerror="this.onerror=null; this.src='/images/blog/default.png';" 
        />
      </figure>
    )}

    <div class="article-layout">
      <aside class="article-aside">
        <div>
          <span data-en="Published" data-vi="Ngày đăng">Published</span>
          <strong>{formatDate(pubDate)}</strong>
        </div>
        {updatedDate && (
          <div>
            <span data-en="Updated" data-vi="Cập nhật">Updated</span>
            <strong>{formatDate(updatedDate)}</strong>
          </div>
        )}
        {attachedProblems.length > 0 && (
          <div>
            <span data-en="Troubleshooting" data-vi="Lỗi đã xử lý">Troubleshooting</span>
            <strong class="problem-count-text">
              <a href="#troubleshooting-section">{attachedProblems.length} issue(s) documented</a>
            </strong>
          </div>
        )}
        {headings.length > 0 && (
          <nav aria-label="Table of contents">
            <span data-en="In this note" data-vi="Trong bài viết">In this note</span>
            {headings.filter((heading) => heading.depth === 2).map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
            {attachedProblems.length > 0 && (
              <a href="#troubleshooting-section">Troubleshooting Case Studies</a>
            )}
          </nav>
        )}
      </aside>

      <div class="article-content-container">
        <!-- Main Article Content Body -->
        <div class="article-body">
          {ContentComponent ? (
            <ContentComponent />
          ) : (
            <div set:html={dynamicHtmlContent} />
          )}
        </div>

        <!-- Section: Troubleshooting & Verified Problem Solutions (Case Studies để ôn tập) -->
        {attachedProblems.length > 0 && (
          <section id="troubleshooting-section" class="troubleshooting-box panel">
            <header class="troubleshoot-header">
              <div class="troubleshoot-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </div>
              <div>
                <h2>Troubleshooting Case Studies &amp; Verified Fixes</h2>
                <p>
                  Ghi chú các lỗi thực tế gặp phải khi triển khai kiến trúc này, phân tích nguyên nhân gốc rễ và cách xử lý đã được kiểm chứng.
                </p>
              </div>
            </header>

            <div class="problem-list">
              {attachedProblems.map((p, idx) => (
                <div class="problem-item panel">
                  <div class="problem-item-top">
                    <span class="problem-index">CASE #{String(idx + 1).padStart(2, "0")}</span>
                    {p.error_code && <span class="error-code-badge">{p.error_code}</span>}
                    {p.environment && <span class="env-badge">{p.environment}</span>}
                  </div>

                  <h3 class="problem-title">{p.title}</h3>

                  {p.error_snippet && (
                    <div class="symptom-box">
                      <span class="box-label">Error Symptoms / Logs</span>
                      <pre><code>{p.error_snippet}</code></pre>
                    </div>
                  )}

                  <div class="cause-box">
                    <span class="box-label">Root Cause Analysis</span>
                    <p>{p.root_cause}</p>
                  </div>

                  <div class="solution-box">
                    <span class="box-label">Verified Solution &amp; Workaround</span>
                    <div class="solution-content" set:html={p.renderedSolution} />
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>

    <!-- Inbound Engineering & Consulting Lead Conversion Funnel -->
    <ArticleConsultingCta articleCategory={kbCategory} />

    <footer class="article-footer">
      <p data-en="Have a related idea or want to discuss the system?" data-vi="Bạn có ý tưởng liên quan hoặc muốn trao đổi thêm về hệ thống?">
        Have a related idea or want to discuss the system?
      </p>
      <a href="/#contact">
        <span data-en="Start a conversation" data-vi="Bắt đầu trao đổi">Start a conversation</span>
        <span aria-hidden="true"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
      </a>
    </footer>
  </article>
</BaseLayout>

<script>
  import { initMermaidDiagrams } from "../../lib/utils/mermaid";

  /**
   * Initializes and renders interactive Mermaid diagrams in blog articles
   */
  async function initMermaid() {
    await initMermaidDiagrams();
  }

  /**
   * Initializes KaTeX math rendering for LaTeX formulas ($...$ and $$...$$)
   */
  async function initKatex() {
    const targets = document.querySelectorAll(".article-body, .solution-content");
    if (!targets.length) return;

    try {
      const { default: renderMathInElement } = await import("katex/dist/contrib/auto-render.mjs");
      targets.forEach((target) => {
        renderMathInElement(target as HTMLElement, {
          delimiters: [
            { left: "$$", right: "$$", display: true },
            { left: "$", right: "$", display: false },
            { left: "\\(", right: "\\)", display: false },
            { left: "\\[", right: "\\]", display: true },
          ],
          throwOnError: false,
          ignoredTags: ["script", "noscript", "style", "textarea", "pre", "code"],
        });
      });
    } catch (err) {
      console.error("Failed to load KaTeX auto-render:", err);
    }
  }

  function initContentEnhancements() {
    initMermaid();
    initKatex();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContentEnhancements);
  } else {
    initContentEnhancements();
  }
  document.addEventListener("astro:page-load", initContentEnhancements);
</script>

<style>
  .blog-article {
    padding-top: 118px;
    padding-bottom: 120px;
  }

  .top-nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-raw-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: rgb(24 199 133 / 10%);
    border: 1px solid rgb(24 199 133 / 30%);
    color: #4eedb0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .ai-raw-pill:hover {
    background: rgb(24 199 133 / 20%);
    transform: translateY(-1px);
  }

  .article-header {
    max-width: 980px;
    padding: 40px 0 50px;
  }

  .header-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  time {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kb-badge {
    padding: 2px 8px;
    border-radius: 4px;
    background: rgb(24 199 133 / 15%);
    border: 1px solid rgb(24 199 133 / 30%);
    color: #4eedb0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 12px 0 20px;
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .article-header > p {
    max-width: 800px;
    color: var(--text-muted);
    font-size: clamp(0.95rem, 1.6vw, 1.14rem);
    line-height: 1.6;
  }

  .hashtag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 24px;
  }

  .hashtag-list span {
    padding: 6px 10px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.54rem;
  }

  .article-cover {
    aspect-ratio: 16 / 8.2;
    margin: 0 0 72px;
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-feature);
    background: var(--elevated-background);
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: clamp(48px, 8vw, 118px);
    justify-content: center;
  }

  .article-aside {
    display: grid;
    align-content: start;
    gap: 22px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.54rem;
  }

  .article-aside > div {
    display: grid;
    gap: 4px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-default);
  }

  .article-aside strong {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .problem-count-text a {
    color: #facc15;
    text-decoration: none;
  }

  .article-aside nav {
    position: sticky;
    top: 150px;
    display: grid;
    gap: 10px;
  }

  .article-aside nav > span {
    margin-bottom: 4px;
    color: var(--brand-green);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-aside nav a {
    line-height: 1.45;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .article-aside nav a:hover { color: var(--brand-soft); }

  .article-content-container {
    min-width: 0;
  }

  .article-body {
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.9;
  }

  .article-body :global(h2) {
    margin: 2.8em 0 0.65em;
    color: var(--text-main);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .article-body :global(h2:first-child) { margin-top: 0; }

  .article-body :global(h3) {
    margin: 2.1em 0 0.6em;
    color: var(--text-main);
    font-size: 1.2rem;
  }

  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol) { margin: 0 0 1.35em; }

  .article-body :global(a) {
    color: var(--brand-soft);
    text-decoration: underline;
    text-decoration-color: rgb(117 230 178 / 35%);
    text-underline-offset: 4px;
  }

  .article-body :global(strong) { color: var(--text-main); }

  .article-body :global(blockquote) {
    margin: 2em 0;
    padding: 20px 24px;
    border-left: 2px solid var(--brand-green);
    background: rgb(24 199 133 / 6%);
    color: var(--text-main);
    font-size: 1.05rem;
  }

  .article-body :global(code) {
    padding: 0.18em 0.38em;
    border: 1px solid var(--border-default);
    border-radius: 5px;
    background: rgb(24 199 133 / 7%);
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .article-body :global(pre) {
    margin: 2em 0;
    overflow-x: auto;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-standard);
    background: #030806 !important;
  }

  .article-body :global(pre code) {
    display: block;
    padding: 22px;
    border: 0;
    background: transparent;
    color: #e1e4e8;
  }

  /* Syntax Highlighting for dynamic Prism code blocks (GitHub Dark matching Shiki) */
  .article-body :global(.token.keyword),
  .solution-content :global(.token.keyword) {
    color: #f97583;
  }

  .article-body :global(.token.string),
  .article-body :global(.token.string-interpolation),
  .solution-content :global(.token.string),
  .solution-content :global(.token.string-interpolation) {
    color: #9ecbff;
  }

  .article-body :global(.token.comment),
  .solution-content :global(.token.comment) {
    color: #6a737d;
    font-style: italic;
  }

  .article-body :global(.token.function),
  .solution-content :global(.token.function) {
    color: #b392f0;
  }

  .article-body :global(.token.class-name),
  .solution-content :global(.token.class-name) {
    color: #b392f0;
  }

  .article-body :global(.token.number),
  .article-body :global(.token.boolean),
  .article-body :global(.token.builtin),
  .solution-content :global(.token.number),
  .solution-content :global(.token.boolean),
  .solution-content :global(.token.builtin) {
    color: #79b8ff;
  }

  .article-body :global(.token.operator),
  .solution-content :global(.token.operator) {
    color: #f97583;
  }

  .article-body :global(.token.punctuation),
  .solution-content :global(.token.punctuation) {
    color: #e1e4e8;
  }

  .article-body :global(.token.property),
  .article-body :global(.token.parameter),
  .solution-content :global(.token.property),
  .solution-content :global(.token.parameter) {
    color: #ffab70;
  }

  /* KaTeX Math Styling */
  .article-body :global(.katex),
  .solution-content :global(.katex) {
    color: #e8f2ed;
    font-size: 1.08em;
  }

  .article-body :global(.katex-display),
  .solution-content :global(.katex-display) {
    position: relative;
    margin: 24px 0 28px;
    padding: 24px 22px;
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid rgb(117 230 178 / 22%);
    border-left: 3px solid var(--brand-green);
    border-radius: 14px;
    background:
      radial-gradient(circle at 94% 0%, rgb(59 130 246 / 10%), transparent 34%),
      linear-gradient(135deg, rgb(24 199 133 / 6%), transparent 44%),
      rgb(5 14 11 / 92%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 3%),
      0 16px 36px rgb(0 0 0 / 14%);
    scrollbar-color: rgb(117 230 178 / 28%) transparent;
    scrollbar-width: thin;
  }

  .article-body :global(.katex-display > .katex),
  .solution-content :global(.katex-display > .katex) {
    min-width: max-content;
    text-align: left;
  }

  .article-body :global(.katex-display::before),
  .solution-content :global(.katex-display::before) {
    position: absolute;
    top: 8px;
    left: 12px;
    color: var(--brand-green);
    content: "FORMULA / MATH";
    font-family: var(--font-mono);
    font-size: 0.44rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .article-body :global(.katex-display .base),
  .solution-content :global(.katex-display .base) {
    line-height: 1.5;
  }

  /* Mermaid styling is handled globally via mermaid.css */

  /* TROUBLESHOOTING BOX */
  .troubleshooting-box {
    margin-top: 80px;
    padding: 36px;
    border-radius: 20px;
    border: 1px solid rgb(234 179 8 / 35%);
    background: linear-gradient(175deg, rgb(30 25 10 / 60%), rgb(12 10 4 / 80%));
  }

  .troubleshoot-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgb(234 179 8 / 20%);
  }

  .troubleshoot-icon {
    font-size: 1.8rem;
    color: #facc15;
  }

  .troubleshoot-header h2 {
    margin: 0 0 6px;
    font-size: 1.5rem;
    color: #fef08a;
  }

  .troubleshoot-header p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .problem-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .problem-item {
    padding: 24px;
    border-radius: 14px;
    background: rgb(7 16 12 / 60%);
    border: 1px solid rgb(255 255 255 / 8%);
  }

  .problem-item-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .problem-index {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #facc15;
    font-weight: 700;
  }

  .error-code-badge {
    padding: 2px 8px;
    border-radius: 4px;
    background: rgb(239 68 68 / 15%);
    border: 1px solid rgb(239 68 68 / 30%);
    color: #f87171;
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .env-badge {
