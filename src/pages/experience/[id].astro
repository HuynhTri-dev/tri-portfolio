---
/**
 * @name [id].astro
 * @description Detailed workplace & role dossier showcasing core engineering responsibilities, tasks, and connected systems.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { experiences } from "../../data/portfolio";

export function getStaticPaths() {
  return experiences.map((exp) => ({
    params: { id: exp.id },
    props: { experience: exp },
  }));
}

const { experience } = Astro.props;

const currentIndex = experiences.findIndex((e) => e.id === experience.id);
const prevExp = currentIndex > 0 ? experiences[currentIndex - 1] : null;
const nextExp = currentIndex < experiences.length - 1 ? experiences[currentIndex + 1] : null;
---

<BaseLayout
  title={`${experience.roleEn} — ${experience.orgName} | Huynh Minh Tri`}
  description={experience.overviewEn}
>
  <article class="experience-detail shell">
    <!-- Back Link -->
    <a class="back-nav" href="/#experience">
      <i class="fa-solid fa-arrow-left"></i>
      <span data-en="Back to track record" data-vi="Quay lại nơi làm việc">Back to track record</span>
    </a>

    <!-- Header Panel -->
    <header class="role-hero panel">
      <div class="role-hero-top">
        <div class="org-brand">
          <div class="org-logo-frame">
            <img src={experience.logo} alt={experience.orgName} class="org-logo-img" />
          </div>
          <div class="org-info">
            <span class:list={["status-pill", `status-pill--${experience.badgeType}`]}>
              {experience.badgeType === "current" && <span class="live-dot"></span>}
              <span data-en={experience.badgeEn} data-vi={experience.badgeVi}>{experience.badgeEn}</span>
            </span>
            <h1 class="org-title">{experience.orgName}</h1>
            {experience.orgHref && (
              <a href={experience.orgHref} target="_blank" rel="noreferrer" class="org-website">
                <span>{new URL(experience.orgHref).hostname}</span>
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            )}
          </div>
        </div>

        <div class="role-summary-meta">
          <div class="meta-item">
            <small data-en="ROLE" data-vi="VỊ TRÍ">ROLE</small>
            <strong data-en={experience.roleEn} data-vi={experience.roleVi}>{experience.roleEn}</strong>
          </div>
          <div class="meta-item">
            <small data-en="TIMELINE" data-vi="THỜI GIAN">TIMELINE</small>
            <span data-en={experience.periodEn} data-vi={experience.periodVi}>{experience.periodEn}</span>
          </div>
          <div class="meta-item">
            <small data-en="LOCATION" data-vi="ĐỊA ĐIỂM">LOCATION</small>
            <span data-en={experience.locationEn} data-vi={experience.locationVi}>{experience.locationEn}</span>
          </div>
        </div>
      </div>

      <div class="role-overview-bar">
        <p data-en={experience.overviewEn} data-vi={experience.overviewVi}>
          {experience.overviewEn}
        </p>
      </div>
    </header>

    <!-- Detailed Tasks & Core Responsibilities -->
    <section class="tasks-section" aria-labelledby="tasks-heading">
      <div class="section-title-wrap">
        <span class="section-kicker" data-en="CORE RESPONSIBILITIES & TASKS" data-vi="NHIỆM VỤ & TRỌNG TRÁCH CỐT LÕI">
          CORE RESPONSIBILITIES & TASKS
        </span>
        <h2 id="tasks-heading" data-en="What I do at this organization" data-vi="Chi tiết công việc và nhiệm vụ đảm nhiệm">
          What I do at this organization
        </h2>
      </div>

      <div class="tasks-grid">
        {experience.tasks.map((task, idx) => (
          <div class="task-card panel">
            <div class="task-card-header">
              <span class="task-num">{String(idx + 1).padStart(2, "0")}</span>
              <div class="task-icon-wrap" aria-hidden="true">
                <i class={task.icon ?? "fa-solid fa-check"}></i>
              </div>
            </div>

            <h3 class="task-title" data-en={task.titleEn} data-vi={task.titleVi}>
              {task.titleEn}
            </h3>

            <p class="task-desc" data-en={task.descriptionEn} data-vi={task.descriptionVi}>
              {task.descriptionEn}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Connected Project & Architecture -->
    <section class="connected-section panel">
      <div class="connected-header">
        <div class="connected-badge">
          <i class="fa-solid fa-link"></i>
          <span data-en="CONNECTED SYSTEM & PLATFORM" data-vi="HỆ THỐNG / SẢN PHẨM GẮN LIỀN">CONNECTED SYSTEM & PLATFORM</span>
        </div>
        <span class="connected-status" data-en={experience.project.statusEn} data-vi={experience.project.statusVi}>
          {experience.project.statusEn}
        </span>
      </div>

      <h3 class="connected-title" data-en={experience.project.titleEn} data-vi={experience.project.titleVi}>
        {experience.project.titleEn}
      </h3>

      <p class="connected-desc" data-en={experience.project.descriptionEn} data-vi={experience.project.descriptionVi}>
        {experience.project.descriptionEn}
      </p>

      <div class="connected-actions">
        {experience.project.links.map((link) => (
          <a
            href={link.href}
            target={link.isExternal ? "_blank" : undefined}
            rel={link.isExternal ? "noreferrer" : undefined}
            class="btn-project-link"
          >
            <span data-en={link.labelEn} data-vi={link.labelVi}>{link.labelEn}</span>
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </a>
        ))}
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="tech-section panel">
      <span class="tech-title" data-en="TECHNOLOGY STACK & TOOLS" data-vi="CÔNG NGHỆ & CÔNG CỤ SỬ DỤNG">
        TECHNOLOGY STACK & TOOLS
      </span>
      <div class="tech-list">
        {experience.technologies.map((tech) => (
          <span class="tech-chip">{tech}</span>
        ))}
      </div>
    </section>

    <!-- Workplace Pagination -->
    <nav class="experience-nav" aria-label="Workplace navigation">
      {prevExp ? (
        <a href={prevExp.detailHref} class="nav-prev panel">
          <i class="fa-solid fa-arrow-left"></i>
          <div>
            <small data-en="Previous workplace" data-vi="Nơi làm việc trước">Previous workplace</small>
            <strong>{prevExp.orgName}</strong>
          </div>
        </a>
      ) : <div></div>}

      {nextExp ? (
        <a href={nextExp.detailHref} class="nav-next panel">
          <div>
            <small data-en="Next workplace" data-vi="Nơi làm việc tiếp theo">Next workplace</small>
            <strong>{nextExp.orgName}</strong>
          </div>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      ) : <div></div>}
    </nav>
  </article>
</BaseLayout>

<style>
  .experience-detail {
    padding-top: 104px;
    padding-bottom: 120px;
    max-width: 980px;
    margin: 0 auto;
  }

  .back-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    color: var(--text-muted);
    font-size: 0.74rem;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .back-nav:hover {
    color: var(--brand-soft);
  }

  /* Hero */
  .role-hero {
    padding: 36px 40px;
    border-radius: 24px;
    background: linear-gradient(160deg, rgb(16 34 26 / 80%), rgb(7 16 12 / 92%));
    border: 1px solid var(--border-default);
    margin-bottom: 48px;
  }

  .role-hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    gap: 32px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
  }

  .org-brand {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .org-logo-frame {
    width: 68px;
    height: 68px;
    border-radius: 16px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    flex-shrink: 0;
    box-shadow: 0 8px 24px -4px rgb(0 0 0 / 40%), 0 0 16px -2px rgb(24 199 133 / 15%);
  }

  .org-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .org-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    width: fit-content;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .status-pill--current {
    background: rgb(24 199 133 / 14%);
    color: #4eedb0;
    border: 1px solid rgb(24 199 133 / 40%);
  }

  .status-pill--enterprise {
    background: rgb(59 130 246 / 12%);
    color: #93c5fd;
    border: 1px solid rgb(59 130 246 / 35%);
  }

  .status-pill--core {
    background: rgb(168 85 247 / 12%);
    color: #c084fc;
    border: 1px solid rgb(168 85 247 / 35%);
  }

  .status-pill--team {
    background: rgb(245 158 11 / 12%);
    color: #fcd34d;
    border: 1px solid rgb(245 158 11 / 35%);
  }

  .live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #18c785;
    box-shadow: 0 0 6px #18c785;
  }

  .org-title {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .org-website {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .org-website:hover {
    color: var(--brand-soft);
  }

  .role-summary-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 20px;
    border-left: 1px solid rgb(255 255 255 / 6%);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-item small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }

  .meta-item strong {
    color: var(--brand-soft);
    font-size: 0.88rem;
  }

  .meta-item span {
    color: var(--text-main);
    font-size: 0.8rem;
  }

  .role-overview-bar {
    padding-top: 20px;
  }

  .role-overview-bar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 820px;
  }

  /* Tasks Section */
  .tasks-section {
    margin-bottom: 48px;
  }

  .section-title-wrap {
    margin-bottom: 24px;
  }

  .section-kicker {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
  }

  .section-title-wrap h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    letter-spacing: -0.04em;
  }

  .tasks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .task-card {
    padding: 24px;
    border-radius: 18px;
    background: linear-gradient(170deg, rgb(13 28 21 / 65%), rgb(6 14 11 / 80%));
    border: 1px solid var(--border-default);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .task-card:hover {
    transform: translateY(-3px);
    border-color: rgb(24 199 133 / 35%);
  }

  .task-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .task-num {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .task-icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgb(24 199 133 / 10%);
    border: 1px solid rgb(24 199 133 / 25%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-soft);
    font-size: 0.75rem;
  }

  .task-title {
    margin: 0;
    font-size: 1.05rem;
    color: var(--text-main);
    letter-spacing: -0.02em;
  }

  .task-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  /* Connected Section */
  .connected-section {
    padding: 30px;
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(15 32 24 / 70%), rgb(6 14 11 / 85%));
    border: 1px solid var(--border-default);
    margin-bottom: 24px;
  }

  .connected-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .connected-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .connected-status {
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 3%);
    border: 1px solid rgb(255 255 255 / 8%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .connected-title {
    margin: 0 0 8px;
    font-size: 1.25rem;
    color: var(--text-main);
    letter-spacing: -0.03em;
  }

  .connected-desc {
    margin: 0 0 20px;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.55;
    max-width: 740px;
  }

  .connected-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn-project-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 10px;
    background: rgb(24 199 133 / 12%);
    border: 1px solid rgb(24 199 133 / 35%);
    color: var(--brand-soft);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-project-link:hover {
    background: var(--brand-green);
    color: #030806;
    border-color: var(--brand-green);
  }

  /* Tech Section */
  .tech-section {
    padding: 24px 30px;
    border-radius: 18px;
    background: rgb(9 22 17 / 60%);
    border: 1px solid var(--border-default);
    margin-bottom: 48px;
  }

  .tech-title {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-chip {
    padding: 4px 10px;
    border-radius: 6px;
    background: rgb(255 255 255 / 3%);
    border: 1px solid rgb(255 255 255 / 7%);
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  /* Workplace Pagination */
  .experience-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .nav-prev,
  .nav-next {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    border-radius: 16px;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .nav-prev:hover,
  .nav-next:hover {
    border-color: rgb(24 199 133 / 40%);
    background: rgb(24 199 133 / 5%);
  }

  .nav-next {
    justify-content: flex-end;
    text-align: right;
  }

  .nav-prev small,
  .nav-next small {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .nav-prev strong,
  .nav-next strong {
    color: var(--text-main);
    font-size: 0.85rem;
  }

  .nav-prev i,
  .nav-next i {
    color: var(--brand-soft);
    font-size: 0.9rem;
  }

  /* Responsive */
  @media (max-width: 820px) {
    .role-hero-top {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .role-summary-meta {
      padding-left: 0;
      border-left: 0;
      padding-top: 16px;
      border-top: 1px solid rgb(255 255 255 / 6%);
      flex-direction: row;
      flex-wrap: wrap;
      gap: 20px;
    }

    .tasks-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .experience-detail {
      padding-top: 50px;
    }

    .role-hero {
      padding: 24px 20px;
    }

    .org-brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .experience-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
