---
/**
 * @name [id].astro
 * @description Detailed workplace & role dossier showcasing core engineering responsibilities, tasks, and connected systems.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { experiences } from "../../data/portfolio";

export function getStaticPaths() {
  return experiences.map((exp) => ({
    params: { id: exp.id },
    props: { experience: exp },
  }));
}

const { experience } = Astro.props;

const currentIndex = experiences.findIndex((e) => e.id === experience.id);
const prevExp = currentIndex > 0 ? experiences[currentIndex - 1] : null;
const nextExp = currentIndex < experiences.length - 1 ? experiences[currentIndex + 1] : null;

// Structured Data for SEO (Schema.org Occupation & BreadcrumbList)
const workplaceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://trihuynh.omnimer.io.vn/",
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Experience",
          "item": "https://trihuynh.omnimer.io.vn/experience",
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": experience.orgName,
          "item": `https://trihuynh.omnimer.io.vn/experience/${experience.id}`,
        },
      ],
    },
    {
      "@type": "Occupation",
      "name": experience.roleEn,
      "description": experience.overviewEn,
      "occupationalCategory": "Software Engineering",
      "skills": experience.technologies.join(", "),
      "worksFor": {
        "@type": "Organization",
        "name": experience.orgName,
        "url": experience.orgHref ?? "https://trihuynh.omnimer.io.vn/",
      },
    },
  ],
};

const modelLabels = {
  outsource: { en: "Outsource & Client Services", vi: "Dịch vụ & Dự án Khách hàng" },
  product: { en: "Enterprise Product", vi: "Sản phẩm Doanh nghiệp" },
  rd_team: { en: "AI & Product R&D Lab", vi: "Nghiên cứu & Phát triển AI" },
  core_tech: { en: "Deep-Tech Core Architecture", vi: "Công nghệ & Kiến trúc Lõi" },
};
---

<BaseLayout
  title={`${experience.roleEn} — ${experience.orgName} | Huynh Minh Tri`}
  description={experience.overviewEn}
>
  <script type="application/ld+json" set:html={JSON.stringify(workplaceSchema)} />

  <article class="experience-detail shell">
    <!-- Back Navigation -->
    <a class="back-nav" href="/#experience">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      <span data-en="Back to track record" data-vi="Quay lại nơi làm việc">Back to track record</span>
    </a>

    <!-- Header Panel -->
    <header class="role-hero panel">
      <div class="role-hero-top">
        <div class="org-brand">
          <div class="org-logo-frame">
            <img
              src={experience.logo}
              alt={experience.orgName}
              class="org-logo-img"
              width="68"
              height="68"
              loading="eager"
            />
          </div>
          <div class="org-info">
            <div class="badge-cluster">
              <span class:list={["status-pill", `status-pill--${experience.badgeType}`]}>
                {experience.badgeType === "current" && <span class="live-dot" aria-hidden="true"></span>}
                <span data-en={experience.badgeEn} data-vi={experience.badgeVi}>{experience.badgeEn}</span>
              </span>
              <span class="model-pill">
                <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                <span data-en={modelLabels[experience.model]?.en} data-vi={modelLabels[experience.model]?.vi}>
                  {modelLabels[experience.model]?.en}
                </span>
              </span>
            </div>
            <h1 class="org-title">{experience.orgName}</h1>
            {experience.orgHref && (
              <a
                href={experience.orgHref}
                target="_blank"
                rel="noreferrer"
                class="org-website"
                aria-label={`Official website of ${experience.orgName}`}
              >
                <span>{new URL(experience.orgHref).hostname}</span>
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              </a>
            )}
          </div>
        </div>

        <div class="role-summary-meta">
          <div class="meta-item">
            <small data-en="ROLE" data-vi="VỊ TRÍ">ROLE</small>
            <strong data-en={experience.roleEn} data-vi={experience.roleVi}>{experience.roleEn}</strong>
          </div>
          <div class="meta-item">
            <small data-en="TIMELINE" data-vi="THỜI GIAN">TIMELINE</small>
            <span data-en={experience.periodEn} data-vi={experience.periodVi}>{experience.periodEn}</span>
          </div>
          <div class="meta-item">
            <small data-en="LOCATION" data-vi="ĐỊA ĐIỂM">LOCATION</small>
            <span data-en={experience.locationEn} data-vi={experience.locationVi}>{experience.locationEn}</span>
          </div>
          <div class="meta-item">
            <small data-en="PROJECT SCOPE" data-vi="QUY MÔ DỰ ÁN">PROJECT SCOPE</small>
            <span class="scope-text">
              {experience.projects.length} {experience.model === "outsource" ? "Client Projects" : "Platforms"}
            </span>
          </div>
        </div>
      </div>

      <div class="role-overview-bar">
        <p data-en={experience.overviewEn} data-vi={experience.overviewVi}>
          {experience.overviewEn}
        </p>
      </div>
    </header>

    <!-- Projects & Engagements Section -->
    <section class="projects-section" aria-labelledby="projects-heading">
      <div class="section-title-wrap">
        <span
          class="section-kicker"
          data-en={experience.projects.length > 1 ? "PROJECT ENGAGEMENTS & CLIENT SYSTEMS" : "FLAGSHIP ENTERPRISE SYSTEM"}
          data-vi={experience.projects.length > 1 ? "DỰ ÁN KHÁCH HÀNG & PHÂN HỆ TRIỂN KHAI" : "HỆ THỐNG / SẢN PHẨM CỐT LÕI"}
        >
          {experience.projects.length > 1 ? "PROJECT ENGAGEMENTS & CLIENT SYSTEMS" : "FLAGSHIP ENTERPRISE SYSTEM"}
        </span>
        <h2 id="projects-heading" data-en={experience.projects.length > 1 ? "Delivered Projects & Specific Roles" : "Flagship Production Architecture"} data-vi={experience.projects.length > 1 ? "Dự án thực tế & Vai trò chuyên trách" : "Kiến trúc hệ thống vận hành thực tế"}>
          {experience.projects.length > 1 ? "Delivered Projects & Specific Roles" : "Flagship Production Architecture"}
        </h2>
      </div>

      <div class="engagement-stack">
        {experience.projects.map((proj, idx) => (
          <article class="engagement-card panel">
            <!-- Project Header -->
            <div class="engagement-header">
              <div class="engagement-title-group">
                <span class="engagement-index">PROJECT {String(idx + 1).padStart(2, "0")}</span>
                <h3 class="engagement-title" data-en={proj.titleEn} data-vi={proj.titleVi}>
                  {proj.titleEn}
                </h3>
              </div>

              <div class="engagement-status-wrap">
                {proj.isConfidential && (
                  <span class="pill-confidential" title="Confidential Client Engagement / NDA Protected">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                    <span data-en="Enterprise Client · NDA" data-vi="Khách hàng Doanh nghiệp · NDA">Enterprise Client · NDA</span>
                  </span>
                )}
                <span class="status-pill-secondary" data-en={proj.statusEn} data-vi={proj.statusVi}>
                  {proj.statusEn}
                </span>
              </div>
            </div>

            <!-- Role & Domain Meta Bar -->
            <div class="engagement-meta-bar">
              {proj.roleEn && (
                <div class="meta-tag meta-tag--role">
                  <i class="fa-solid fa-user-gear" aria-hidden="true"></i>
                  <small data-en="ROLE:" data-vi="VAI TRÒ:">ROLE:</small>
                  <strong data-en={proj.roleEn} data-vi={proj.roleVi}>{proj.roleEn}</strong>
                </div>
              )}
              {proj.clientDomainEn && (
                <div class="meta-tag meta-tag--domain">
                  <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                  <small data-en="DOMAIN:" data-vi="LĨNH VỰC:">DOMAIN:</small>
                  <span data-en={proj.clientDomainEn} data-vi={proj.clientDomainVi}>{proj.clientDomainEn}</span>
                </div>
              )}
              {proj.periodEn && (
                <div class="meta-tag meta-tag--period">
                  <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                  <span data-en={proj.periodEn} data-vi={proj.periodVi}>{proj.periodEn}</span>
                </div>
              )}
            </div>

            <!-- Project Description -->
            <p class="engagement-desc" data-en={proj.descriptionEn} data-vi={proj.descriptionVi}>
              {proj.descriptionEn}
            </p>

            <!-- Project Specific Tasks if available -->
            {proj.tasks && proj.tasks.length > 0 && (
              <div class="engagement-tasks-grid">
                {proj.tasks.map((task) => (
                  <div class="subtask-card">
                    <div class="subtask-head">
                      <i class={task.icon ?? "fa-solid fa-chevron-right"} aria-hidden="true"></i>
                      <strong data-en={task.titleEn} data-vi={task.titleVi}>{task.titleEn}</strong>
                    </div>
                    <p data-en={task.descriptionEn} data-vi={task.descriptionVi}>{task.descriptionEn}</p>
                  </div>
                ))}
              </div>
            )}

            <!-- Technologies & Links Footer -->
            <div class="engagement-footer">
              <div class="tech-chip-row">
                {proj.technologies.map((tech) => (
                  <span class="tech-chip">{tech}</span>
                ))}
              </div>

              {proj.links && proj.links.length > 0 && (
                <div class="engagement-links">
                  {proj.links.map((link) => (
                    <a
                      href={link.href}
                      target={link.isExternal ? "_blank" : undefined}
                      rel={link.isExternal ? "noreferrer" : undefined}
                      class="btn-project-link"
                    >
                      <span data-en={link.labelEn} data-vi={link.labelVi}>{link.labelEn}</span>
                      <i class={link.icon ? `fa-solid ${link.icon}` : "fa-solid fa-arrow-up-right-from-square"} aria-hidden="true"></i>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Core Engineering Standards & Responsibilities -->
    <section class="tasks-section" aria-labelledby="tasks-heading">
      <div class="section-title-wrap">
        <span class="section-kicker" data-en="CORE METHODOLOGY & DELIVERY STANDARDS" data-vi="PHƯƠNG PHÁP LUẬN & TIÊU CHUẨN KỸ THUẬT">
          CORE METHODOLOGY & DELIVERY STANDARDS
        </span>
        <h2 id="tasks-heading" data-en="Engineering Responsibilities at this Workplace" data-vi="Trọng trách kỹ thuật cốt lõi tại tổ chức">
          Engineering Responsibilities at this Workplace
        </h2>
      </div>

      <div class="tasks-grid">
        {experience.tasks.map((task, idx) => (
          <div class="task-card panel">
            <div class="task-card-header">
              <span class="task-num">{String(idx + 1).padStart(2, "0")}</span>
              <div class="task-icon-wrap" aria-hidden="true">
                <i class={task.icon ?? "fa-solid fa-check"}></i>
              </div>
            </div>

            <h3 class="task-title" data-en={task.titleEn} data-vi={task.titleVi}>
              {task.titleEn}
            </h3>

            <p class="task-desc" data-en={task.descriptionEn} data-vi={task.descriptionVi}>
              {task.descriptionEn}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Overall Tech Stack -->
    <section class="tech-section panel">
      <span class="tech-title" data-en="AGGREGATE WORKPLACE TECHNOLOGIES" data-vi="TỔNG HỢP CÔNG NGHỆ TẠI NƠI LÀM VIỆC">
        AGGREGATE WORKPLACE TECHNOLOGIES
      </span>
      <div class="tech-list">
        {experience.technologies.map((tech) => (
          <span class="tech-chip tech-chip--large">{tech}</span>
        ))}
      </div>
    </section>

    <!-- Workplace Pagination -->
    <nav class="experience-nav" aria-label="Workplace navigation">
      {prevExp ? (
        <a href={prevExp.detailHref} class="nav-prev panel">
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
          <div>
            <small data-en="Previous workplace" data-vi="Nơi làm việc trước">Previous workplace</small>
            <strong>{prevExp.orgName}</strong>
          </div>
        </a>
      ) : <div></div>}

      {nextExp ? (
        <a href={nextExp.detailHref} class="nav-next panel">
          <div>
            <small data-en="Next workplace" data-vi="Nơi làm việc tiếp theo">Next workplace</small>
            <strong>{nextExp.orgName}</strong>
          </div>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      ) : <div></div>}
    </nav>
  </article>
</BaseLayout>

<style>
  .experience-detail {
    padding-top: 104px;
    padding-bottom: 120px;
    max-width: 980px;
    margin: 0 auto;
  }

  .back-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    color: var(--text-muted);
    font-size: 0.74rem;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .back-nav:hover {
    color: var(--brand-soft);
  }

  /* Hero */
  .role-hero {
    padding: 36px 40px;
    border-radius: 24px;
    background: linear-gradient(160deg, rgb(16 34 26 / 80%), rgb(7 16 12 / 92%));
    border: 1px solid var(--border-default);
    margin-bottom: 48px;
  }

  .role-hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
    gap: 32px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
  }

  .org-brand {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .org-logo-frame {
    width: 68px;
    height: 68px;
    border-radius: 16px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    flex-shrink: 0;
    box-shadow: 0 8px 24px -4px rgb(0 0 0 / 40%), 0 0 16px -2px rgb(24 199 133 / 15%);
  }

  .org-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .org-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .badge-cluster {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .status-pill--current {
    background: rgb(24 199 133 / 14%);
    color: #4eedb0;
    border: 1px solid rgb(24 199 133 / 40%);
  }

  .status-pill--enterprise {
    background: rgb(59 130 246 / 12%);
    color: #93c5fd;
    border: 1px solid rgb(59 130 246 / 35%);
  }

  .status-pill--core {
    background: rgb(168 85 247 / 12%);
    color: #c084fc;
    border: 1px solid rgb(168 85 247 / 35%);
  }

  .status-pill--team {
    background: rgb(245 158 11 / 12%);
    color: #fcd34d;
    border: 1px solid rgb(245 158 11 / 35%);
  }

  .model-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 4%);
    border: 1px solid rgb(255 255 255 / 8%);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
  }

  .live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #18c785;
    box-shadow: 0 0 6px #18c785;
  }

  .org-title {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .org-website {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .org-website:hover {
    color: var(--brand-soft);
  }

  .role-summary-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 20px;
    border-left: 1px solid rgb(255 255 255 / 6%);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-item small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }

  .meta-item strong {
    color: var(--brand-soft);
    font-size: 0.88rem;
  }

  .meta-item span {
    color: var(--text-main);
    font-size: 0.8rem;
  }

  .scope-text {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .role-overview-bar {
    padding-top: 20px;
  }

  .role-overview-bar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 820px;
  }

  /* Section Title Common */
  .section-title-wrap {
    margin-bottom: 24px;
  }

  .section-kicker {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
  }

  .section-title-wrap h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    letter-spacing: -0.04em;
  }

  /* Projects Section */
  .projects-section {
    margin-bottom: 52px;
  }

  .engagement-stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .engagement-card {
    padding: 30px 32px;
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(15 32 24 / 75%), rgb(6 14 11 / 90%));
    border: 1px solid var(--border-default);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .engagement-card:hover {
    border-color: rgb(24 199 133 / 35%);
  }

  .engagement-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .engagement-index {
    display: block;
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }

  .engagement-title {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--text-main);
  }

  .engagement-status-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill-confidential {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgb(239 68 68 / 12%);
    border: 1px solid rgb(239 68 68 / 30%);
    color: #fca5a5;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
  }

  .status-pill-secondary {
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 3%);
    border: 1px solid rgb(255 255 255 / 8%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .engagement-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgb(0 0 0 / 25%);
    border: 1px solid rgb(255 255 255 / 4%);
    margin-bottom: 16px;
  }

  .meta-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
  }

  .meta-tag i {
    color: var(--brand-soft);
    font-size: 0.7rem;
  }

  .meta-tag small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
  }

  .meta-tag strong {
    color: #e6faf2;
  }

  .meta-tag span {
    color: var(--text-main);
  }

  .engagement-desc {
    margin: 0 0 20px;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    max-width: 860px;
  }

  .engagement-tasks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
    margin-bottom: 22px;
  }

  .subtask-card {
    padding: 14px 16px;
    border-radius: 12px;
    background: rgb(255 255 255 / 2%);
    border: 1px solid rgb(255 255 255 / 5%);
  }

  .subtask-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .subtask-head i {
    color: var(--brand-green);
    font-size: 0.72rem;
  }

  .subtask-head strong {
    font-size: 0.84rem;
    color: var(--text-main);
  }

  .subtask-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .engagement-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 6%);
  }

  .tech-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .engagement-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .btn-project-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 10px;
    background: rgb(24 199 133 / 12%);
    border: 1px solid rgb(24 199 133 / 35%);
    color: var(--brand-soft);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-project-link:hover {
    background: var(--brand-green);
    color: #030806;
    border-color: var(--brand-green);
  }

  /* General Tasks Section */
  .tasks-section {
    margin-bottom: 48px;
