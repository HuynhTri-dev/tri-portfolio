---
/**
 * @name index.astro (experience)
 * @description Track record & workplace directory listing all professional engineering roles and organizations.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { experiences } from "../../data/portfolio";
---

<BaseLayout
  title="Experience & Track Record — Huynh Minh Tri"
  description="Professional workplaces, engineering roles, and core architectural responsibilities connecting code to real-world operational impact."
>
  <section class="experience-index shell">
    <header class="index-hero">
      <span class="section-index">TRACK RECORD / 04 ORGANIZATIONS</span>
      <h1 data-en="Work & Affiliations" data-vi="Nơi làm việc & Tổ chức">
        Work & Affiliations
      </h1>
      <p data-en="Engineering environments, core system responsibilities, and operational track record." data-vi="Môi trường kỹ thuật, trọng trách hệ thống cốt lõi và hành trình thực tế.">
        Engineering environments, core system responsibilities, and operational track record.
      </p>
    </header>

    <div class="exp-card-grid">
      {experiences.map((item) => (
        <article class="exp-overview-card panel">
          <div class="exp-card-top">
            <div class="logo-box">
              <img src={item.logo} alt={item.orgName} />
            </div>
            <span class:list={["badge-tag", `badge-tag--${item.badgeType}`]}>
              <span data-en={item.badgeEn} data-vi={item.badgeVi}>{item.badgeEn}</span>
            </span>
          </div>

          <div class="exp-card-body">
            <span class="exp-period" data-en={item.periodEn} data-vi={item.periodVi}>{item.periodEn}</span>
            <h2 class="org-name">{item.orgName}</h2>
            <strong class="role-name" data-en={item.roleEn} data-vi={item.roleVi}>{item.roleEn}</strong>
            <p class="role-desc" data-en={item.overviewEn} data-vi={item.overviewVi}>{item.overviewEn}</p>
          </div>

          <div class="exp-card-footer">
            <a href={`/experience/${item.id}`} class="btn-detail">
              <span data-en="View role & tasks" data-vi="Xem chi tiết công việc">View role & tasks</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .experience-index {
    padding-top: 104px;
    padding-bottom: 120px;
  }

  .index-hero {
    padding: 44px 0 48px;
    border-bottom: 1px solid var(--border-default);
    margin-bottom: 48px;
  }

  .section-index {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  h1 {
    margin: 10px 0;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    letter-spacing: -0.05em;
  }

  .index-hero p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 580px;
  }

  .exp-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .exp-overview-card {
    display: flex;
    flex-direction: column;
    padding: 30px;
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(14 30 23 / 70%), rgb(7 16 12 / 85%));
    border: 1px solid var(--border-default);
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .exp-overview-card:hover {
    transform: translateY(-4px);
    border-color: rgb(24 199 133 / 45%);
  }

  .exp-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .logo-box {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .logo-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .badge-tag {
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .badge-tag--current {
    background: rgb(24 199 133 / 12%);
    color: #4eedb0;
    border: 1px solid rgb(24 199 133 / 35%);
  }

  .badge-tag--enterprise {
    background: rgb(59 130 246 / 12%);
    color: #93c5fd;
    border: 1px solid rgb(59 130 246 / 35%);
  }

  .badge-tag--core {
    background: rgb(168 85 247 / 12%);
    color: #c084fc;
    border: 1px solid rgb(168 85 247 / 35%);
  }

  .badge-tag--team {
    background: rgb(245 158 11 / 12%);
    color: #fcd34d;
    border: 1px solid rgb(245 158 11 / 35%);
  }

  .exp-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .exp-period {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .org-name {
    margin: 0;
    font-size: 1.35rem;
    color: var(--text-main);
    letter-spacing: -0.03em;
  }

  .role-name {
    color: var(--brand-soft);
    font-size: 0.88rem;
  }

  .role-desc {
    margin: 6px 0 16px;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .exp-card-footer {
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 4%);
  }

  .btn-detail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 10px;
    background: rgb(24 199 133 / 14%);
    border: 1px solid rgb(24 199 133 / 40%);
    color: var(--brand-soft);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-detail:hover {
    background: var(--brand-green);
    color: #030806;
    border-color: var(--brand-green);
  }

  @media (max-width: 820px) {
    .exp-card-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .experience-index {
      padding-top: 50px;
    }

    .exp-overview-card {
      padding: 22px 20px;
    }
  }
</style>
