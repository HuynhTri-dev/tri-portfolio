                  <span>FastAPI</span><span>LangGraph</span><span>Kafka</span><span>Qdrant</span><span>Neo4j</span>
                </div>
              </div>
              <div class="project-metrics">
                <div><strong>0.85</strong><span data-en="Answer relevancy" data-vi="Độ liên quan">Answer relevancy</span></div>
                <div><strong>0.78</strong><span data-en="Faithfulness" data-vi="Độ trung thực">Faithfulness</span></div>
                <div><strong>90%</strong><span data-en="Safety recall" data-vi="Safety recall">Safety recall</span></div>
              </div>
            </div>
            <a class="project-link" href="https://github.com/HuynhTri-dev/omnimer_health" target="_blank" rel="noreferrer">
