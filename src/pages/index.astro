              <span>
                <small>VNU-HCM</small>
                <strong>HCMUT</strong>
              </span>
            </a>
            <div class="education-content">
              <span class="date">SEP 2022 — OCT 2026</span>
              <h3 data-en="Ho Chi Minh City University of Technology" data-vi="Trường Đại học Bách khoa — ĐHQG TP.HCM">
                Ho Chi Minh City University of Technology
              </h3>
              <p class="degree" data-en="Information Technology · Software Engineering" data-vi="Công nghệ Thông tin · Kỹ thuật Phần mềm">
                Information Technology · Software Engineering
              </p>
