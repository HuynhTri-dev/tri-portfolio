  {
    step: "02",
    short: "AI",
    en: "Agentic AI & RAG",
    vi: "Agentic AI & RAG",
    evidenceEn: "Personal health platform",
    evidenceVi: "Nền tảng sức khỏe cá nhân",
    technologies: ["LangGraph", "ReAct", "HybridRAG", "BGE-M3", "BM25", "RAGAS"],
