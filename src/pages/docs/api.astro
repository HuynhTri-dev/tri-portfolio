<script>
  // Copy to clipboard helper
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (text) {
        try {
          await navigator.clipboard.writeText(text);
          const orig = btn.innerHTML;
          const isIconOnly = btn.classList.contains("icon-only") || btn.closest(".code-pill");
          if (isIconOnly) {
            btn.innerHTML = `<i class="fa-solid fa-check text-green-400"></i>`;
          } else {
            btn.innerHTML = `<i class="fa-solid fa-check text-green-400"></i> Copied!`;
          }
          setTimeout(() => {
            btn.innerHTML = orig;
          }, 2000);
        } catch {
          // Fallback if clipboard API is unavailable
        }
      }
    });
  });

  // Interactive Live Tester script
  const queryInput = document.getElementById("tester-query-input") as HTMLInputElement;
  const runBtn = document.getElementById("tester-run-btn");
  const statusBadge = document.getElementById("tester-status-badge");
  const timeBadge = document.getElementById("tester-time-badge");
  const urlDisplay = document.getElementById("tester-url-display");
  const outputPre = document.getElementById("tester-output")?.querySelector("code");
  const copyOutputBtn = document.getElementById("copy-tester-output");

  async function executeTestQuery() {
    if (!queryInput || !outputPre || !statusBadge || !timeBadge || !urlDisplay) return;
    const q = encodeURIComponent(queryInput.value.trim() || "workerd");
    const targetUrl = `/api/kb/search?q=${q}`;
    urlDisplay.textContent = targetUrl;
    statusBadge.textContent = "Querying...";
    statusBadge.className = "tester-status running";

    const t0 = performance.now();
    try {
      const res = await fetch(targetUrl);
      const t1 = performance.now();
      const duration = Math.round(t1 - t0);
      timeBadge.textContent = `${duration} ms`;

      statusBadge.textContent = `${res.status} ${res.statusText}`;
      statusBadge.className = res.ok ? "tester-status success" : "tester-status error";

      const data = await res.json();
      outputPre.textContent = JSON.stringify(data, null, 2);
    } catch (err: any) {
      statusBadge.textContent = "Failed";
      statusBadge.className = "tester-status error";
      outputPre.textContent = JSON.stringify({ error: err.message }, null, 2);
    }
  }

  if (runBtn) {
    runBtn.addEventListener("click", executeTestQuery);
  }

  if (queryInput) {
    queryInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        executeTestQuery();
      }
    });
  }

  if (copyOutputBtn && outputPre) {
    copyOutputBtn.addEventListener("click", async () => {
      const content = outputPre.textContent || "";
      if (content) {
        await navigator.clipboard.writeText(content);
        const orig = copyOutputBtn.innerHTML;
        copyOutputBtn.innerHTML = `<i class="fa-solid fa-check text-green-400"></i> Copied!`;
        setTimeout(() => {
          copyOutputBtn.innerHTML = orig;
        }, 2000);
      }
    });
  }
</script>

