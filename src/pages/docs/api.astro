---
/**
 * @name api.astro (/docs/api)
 * @description Interactive Knowledge Base & AI Agent REST API Documentation page with copyable cURLs, payloads, and Agent setup guides.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

const BASE_URL = "https://trihuynh.omnimer.io.vn";
---

<BaseLayout
  title="API Documentation — Knowledge Base & AI Agent Engine"
  description="Comprehensive REST API guide and AI Agent integration instructions (Cursor, Claude, OpenAI, Antigravity) for Huynh Minh Tri's Knowledge Base."
>
  <main class="api-docs-page shell">
    <!-- Header Hero -->
    <header class="api-hero panel">
      <div class="hero-tag">
        <span class="live-dot"></span>
        <span data-en="EDGE REST API · D1 FTS5 SEARCH" data-vi="EDGE REST API · TÌM KIẾM D1 FTS5">EDGE REST API · D1 FTS5 SEARCH</span>
      </div>
      <h1 data-en="Knowledge Base & AI Agent REST API" data-vi="REST API Hệ Thống Tri Thức & AI Agent">
        Knowledge Base & AI Agent REST API
      </h1>
      <p class="hero-desc" data-en="Production-ready edge API endpoints delivering raw Markdown and verified troubleshooting case studies directly to LLMs, Coding Agents, and Developers." data-vi="Hệ thống API tại biên phục vụ chuẩn Markdown và các ca xử lý lỗi thực chiến trực tiếp cho LLM, Coding Agent (Cursor, Claude, Codex, Antigravity) và Lập trình viên.">
        Production-ready edge API endpoints delivering raw Markdown and verified troubleshooting case studies directly to LLMs, Coding Agents, and Developers.
      </p>

      <div class="api-meta-grid">
        <div class="meta-card">
          <small data-en="BASE URL" data-vi="ĐỊA CHỈ NGUỒN">BASE URL</small>
          <div class="code-pill">
            <code title="https://trihuynh.omnimer.io.vn">https://trihuynh.omnimer.io.vn</code>
            <button class="copy-btn-mini icon-only" data-copy="https://trihuynh.omnimer.io.vn" title="Copy Base URL" aria-label="Copy Base URL">
              <i class="fa-regular fa-copy"></i>
            </button>
          </div>
        </div>
        <div class="meta-card">
          <small data-en="ARCHITECTURE" data-vi="KIẾN TRÚC">ARCHITECTURE</small>
          <span class="meta-val">Cloudflare Workers + D1 + FTS5</span>
        </div>
        <div class="meta-card">
          <small data-en="LATENCY" data-vi="ĐỘ TRỄ">LATENCY</small>
          <span class="meta-val text-accent">&lt; 15ms (Global Anycast Edge)</span>
        </div>
        <div class="meta-card">
          <small data-en="AUTH HEADER" data-vi="XÁC THỰC">AUTH HEADER</small>
          <span class="meta-val font-mono">Authorization: Bearer &lt;KEY&gt;</span>
        </div>
      </div>
    </header>

    <!-- Quick Navigation / TOC -->
    <nav class="api-nav-pills" aria-label="API Sections">
      <a href="#quick-agent-setup" class="nav-pill active"><i class="fa-solid fa-robot"></i> <span data-en="Agent Setup" data-vi="Cài đặt Agent">Agent Setup</span></a>
      <a href="#endpoint-catalog" class="nav-pill"><i class="fa-solid fa-list-check"></i> <span data-en="LLM Catalog" data-vi="Danh mục LLM">LLM Catalog</span></a>
      <a href="#endpoint-search" class="nav-pill"><i class="fa-solid fa-magnifying-glass"></i> <span data-en="FTS5 Search" data-vi="Tìm kiếm FTS5">FTS5 Search</span></a>
      <a href="#endpoint-articles" class="nav-pill"><i class="fa-solid fa-book-bookmark"></i> <span data-en="Articles API" data-vi="API Bài viết">Articles API</span></a>
      <a href="#endpoint-problems" class="nav-pill"><i class="fa-solid fa-bug-slash"></i> <span data-en="Troubleshooting API" data-vi="API Ghi nhận lỗi">Troubleshooting API</span></a>
      <a href="#live-playground" class="nav-pill"><i class="fa-solid fa-terminal"></i> <span data-en="Live Tester" data-vi="Thử nghiệm trực tiếp">Live Tester</span></a>
    </nav>

    <!-- Section 1: AI Agent Setup Guides -->
    <section id="quick-agent-setup" class="api-section panel">
      <div class="section-heading">
        <span class="section-icon"><i class="fa-solid fa-bolt"></i></span>
        <div>
          <h2 data-en="1. Rapid AI Coding Agent Setup" data-vi="1. Hướng Dẫn Tích Hợp Cho AI Coding Agents">
            1. Rapid AI Coding Agent Setup
          </h2>
          <p data-en="Connect Cursor, Claude Code, Antigravity, or OpenAI Codex to this centralized knowledge base." data-vi="Kết nối Cursor, Claude Code, Antigravity hoặc OpenAI Codex vào nguồn tri thức tập trung này.">
            Connect Cursor, Claude Code, Antigravity, or OpenAI Codex to this centralized knowledge base.
          </p>
        </div>
      </div>

      <div class="agent-tabs-container">
        <!-- 1. Cursor IDE -->
        <article class="agent-card">
          <div class="agent-header">
            <span class="agent-badge cursor-badge"><i class="fa-solid fa-compass"></i> Cursor IDE</span>
            <span class="method-chip">Docs &amp; .cursorrules</span>
          </div>
          <p class="agent-text" data-en="1. Add catalog to Cursor Indexing for semantic context across all codebase chats:" data-vi="1. Thêm danh mục vào Cursor Indexing để tự động nhận biết ngữ cảnh dự án:">
            1. Add catalog to Cursor Indexing for semantic context across all codebase chats:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>Cursor Settings &gt; Features &gt; Docs</span>
              <button class="copy-btn-mini" data-copy="https://trihuynh.omnimer.io.vn/llms.txt"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code>https://trihuynh.omnimer.io.vn/llms.txt</code></pre>
          </div>
          <p class="agent-subtext" data-en="2. Create or append to .cursorrules (or .cursor/rules/knowledge-base.mdc):" data-vi="2. Thêm vào tệp .cursorrules (hoặc .cursor/rules/knowledge-base.mdc):">
            2. Create or append to <code>.cursorrules</code> (or <code>.cursor/rules/knowledge-base.mdc</code>):
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>.cursorrules</span>
              <button class="copy-btn-mini" data-copy="# Knowledge Base Integration
When encountering architectural decisions, refactoring, or bugs with Kafka, Redpanda, Cloudflare D1, Fastify, or Astro:
1. Search author's verified knowledge base:
   https://trihuynh.omnimer.io.vn/api/kb/search?q={query}
2. Fetch raw markdown specification without HTML overhead:
   https://trihuynh.omnimer.io.vn/api/kb/{slug}?format=raw
3. Check verified problem solutions before writing fixes:
   https://trihuynh.omnimer.io.vn/api/kb/{parent-slug}/problems"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code># Knowledge Base Integration
When encountering architectural decisions or bugs with Kafka, D1, Fastify:
1. Search: https://trihuynh.omnimer.io.vn/api/kb/search?q=&#123;query&#125;
2. Raw MD: https://trihuynh.omnimer.io.vn/api/kb/&#123;slug&#125;?format=raw
3. Problems: https://trihuynh.omnimer.io.vn/api/kb/&#123;parent-slug&#125;/problems</code></pre>
          </div>
        </article>

        <!-- 2. Claude Code & Claude Desktop -->
        <article class="agent-card">
          <div class="agent-header">
            <span class="agent-badge claude-badge"><i class="fa-solid fa-brain"></i> Claude / Claude Code</span>
            <span class="method-chip">CLAUDE.md &amp; MCP</span>
          </div>
          <p class="agent-text" data-en="1. Add rule to CLAUDE.md in project root for automatic knowledge extraction:" data-vi="1. Tạo tệp CLAUDE.md tại thư mục gốc dự án để Claude tự động đọc tri thức:">
            1. Add rule to <code>CLAUDE.md</code> in project root for automatic knowledge extraction:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>CLAUDE.md</span>
              <button class="copy-btn-mini" data-copy="## Knowledge Base Rules
- Before suggesting system architecture or debugging edge/kafka issues, query:
  curl -s 'https://trihuynh.omnimer.io.vn/api/kb/search?q={keyword}'
- Retrieve clean markdown specs without HTML markup:
  curl -s 'https://trihuynh.omnimer.io.vn/api/kb/{slug}?format=raw'
- Never scrape web pages directly when format=raw endpoint is available."><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code>## Knowledge Base Rules
- Search: curl -s 'https://trihuynh.omnimer.io.vn/api/kb/search?q=&#123;keyword&#125;'
- Raw MD: curl -s 'https://trihuynh.omnimer.io.vn/api/kb/&#123;slug&#125;?format=raw'</code></pre>
          </div>
          <p class="agent-subtext" data-en="2. Fast CLI command for Claude Code terminal sessions:" data-vi="2. Lệnh tra cứu nhanh trong phiên dòng lệnh Claude Code:">
            2. Fast CLI command for Claude Code terminal sessions:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>Claude Code Terminal</span>
              <button class="copy-btn-mini" data-copy="curl -s 'https://trihuynh.omnimer.io.vn/api/kb/search?q=kafka+rebalance'"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code>curl -s 'https://trihuynh.omnimer.io.vn/api/kb/search?q=kafka+rebalance'</code></pre>
          </div>
        </article>

        <!-- 3. Google Antigravity & Gemini IDE -->
        <article class="agent-card">
          <div class="agent-header">
            <span class="agent-badge anti-badge"><i class="fa-solid fa-atom"></i> Antigravity Agent</span>
            <span class="method-chip">AGENTS.md &amp; Custom Skill</span>
          </div>
          <p class="agent-text" data-en="1. Place rule in workspace AGENTS.md or .agents/rules/knowledge.md:" data-vi="1. Đặt chỉ dẫn trong tệp AGENTS.md hoặc .agents/rules/knowledge.md:">
            1. Place rule in workspace <code>AGENTS.md</code> or <code>.agents/rules/knowledge.md</code>:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>AGENTS.md</span>
              <button class="copy-btn-mini" data-copy="## Knowledge Repository Protocol
- Check author's knowledge items before implementing complex features:
  GET https://trihuynh.omnimer.io.vn/api/kb/search?q={query}
- When resolving a production error, log the verified root cause and fix back to D1:
  python3 .agents/skills/knowledge_create/scripts/kb_helper.py add-problem \
    --slug '{parent-slug}' --title '{error_title}' --solution '{verified_fix}'"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code>## Knowledge Repository Protocol
- Search: GET https://trihuynh.omnimer.io.vn/api/kb/search?q=&#123;query&#125;
- Two-way sync: Log verified bugs via knowledge_create skill</code></pre>
          </div>
          <p class="agent-subtext" data-en="2. Query and publish via Antigravity custom skill CLI:" data-vi="2. Tra cứu và đăng bài thông qua skill CLI độc quyền:">
            2. Query and publish via Antigravity custom skill CLI:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>knowledge_create helper</span>
              <button class="copy-btn-mini" data-copy="python3 .agents/skills/knowledge_create/scripts/kb_helper.py search --q 'hot partition'"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code>python3 .agents/skills/knowledge_create/scripts/kb_helper.py search --q 'hot partition'</code></pre>
          </div>
        </article>

        <!-- 4. GitHub Copilot -->
        <article class="agent-card">
          <div class="agent-header">
            <span class="agent-badge copilot-badge"><i class="fa-brands fa-github"></i> GitHub Copilot</span>
            <span class="method-chip">copilot-instructions</span>
          </div>
          <p class="agent-text" data-en="Configure .github/copilot-instructions.md in your repository:" data-vi="Cấu hình tệp .github/copilot-instructions.md trong dự án của bạn:">
            Configure <code>.github/copilot-instructions.md</code> in your repository:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>.github/copilot-instructions.md</span>
              <button class="copy-btn-mini" data-copy="# Copilot Engineering Instructions
- Architecture Reference: Prioritize established patterns from https://trihuynh.omnimer.io.vn/llms.txt
- Problem Solving: Search verified case studies via https://trihuynh.omnimer.io.vn/api/kb/search?q={error}
- Follow Cloudflare D1 FTS5, Fastify, and Kafka linkedid partitioning conventions."><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code># Copilot Engineering Instructions
- Architecture Reference: https://trihuynh.omnimer.io.vn/llms.txt
- Search Fixes: https://trihuynh.omnimer.io.vn/api/kb/search?q=&#123;error&#125;</code></pre>
          </div>
        </article>

        <!-- 5. Windsurf Editor -->
        <article class="agent-card">
          <div class="agent-header">
            <span class="agent-badge windsurf-badge"><i class="fa-solid fa-water"></i> Windsurf (Cascade)</span>
            <span class="method-chip">.windsurfrules</span>
          </div>
          <p class="agent-text" data-en="Provide Cascade with direct directives in .windsurfrules:" data-vi="Cung cấp chỉ dẫn trực tiếp cho Cascade trong tệp .windsurfrules:">
            Provide Cascade with direct directives in <code>.windsurfrules</code>:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>.windsurfrules</span>
              <button class="copy-btn-mini" data-copy="# Windsurf Directives
- Knowledge Catalog: https://trihuynh.omnimer.io.vn/llms.txt
- When refactoring backend pipelines, retrieve raw markdown specifications:
  https://trihuynh.omnimer.io.vn/api/kb/{slug}?format=raw
- Check existing bug resolutions before attempting trial-and-error fixes."><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code># Windsurf Directives
- Catalog: https://trihuynh.omnimer.io.vn/llms.txt
- Raw Spec: https://trihuynh.omnimer.io.vn/api/kb/&#123;slug&#125;?format=raw</code></pre>
          </div>
        </article>

        <!-- 6. Aider & CLI Agents -->
        <article class="agent-card">
          <div class="agent-header">
            <span class="agent-badge aider-badge"><i class="fa-solid fa-terminal"></i> Aider / CLI Agents</span>
            <span class="method-chip">--read &amp; .aider.conf</span>
          </div>
          <p class="agent-text" data-en="Load knowledge catalog directly into Aider terminal sessions:" data-vi="Nạp danh mục tri thức trực tiếp vào phiên dòng lệnh Aider:">
            Load knowledge catalog directly into Aider terminal sessions:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>Aider Terminal Command</span>
              <button class="copy-btn-mini" data-copy="aider --read https://trihuynh.omnimer.io.vn/llms.txt"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code>aider --read https://trihuynh.omnimer.io.vn/llms.txt</code></pre>
          </div>
          <p class="agent-subtext" data-en="Or set in .aider.conf.yml:" data-vi="Hoặc cấu hình cố định trong .aider.conf.yml:">
            Or set in <code>.aider.conf.yml</code>:
          </p>
          <div class="code-box">
            <div class="code-box-header">
              <span>.aider.conf.yml</span>
              <button class="copy-btn-mini" data-copy="read:
  - https://trihuynh.omnimer.io.vn/llms.txt"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
            <pre><code>read:
  - https://trihuynh.omnimer.io.vn/llms.txt</code></pre>
          </div>
        </article>

        <!-- 7. Optimization Best Practices Strategy -->
        <article class="agent-card" style="grid-column: 1 / -1;">
          <div class="agent-header">
            <span class="agent-badge strategy-badge"><i class="fa-solid fa-gauge-high"></i> 3 Nguyên Tắc Vàng Tối Ưu Hóa Token &amp; Tránh Ảo Giác</span>
            <span class="method-chip" style="background: rgb(16 185 129 / 20%); color: #34d399;">Best Practices</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 4px;">
            <div style="background: rgba(0,0,0,0.3); padding: 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);">
              <h4 style="color: var(--brand-green); margin: 0 0 6px 0; font-size: 13px;"><i class="fa-solid fa-file-lines"></i> 1. Tiết Kiệm 85% Token với format=raw</h4>
              <p style="font-size: 12px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                Không bao giờ cào toàn bộ HTML/CSS của trang web. Luôn gọi endpoint <code>?format=raw</code> để nhận văn bản Markdown thuần túy, giữ cho context window của mô hình luôn gọn gàng và rẻ nhất.
              </p>
            </div>
            <div style="background: rgba(0,0,0,0.3); padding: 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);">
              <h4 style="color: #60a5fa; margin: 0 0 6px 0; font-size: 13px;"><i class="fa-solid fa-shield-halved"></i> 2. Triệt Tiêu Ảo Giác (Zero Hallucination)</h4>
              <p style="font-size: 12px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                Khi gặp ngoại lệ runtime hoặc lỗi compile, truyền ngay mã lỗi (ví dụ: <code>CommitFailedException</code>) vào <code>/api/kb/search?q=...</code> để lấy nguyên nhân gốc rễ và giải pháp đã kiểm chứng thay vì để AI đoán mò.
              </p>
            </div>
            <div style="background: rgba(0,0,0,0.3); padding: 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);">
              <h4 style="color: #f59e0b; margin: 0 0 6px 0; font-size: 13px;"><i class="fa-solid fa-arrows-rotate"></i> 3. Vòng Lặp Học Tập Hai Chiều (Bi-directional)</h4>
              <p style="font-size: 12px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                Sau khi sửa xong một lỗi mới, tự động gửi <code>POST /api/kb/&#123;slug&#125;/problems</code> ghi nhận vào D1. Nhờ đó, tất cả các AI Agents và đồng nghiệp khác trong tương lai sẽ không bao giờ lặp lại lỗi đó nữa.
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Section 2: Endpoints Specification -->
    <section class="api-section panel">
      <div class="section-heading">
        <span class="section-icon"><i class="fa-solid fa-code"></i></span>
        <div>
          <h2 data-en="2. Complete REST API Specifications" data-vi="2. Chi Tiết Thông Số Kỹ Thuật REST API">
            2. Complete REST API Specifications
          </h2>
          <p data-en="All endpoints return standard UTF-8 JSON or plain text with explicit HTTP status codes." data-vi="Tất cả các endpoint trả về dữ liệu chuẩn UTF-8 JSON hoặc Plain text với mã trạng thái HTTP rõ ràng.">
            All endpoints return standard UTF-8 JSON or plain text with explicit HTTP status codes.
          </p>
        </div>
      </div>

      <!-- Endpoint 1: llms.txt -->
      <article id="endpoint-catalog" class="endpoint-item panel">
        <div class="endpoint-top">
          <span class="badge-get">GET</span>
          <span class="endpoint-path">/llms.txt</span>
          <span class="auth-tag public"><i class="fa-solid fa-lock-open"></i> Public</span>
        </div>
        <h3 class="endpoint-title" data-en="Machine-Readable LLM Catalog" data-vi="Danh Mục Đọc Dành Riêng Cho LLM">
          Machine-Readable LLM Catalog
        </h3>
        <p class="endpoint-desc" data-en="Generates a standardized text catalog describing all available knowledge articles, categories, and direct raw markdown links for LLMs." data-vi="Sinh danh mục tóm tắt theo chuẩn llms.txt liệt kê toàn bộ bài viết, chuyên mục và đường dẫn markdown thô cho các mô hình ngôn ngữ lớn.">
          Generates a standardized text catalog describing all available knowledge articles, categories, and direct raw markdown links for LLMs.
        </p>

        <div class="endpoint-box">
          <div class="box-bar">
            <span>cURL Example</span>
            <button class="copy-btn-mini" data-copy="curl -s https://trihuynh.omnimer.io.vn/llms.txt"><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <pre><code>curl -s https://trihuynh.omnimer.io.vn/llms.txt</code></pre>
        </div>
      </article>

      <!-- Endpoint 2: Full-Text Search -->
      <article id="endpoint-search" class="endpoint-item panel">
        <div class="endpoint-top">
          <span class="badge-get">GET</span>
          <span class="endpoint-path">/api/kb/search?q=&#123;query&#125;&amp;type=all</span>
          <span class="auth-tag public"><i class="fa-solid fa-lock-open"></i> Public</span>
        </div>
        <h3 class="endpoint-title" data-en="FTS5 Full-Text Search (Articles &amp; Problems)" data-vi="Tìm Kiếm Toàn Văn FTS5 (Bài Viết &amp; Lỗi Đã Xử Lý)">
          FTS5 Full-Text Search (Articles &amp; Problems)
        </h3>
        <p class="endpoint-desc" data-en="Searches across indexed articles and documented bug solutions using Cloudflare D1 SQLite FTS5 BM25 ranking algorithm with keyword highlights." data-vi="Truy vấn toàn văn trên bài viết và kho lỗi thực chiến sử dụng thuật toán xếp hạng BM25 của FTS5, tự động tô đậm từ khóa phù hợp.">
          Searches across indexed articles and documented bug solutions using Cloudflare D1 SQLite FTS5 BM25 ranking algorithm with keyword highlights.
        </p>

        <div class="params-table-wrapper">
          <table class="params-table">
            <thead>
              <tr>
                <th>Parameter</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>q</code> (required)</td>
                <td>string</td>
                <td>-</td>
                <td>Search keyword (e.g. <code>workerd</code>, <code>memory leak</code>, <code>fhir</code>)</td>
              </tr>
              <tr>
                <td><code>type</code></td>
                <td>string</td>
                <td><code>all</code></td>
                <td>Target index: <code>all</code>, <code>article</code>, or <code>problem</code></td>
              </tr>
              <tr>
                <td><code>limit</code></td>
                <td>number</td>
                <td><code>10</code></td>
                <td>Maximum results returned (1-50)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="endpoint-box">
          <div class="box-bar">
            <span>cURL Example</span>
            <button class="copy-btn-mini" data-copy="curl -s 'https://trihuynh.omnimer.io.vn/api/kb/search?q=workerd'"><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
