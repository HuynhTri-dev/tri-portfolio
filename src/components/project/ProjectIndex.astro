---
/**
 * @name ProjectIndex.astro
 * @description Image-first project showcase with visual preview cards for live running systems, deep-dive case studies, and a sleek GitHub repository list.
 */
import { projects } from "../../data/projects";

const activeProjects = projects.filter((p) => p.group === "active");
const caseStudyProjects = projects.filter((p) => p.group === "case-study");
const githubProjects = projects.filter((p) => p.group === "github");

const filters = [
  { value: "all", en: "All", vi: "Tất cả" },
  { value: "ai", en: "AI & Data", vi: "AI & Dữ liệu" },
  { value: "enterprise", en: "Enterprise", vi: "Doanh nghiệp" },
  { value: "web", en: "Web & Mobile", vi: "Web & Mobile" },
  { value: "desktop", en: "Desktop", vi: "Desktop" },
  { value: "other", en: "Design", vi: "Thiết kế" },
];
---

<section class="project-index shell" aria-labelledby="project-index-title">
  <!-- Minimalist Visual Hero -->
  <header class="project-hero">
    <div class="hero-left">
      <div class="hero-kicker">
        <span class="live-indicator"></span>
        <span class="section-index" data-en="ENGINEERING PORTFOLIO" data-vi="DANH MỤC DỰ ÁN">ENGINEERING PORTFOLIO</span>
      </div>
      <h1 id="project-index-title" data-en="Built for reality." data-vi="Hệ thống thực chiến.">
        Built for reality.
      </h1>
      <p data-en="From active production systems to deep-dive architecture blueprints and open-source software." data-vi="Từ hệ thống vận hành thực tế đến kiến trúc chuyên sâu và mã nguồn mở.">
        From active production systems to deep-dive architecture blueprints and open-source software.
      </p>
    </div>

    <!-- Quick Stats Bar -->
    <div class="hero-stats">
      <div class="stat-box panel">
        <strong>{String(activeProjects.length).padStart(2, "0")}</strong>
        <span data-en="Live Systems" data-vi="Đang vận hành">Live Systems</span>
      </div>
      <div class="stat-box panel">
        <strong>{String(caseStudyProjects.length).padStart(2, "0")}</strong>
        <span data-en="Case Studies" data-vi="Case Studies">Case Studies</span>
      </div>
      <div class="stat-box panel">
        <strong>{String(githubProjects.length).padStart(2, "0")}</strong>
        <span data-en="Open Repos" data-vi="Mã nguồn">Open Repos</span>
      </div>
    </div>
  </header>

  <!-- Filter & Search Toolbar -->
  <div class="project-tools panel" aria-label="Project filters">
    <label class="search-field">
      <span class="sr-only" data-en="Search projects" data-vi="Tìm dự án">Search projects</span>
      <i class="fa-solid fa-magnifying-glass search-icon"></i>
      <input
        type="search"
        data-project-search
        placeholder="Filter by name, tech or client..."
        data-placeholder-en="Filter by name, tech or client..."
        data-placeholder-vi="Lọc theo tên, công nghệ hoặc đơn vị..."
        autocomplete="off"
      />
    </label>

    <div class="filter-list" role="group" aria-label="Filter projects">
      {filters.map((filter, index) => (
        <button
          type="button"
          data-project-filter={filter.value}
          aria-pressed={index === 0 ? "true" : "false"}
          data-en={filter.en}
          data-vi={filter.vi}
        >
          {filter.en}
        </button>
      ))}
    </div>
  </div>

  <!-- Result Counter & GitHub Link -->
  <div class="result-bar" aria-live="polite">
    <span class="counter-text">
      <span data-en="Showing" data-vi="Hiển thị">Showing</span>
      <strong data-project-count>{projects.length}</strong>
      <span data-en="projects" data-vi="dự án">projects</span>
    </span>
    <a href="https://github.com/HuynhTri-dev?tab=repositories" target="_blank" rel="noreferrer" class="gh-link">
      <i class="fa-brands fa-github"></i>
      <span data-en="GitHub Profile" data-vi="Trang GitHub">GitHub Profile</span>
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
    </a>
  </div>

  <!-- ============================================================ -->
  <!-- SECTION 1: PROJECT ĐANG CHẠY (ACTIVE & RUNNING SYSTEMS) -->
  <!-- ============================================================ -->
  <section class="catalogue-section" data-section-group="active">
    <div class="section-heading">
      <div class="section-badge section-badge--live">
        <span class="beacon-pulse"></span>
        <span data-en="LIVE & RUNNING SYSTEMS" data-vi="PROJECT ĐANG CHẠY · THỰC TẾ">LIVE & RUNNING SYSTEMS</span>
      </div>
      <h2 data-en="Active Deployments" data-vi="Dự án đang vận hành thực tế">
        Active Deployments
      </h2>
    </div>

    <div class="visual-card-grid">
      {activeProjects.map((project) => (
        <article
          class="visual-card panel is-live"
          data-project
          data-project-group="active"
          data-category={project.category}
          data-search={`${project.title} ${project.organization?.en ?? ""} ${project.organization?.vi ?? ""} ${project.description} ${project.descriptionVi} ${project.technologies.join(" ")}`.toLowerCase()}
        >
          <!-- Visual Image Preview -->
          <a href={project.href} class="card-media" aria-label={project.title}>
            {project.image ? (
              <img src={project.image} alt={project.title} loading="lazy" />
            ) : (
              <div class="media-placeholder"><i class="fa-solid fa-layer-group"></i></div>
            )}
            <div class="media-overlay"></div>
            
            <!-- Badges over Image -->
            <div class="media-badges">
              {project.organization && (
                <span class="badge-org">
                  <span data-en={project.organization.en} data-vi={project.organization.vi}>{project.organization.en}</span>
                </span>
              )}
              {project.statusBadge && (
                <span class:list={["badge-status", `badge-status--${project.statusBadge.type ?? 'live'}`]}>
                  <span class="pulse-dot"></span>
                  <span data-en={project.statusBadge.en} data-vi={project.statusBadge.vi}>{project.statusBadge.en}</span>
                </span>
              )}
            </div>
          </a>

          <!-- Card Content -->
          <div class="card-body">
            <div class="card-meta-line">
              <span class="card-period">{project.period}</span>
              <span class="card-category" data-en={project.type} data-vi={project.typeVi}>{project.type}</span>
            </div>

            <h3 class="card-title">
              <a href={project.href}>{project.title}</a>
            </h3>

            <p class="card-summary" data-en={project.description} data-vi={project.descriptionVi}>
              {project.description}
            </p>

            <!-- Metrics Chips -->
            {project.metrics && (
              <div class="metric-chips">
                {project.metrics.slice(0, 3).map((metric) => (
                  <div class="metric-chip">
                    <strong>{metric.value}</strong>
                    <span data-en={metric.label} data-vi={metric.labelVi}>{metric.label}</span>
                  </div>
                ))}
              </div>
            )}

            <!-- Tech Pills -->
            <div class="tech-pills">
              {project.technologies.slice(0, 4).map((tech) => (
                <span>{tech}</span>
              ))}
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="card-footer">
            <a href={project.href} class="btn-cta btn-cta--primary">
              <span data-en={project.hrefLabel ?? "Case Study"} data-vi={project.hrefLabelVi ?? "Case Study"}>
                {project.hrefLabel ?? "Case Study"}
              </span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" rel="noreferrer" class="btn-cta btn-cta--ghost">
                <span data-en={project.liveLabel ?? "Live Demo"} data-vi={project.liveLabelVi ?? "Trực Tuyến"}>
                  {project.liveLabel ?? "Live Demo"}
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- SECTION 2: DỰ ÁN TÂM ĐẮC CÓ CASE STUDY (FEATURED CASE STUDIES) -->
  <!-- ============================================================ -->
  <section class="catalogue-section" data-section-group="case-study">
    <div class="section-heading">
      <div class="section-badge section-badge--case">
        <i class="fa-solid fa-microchip"></i>
        <span data-en="FEATURED ARCHITECTURAL STUDIES" data-vi="DỰ ÁN TÂM ĐẮC · CASE STUDY">FEATURED ARCHITECTURAL STUDIES</span>
      </div>
      <h2 data-en="Deep-Dive Case Studies" data-vi="Dự án tâm đắc có Case Study">
        Deep-Dive Case Studies
      </h2>
    </div>

    <div class="visual-card-grid">
      {caseStudyProjects.map((project) => (
        <article
          class="visual-card panel is-case"
          data-project
          data-project-group="case-study"
          data-category={project.category}
          data-search={`${project.title} ${project.description} ${project.descriptionVi} ${project.technologies.join(" ")}`.toLowerCase()}
        >
          <!-- Visual Image Preview -->
          <a href={project.href} class="card-media" aria-label={project.title}>
            {project.image ? (
              <img src={project.image} alt={project.title} loading="lazy" />
            ) : (
              <div class="media-placeholder"><i class="fa-solid fa-laptop-code"></i></div>
            )}
            <div class="media-overlay"></div>
            
            <div class="media-badges">
              <span class="badge-tag">
                <span data-en={project.type} data-vi={project.typeVi}>{project.type}</span>
              </span>
            </div>
          </a>

          <!-- Card Content -->
          <div class="card-body">
            <div class="card-meta-line">
              <span class="card-period">{project.period}</span>
            </div>

            <h3 class="card-title">
              <a href={project.href}>{project.title}</a>
            </h3>

            <p class="card-summary" data-en={project.description} data-vi={project.descriptionVi}>
              {project.description}
            </p>

            <!-- Metrics Chips -->
            {project.metrics && (
              <div class="metric-chips">
                {project.metrics.slice(0, 3).map((metric) => (
                  <div class="metric-chip">
                    <strong>{metric.value}</strong>
                    <span data-en={metric.label} data-vi={metric.labelVi}>{metric.label}</span>
                  </div>
                ))}
              </div>
            )}

            <!-- Tech Pills -->
            <div class="tech-pills">
              {project.technologies.slice(0, 4).map((tech) => (
                <span>{tech}</span>
              ))}
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="card-footer">
            <a href={project.href} class="btn-cta btn-cta--primary">
              <span data-en={project.hrefLabel ?? "Case Study"} data-vi={project.hrefLabelVi ?? "Case Study"}>
                {project.hrefLabel ?? "Case Study"}
              </span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" rel="noreferrer" class="btn-cta btn-cta--ghost">
                <span data-en={project.liveLabel ?? "Live Demo"} data-vi={project.liveLabelVi ?? "Demo"}>
                  {project.liveLabel ?? "Live Demo"}
                </span>
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- SECTION 3: PROJECT (GITHUB) CÒN LẠI (DẠNG LIỆT KÊ) -->
  <!-- ============================================================ -->
  <section class="catalogue-section" data-section-group="github">
    <div class="section-heading">
      <div class="section-badge section-badge--gh">
        <i class="fa-brands fa-github"></i>
        <span data-en="GITHUB REPOSITORIES" data-vi="PROJECT (GITHUB) · LIỆT KÊ">GITHUB REPOSITORIES</span>
      </div>
      <h2 data-en="Code Archives & Tools" data-vi="Dự án GitHub (Dạng liệt kê)">
        Code Archives & Tools
      </h2>
    </div>

    <!-- Visual List View -->
    <div class="repo-list panel">
      {githubProjects.map((project, index) => (
        <article
          class="repo-row"
          data-project
          data-project-group="github"
          data-category={project.category}
          data-search={`${project.title} ${project.description} ${project.descriptionVi} ${project.technologies.join(" ")}`.toLowerCase()}
        >
          <!-- Left: Index & Mini Icon/Thumbnail -->
          <div class="repo-thumb-col">
            <span class="repo-index">{String(index + 1).padStart(2, "0")}</span>
            <div class="repo-mini-thumb">
              {project.image ? (
                <img src={project.image} alt={project.title} loading="lazy" />
              ) : (
                <i class="fa-solid fa-code"></i>
              )}
            </div>
          </div>

          <!-- Middle: Info & Tech -->
          <div class="repo-info-col">
            <div class="repo-header">
              <a href={project.href} target="_blank" rel="noreferrer" class="repo-title">
                <span>{project.title}</span>
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
              <span class="repo-type" data-en={project.type} data-vi={project.typeVi}>{project.type}</span>
              <span class="repo-period">{project.period}</span>
            </div>
            <p class="repo-desc" data-en={project.description} data-vi={project.descriptionVi}>
              {project.description}
            </p>
            <div class="repo-techs">
              {project.technologies.map((tech) => (
                <span>{tech}</span>
              ))}
            </div>
          </div>

          <!-- Right: Direct GitHub Action -->
          <div class="repo-action-col">
            <a href={project.href} target="_blank" rel="noreferrer" class="btn-gh-action">
              <i class="fa-brands fa-github"></i>
              <span data-en="Repository" data-vi="Mã nguồn">Repository</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Empty state -->
  <div class="empty-state panel" data-project-empty hidden>
    <i class="fa-solid fa-magnifying-glass empty-icon"></i>
    <h3 data-en="No projects match this search" data-vi="Không tìm thấy dự án phù hợp">No projects match this search</h3>
    <p data-en="Try changing your keywords or resetting filters." data-vi="Hãy thử thay đổi từ khóa hoặc đặt lại bộ lọc.">
      Try changing your keywords or resetting filters.
    </p>
    <button type="button" class="btn-cta btn-cta--ghost" data-clear-filters>
      <span data-en="Reset filters" data-vi="Đặt lại bộ lọc">Reset filters</span>
    </button>
  </div>
</section>

<script>
  const searchInput = document.querySelector<HTMLInputElement>("[data-project-search]");
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
  const allProjectItems = Array.from(document.querySelectorAll<HTMLElement>("[data-project]"));
  const totalCountEl = document.querySelector<HTMLElement>("[data-project-count]");
  const emptyStateEl = document.querySelector<HTMLElement>("[data-project-empty]");
  const clearFiltersBtn = document.querySelector<HTMLButtonElement>("[data-clear-filters]");
  const sectionContainers = Array.from(document.querySelectorAll<HTMLElement>("[data-section-group]"));

  let activeCategory = "all";

  const normalizeText = (value: string): string =>
    value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

  function applyFilters() {
    const query = normalizeText(searchInput?.value ?? "");
    let totalVisible = 0;

    const sectionVisibilityMap = new Map<string, number>();
    sectionContainers.forEach((sec) => {
      sectionVisibilityMap.set(sec.dataset.sectionGroup ?? "", 0);
    });

    allProjectItems.forEach((item) => {
      const itemGroup = item.dataset.projectGroup ?? "";
      const matchesCategory = activeCategory === "all" || item.dataset.category === activeCategory;
      const matchesQuery = !query || normalizeText(item.dataset.search ?? "").includes(query);
      const isVisible = matchesCategory && matchesQuery;

      item.hidden = !isVisible;
      if (isVisible) {
        totalVisible += 1;
        const currentCount = sectionVisibilityMap.get(itemGroup) ?? 0;
        sectionVisibilityMap.set(itemGroup, currentCount + 1);
      }
    });

    sectionContainers.forEach((sec) => {
      const groupName = sec.dataset.sectionGroup ?? "";
      sec.hidden = (sectionVisibilityMap.get(groupName) ?? 0) === 0;
    });

    if (totalCountEl) totalCountEl.textContent = String(totalVisible);
    if (emptyStateEl) emptyStateEl.hidden = totalVisible > 0;
  }

  searchInput?.addEventListener("input", applyFilters);

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.projectFilter ?? "all";
      filterButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      applyFilters();
    });
  });

  clearFiltersBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    activeCategory = "all";
    filterButtons.forEach((b, idx) => b.setAttribute("aria-pressed", String(idx === 0)));
    applyFilters();
  });

  window.addEventListener("portfolio:language", (event) => {
    const lang = (event as CustomEvent).detail?.language === "vi" ? "vi" : "en";
    if (searchInput) {
      searchInput.placeholder = lang === "vi"
        ? (searchInput.dataset.placeholderVi ?? "")
        : (searchInput.dataset.placeholderEn ?? "");
    }
  });

  try {
    if (searchInput && localStorage.getItem("portfolio-language") === "vi") {
      searchInput.placeholder = searchInput.dataset.placeholderVi ?? "";
    }
  } catch {
    // Non-blocking
  }
</script>

<style>
  /* Base */
  .project-index {
    padding-top: 104px;
    padding-bottom: 120px;
  }

  /* Hero */
  .project-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: 44px 0 48px;
    border-bottom: 1px solid var(--border-default);
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .live-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #18c785;
    box-shadow: 0 0 10px #18c785;
  }

  .section-index {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  h1 {
    margin: 0 0 10px;
    font-size: clamp(2.6rem, 5.5vw, 5.2rem);
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .hero-left p {
    margin: 0;
    max-width: 540px;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .hero-stats {
    display: flex;
    gap: 12px;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px 22px;
    border-radius: 16px;
    min-width: 100px;
  }

  .stat-box strong {
    font-size: 1.6rem;
    font-family: var(--font-mono);
    color: var(--brand-soft);
    line-height: 1;
  }

  .stat-box span {
    margin-top: 4px;
    font-size: 0.58rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Toolbar */
  .project-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 10px 14px;
    border-radius: 16px;
    margin-top: 36px;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    max-width: 360px;
    padding: 0 8px;
    color: var(--brand-soft);
  }

  .search-icon {
    font-size: 0.78rem;
    opacity: 0.7;
  }

  .search-field input {
    width: 100%;
    padding: 8px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-main);
    font-size: 0.8rem;
  }

  .search-field input::placeholder {
    color: var(--text-muted);
  }

  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .filter-list button {
    padding: 6px 12px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    transition: all var(--duration-fast) ease;
  }

  .filter-list button:hover {
    color: var(--text-main);
    background: rgb(255 255 255 / 3%);
  }

  .filter-list button[aria-pressed="true"] {
    border-color: var(--border-active);
    background: rgb(24 199 133 / 12%);
    color: var(--brand-soft);
    font-weight: 600;
  }

  /* Result bar */
  .result-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 4px 32px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  .counter-text strong {
    color: var(--brand-soft);
    margin: 0 4px;
  }

  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.64rem;
    transition: color var(--duration-fast) ease;
  }

  .gh-link:hover {
    color: var(--brand-soft);
  }

  /* Sections */
  .catalogue-section {
    margin-bottom: 64px;
  }

  .section-heading {
    margin-bottom: 22px;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .section-badge--live {
    background: rgb(24 199 133 / 12%);
    border: 1px solid rgb(24 199 133 / 35%);
    color: #4eedb0;
  }

  .section-badge--case {
    background: rgb(59 130 246 / 10%);
    border: 1px solid rgb(59 130 246 / 35%);
    color: #93c5fd;
  }

  .section-badge--gh {
    background: rgb(255 255 255 / 4%);
    border: 1px solid rgb(255 255 255 / 12%);
    color: var(--text-secondary);
  }

  .beacon-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #18c785;
    box-shadow: 0 0 8px #18c785;
    animation: beaconPulse 1.8s infinite ease-in-out;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  /* Visual Card Grid */
  .visual-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .visual-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(170deg, rgb(14 30 23 / 70%), rgb(7 16 12 / 85%));
