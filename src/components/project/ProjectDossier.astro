---
import type { CollectionEntry } from "astro:content";
import "katex/dist/katex.min.css";

interface Props {
  project: CollectionEntry<"projects">["data"];
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { project, headings } = Astro.props;
const documentHeadings = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 3,
);
const baseHeadingDepth = documentHeadings.length
  ? Math.min(...documentHeadings.map((heading) => heading.depth))
  : 1;
---

<article class="dossier shell">
  <a class="back-link" href="/#projects">← <span data-en="Back to projects" data-vi="Quay lại dự án">Back to projects</span></a>

  <header class="dossier-hero panel">
    <div class="project-identity">
      <span class="project-id">{project.projectId}</span>
      <span class="project-emblem">
        {project.icon ? (
          <img src={project.icon} alt={project.title} class="project-icon-img" />
        ) : (
          project.projectId.slice(-2)
        )}
      </span>
      <span class="status-badge"><i></i><span data-en={project.type} data-vi={project.typeVi}>{project.type}</span></span>
    </div>

    <div class="project-intro">
      <span class="section-index">PROJECT DOSSIER / {project.period}</span>
      <h1>{project.title}</h1>
      <p data-en={project.summary} data-vi={project.summaryVi}>{project.summary}</p>
      <div class="project-tags flex flex-wrap gap-2">
        {project.technologies.map((technology) => <span>{technology}</span>)}
      </div>
    </div>

    <aside class="project-meta">
      <div><small>ROLE</small><strong>{project.role}</strong></div>
      <div><small>PERIOD</small><strong>{project.period}</strong></div>
      {project.links?.source && (
        <a href={project.links.source} target="_blank" rel="noreferrer">
          <small>SOURCE</small><strong>GitHub ↗</strong>
        </a>
      )}
      {project.links?.live && (
        <a href={project.links.live} target="_blank" rel="noreferrer">
          <small>DEMO</small><strong>YouTube ↗</strong>
        </a>
      )}
    </aside>
  </header>

  <div class="metric-grid grid gap-3 md:grid-cols-3">
    {project.metrics.map((metric) => (
      <div class="metric panel">
        <strong>{metric.value}</strong>
        <span data-en={metric.label} data-vi={metric.labelVi}>{metric.label}</span>
      </div>
    ))}
  </div>

  <div class="dossier-body">
    <aside class="dossier-index panel">
      <span class="section-index">DOCUMENT INDEX</span>
      <nav aria-label="Document index">
        <ol>
          {documentHeadings.map((heading, index) => (
            <li
              class:list={[
                "index-item",
                `index-level-${heading.depth - baseHeadingDepth}`,
              ]}
            >
              <a
                href={`#${heading.slug}`}
                data-heading-link={heading.slug}
                aria-current={index === 0 ? "location" : undefined}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{heading.text}</strong>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <a href="/Huynh-Minh-Tri-Software-Engineer-CV.pdf" download>
        <span data-en="Download CV" data-vi="Tải CV">Download CV</span> ↓
      </a>
    </aside>

    <div class="mdx-content panel">
      <slot />
    </div>
  </div>
</article>

<script>
  const indexLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-heading-link]"),
  );
  const indexedHeadings = indexLinks
    .map((link) => {
      const slug = link.dataset.headingLink;
      return slug ? document.getElementById(slug) : null;
    })
    .filter((heading): heading is HTMLElement => heading !== null);

  function setActiveHeading(slug: string) {
    indexLinks.forEach((link) => {
      if (link.dataset.headingLink === slug) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  indexLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const slug = link.dataset.headingLink;
      if (slug) setActiveHeading(slug);
    });
  });

  if ("IntersectionObserver" in window) {
    const visibleHeadings = new Map<string, IntersectionObserverEntry>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slug = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) {
            visibleHeadings.set(slug, entry);
          } else {
            visibleHeadings.delete(slug);
          }
        });

        const active = [...visibleHeadings.values()].sort(
          (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
        )[0];
        if (active) setActiveHeading((active.target as HTMLElement).id);
      },
      { rootMargin: "-150px 0px -65% 0px", threshold: [0, 1] },
    );

    indexedHeadings.forEach((heading) => observer.observe(heading));
  }
</script>

<style>
  .dossier { padding-top: 96px; padding-bottom: 110px; }

  .back-link {
    display: inline-flex;
    margin-bottom: 24px;
    color: var(--text-muted);
    font-size: 0.78rem;
    transition: color var(--duration-fast) ease;
  }

  .back-link:hover { color: var(--brand-soft); }

  .dossier-hero {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) 230px;
    gap: 42px;
    padding: 46px;
    overflow: hidden;
    border-radius: var(--radius-feature);
    background:
      radial-gradient(circle at 88% 10%, rgb(59 130 246 / 12%), transparent 32%),
      linear-gradient(135deg, rgb(18 128 92 / 9%), transparent 42%),
      rgb(8 22 17 / 86%);
  }

  .project-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .project-id { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.1em; }

  .project-emblem {
    display: grid;
    width: 118px;
    height: 118px;
    place-items: center;
    border: 7px solid var(--wood-dark);
    border-radius: 50%;
    background: radial-gradient(circle, rgb(24 199 133 / 18%), transparent 58%), #081610;
    box-shadow: 0 0 0 1px var(--border-active), 0 20px 50px rgb(0 0 0 / 38%);
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    overflow: hidden;
  }

  .project-icon-img {
    width: 76px;
    height: 76px;
    object-fit: contain;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 0.62rem;
  }

  .status-badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--brand-green); }

  h1 {
    max-width: 750px;
    margin: 14px 0 18px;
    font-size: clamp(2.25rem, 4.2vw, 4.3rem);
    letter-spacing: -0.065em;
    line-height: 1;
  }

  .project-intro > p { max-width: 700px; color: var(--text-secondary); }

  .project-tags span {
    padding: 6px 9px;
    border: 1px solid var(--border-default);
    border-radius: 7px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.56rem;
  }

  .project-meta { border-top: 1px solid var(--border-default); }
  .project-meta > * {
    display: flex;
    min-height: 72px;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid var(--border-default);
  }

  .project-meta small { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.48rem; letter-spacing: 0.1em; }
  .project-meta strong { margin-top: 4px; font-size: 0.74rem; }
  .project-meta a:hover strong { color: var(--brand-soft); }

  .metric-grid { margin: 16px 0; }
  .metric {
    display: flex;
    min-height: 118px;
    flex-direction: column;
    justify-content: center;
    padding: 24px;
    border-radius: var(--radius-standard);
  }

  .metric strong { color: var(--brand-soft); font-family: var(--font-mono); font-size: 1.65rem; }
  .metric span { color: var(--text-muted); font-size: 0.7rem; }

  .dossier-body {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 16px;
  }

  .dossier-index {
    position: sticky;
    top: 118px;
    align-self: start;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    padding: 26px;
    border-radius: var(--radius-standard);
    scrollbar-color: rgb(117 230 178 / 24%) transparent;
    scrollbar-width: thin;
  }

  .dossier-index ol {
    display: grid;
    gap: 5px;
    margin: 24px 0 34px;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .index-item > a {
    position: relative;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    padding: 8px 8px 8px 10px;
    border-left: 1px solid var(--border-default);
    color: var(--text-muted);
    transition:
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .index-item > a:hover {
    border-color: rgb(117 230 178 / 42%);
    background: rgb(117 230 178 / 4%);
    color: var(--text-secondary);
  }

  .index-item > a[aria-current="location"] {
    border-color: var(--brand-green);
    background: linear-gradient(90deg, rgb(24 199 133 / 9%), transparent);
    color: var(--text-main);
  }

  .index-item > a > span {
    padding-top: 2px;
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.05em;
  }

  .index-item > a > strong {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .index-level-1 > a {
    padding-left: 22px;
  }

  .index-level-2 > a {
    padding-left: 34px;
  }

  .dossier-index > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid var(--border-default);
    color: var(--brand-soft);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .mdx-content {
    padding: clamp(30px, 5vw, 64px);
    border-radius: var(--radius-feature);
  }

  .mdx-content :global(h1),
  .mdx-content :global(h2),
  .mdx-content :global(h3) {
    scroll-margin-top: 150px;
  }

  .mdx-content :global(h1) {
    margin: 0 0 24px;
    font-size: clamp(1.85rem, 3.6vw, 3rem);
    letter-spacing: -0.05em;
  }

  .mdx-content :global(h2) {
    margin: 64px 0 18px;
    padding-top: 28px;
    border-top: 1px solid var(--border-default);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.04em;
  }

  .mdx-content :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .mdx-content :global(h3) { margin: 36px 0 12px; color: var(--brand-soft); font-size: 1.12rem; }
  .mdx-content :global(p),
  .mdx-content :global(li) { color: var(--text-secondary); font-size: 0.94rem; line-height: 1.8; }
  .mdx-content :global(ul),
  .mdx-content :global(ol) { display: grid; gap: 8px; padding-left: 22px; }
  .mdx-content :global(strong) { color: var(--text-main); }

  .mdx-content :global(pre.astro-code) {
    position: relative;
    margin: 22px 0;
    padding: 46px 20px 20px !important;
    overflow-x: auto;
    border: 1px solid rgb(117 230 178 / 18%);
    border-radius: 14px;
    background:
      radial-gradient(circle at 94% 0%, rgb(59 130 246 / 8%), transparent 34%),
      rgb(5 14 11 / 92%) !important;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 2.5%);
    font-size: 0.78rem;
    line-height: 1.75;
    scrollbar-color: rgb(117 230 178 / 28%) transparent;
    scrollbar-width: thin;
  }

  .mdx-content :global(pre.astro-code::before) {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    height: 31px;
    align-items: center;
    padding: 0 13px;
    border-bottom: 1px solid rgb(117 230 178 / 12%);
    background: rgb(255 255 255 / 1.8%);
    color: var(--brand-green);
    content: attr(data-language);
    font-family: var(--font-mono);
    font-size: 0.46rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .mdx-content :global(pre.astro-code::after) {
    position: absolute;
    top: 12px;
    right: 13px;
    width: 36px;
    height: 6px;
    background:
      radial-gradient(circle, var(--brand-green) 0 2px, transparent 2.5px) 0 0 / 12px 6px;
    content: "";
    opacity: 0.46;
  }

  .mdx-content :global(pre.astro-code:focus-visible) {
    border-color: var(--border-active);
    outline: 0;
    box-shadow:
      0 0 0 2px rgb(24 199 133 / 12%),
      inset 0 1px 0 rgb(255 255 255 / 2.5%);
  }

  .mdx-content :global(pre.astro-code .line) {
    min-height: 1.75em;
  }

  .mdx-content :global(:not(pre) > code) {
    padding: 0.16em 0.38em;
    border: 1px solid rgb(117 230 178 / 16%);
    border-radius: 5px;
    background: rgb(24 199 133 / 5%);
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .mdx-content :global(.katex) {
    color: #e8f2ed;
    font-size: 1.08em;
  }

  .mdx-content :global(.katex-display) {
    position: relative;
    margin: 22px 0 26px;
    padding: 24px 22px;
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid rgb(117 230 178 / 22%);
    border-left: 3px solid var(--brand-green);
    border-radius: 14px;
    background:
      radial-gradient(circle at 94% 0%, rgb(59 130 246 / 10%), transparent 34%),
      linear-gradient(135deg, rgb(24 199 133 / 6%), transparent 44%),
      rgb(5 14 11 / 92%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 3%),
      0 16px 36px rgb(0 0 0 / 14%);
    scrollbar-color: rgb(117 230 178 / 28%) transparent;
    scrollbar-width: thin;
  }

  .mdx-content :global(.katex-display > .katex) {
    min-width: max-content;
    text-align: left;
  }

  .mdx-content :global(.katex-display::before) {
    position: absolute;
    top: 8px;
    left: 12px;
    color: var(--brand-green);
    content: "FORMULA";
    font-family: var(--font-mono);
    font-size: 0.42rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .mdx-content :global(.katex-display .base) {
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .dossier-hero { grid-template-columns: 150px 1fr; }
    .project-meta { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .project-meta > * { padding-inline: 14px; }
  }

  @media (max-width: 720px) {
    .dossier { padding-top: 60px; }
    .dossier-hero { grid-template-columns: 1fr; padding: 28px; }
    .project-identity { flex-direction: row; align-items: center; flex-wrap: wrap; }
    .project-emblem { width: 82px; height: 82px; }
    .project-meta { grid-column: auto; grid-template-columns: 1fr; }
    .dossier-body { grid-template-columns: 1fr; }
    .dossier-index { position: static; max-height: none; overflow: visible; }
    .mdx-content :global(pre.astro-code) { margin-inline: -4px; padding-inline: 16px !important; }
    .mdx-content :global(.katex-display) {
      margin-inline: -4px;
      padding: 24px 16px 18px;
    }
  }
</style>
