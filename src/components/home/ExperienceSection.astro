---
/**
 * @name ExperienceSection.astro
 * @description Showcases professional workplaces with company logos, concise role summaries, and direct links to detailed tasks & responsibilities.
 */
import SectionHeading from "../ui/SectionHeading.astro";
import { experiences } from "../../data/portfolio";
---

<section class="section shell" id="experience">
  <SectionHeading
    index="02 / TRACK RECORD"
    titleEn="Work & Affiliations"
    titleVi="Nơi làm việc & Tổ chức"
    descriptionEn="Engineering workplaces and core product responsibilities connecting code to real-world operational impact."
    descriptionVi="Môi trường làm việc chuyên nghiệp và trọng trách sản phẩm cốt lõi gắn liền với thực tiễn."
  />

  <div class="experience-grid">
    {
      experiences.map((item) => (
        <article class:list={["experience-card", "panel", `type-${item.badgeType}`]}>
          <div class="card-inner-top">
            <!-- Header: Company Logo, Org Info & Status Badge -->
            <div class="card-top">
              <div class="org-brand-wrap">
                <div class="company-logo-frame">
                  <img src={item.logo} alt={item.orgName} class="company-logo-img" width="36" height="36" />
                </div>
                <div class="org-info">
                  <h3 class="org-title">{item.orgName}</h3>
                  <span class="period-pill" data-en={item.periodEn} data-vi={item.periodVi}>
                    <i class="fa-regular fa-clock" aria-hidden="true"></i>
                    {item.periodEn}
                  </span>
                </div>
              </div>

              <span class:list={["badge-pill", `badge-${item.badgeType}`]}>
                {item.badgeType === "current" && <span class="pulse-indicator" aria-hidden="true"></span>}
                <span data-en={item.badgeEn} data-vi={item.badgeVi}>{item.badgeEn}</span>
              </span>
            </div>

            <!-- Role Title & Location -->
            <div class="role-row">
              <h4 class="role-name" data-en={item.roleEn} data-vi={item.roleVi}>
                {item.roleEn}
              </h4>
              <span class="location-text" data-en={item.locationEn} data-vi={item.locationVi}>
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                {item.locationEn}
              </span>
            </div>

            <!-- Connected System Box (Uniform Min-Height) -->
            <div class="connected-product-box">
              <span class="product-label" data-en="CONNECTED SYSTEM" data-vi="SẢN PHẨM GẮN LIỀN">CONNECTED SYSTEM</span>
              <strong class="product-name" data-en={item.project.titleEn} data-vi={item.project.titleVi}>
                {item.project.titleEn}
              </strong>
            </div>

            <!-- Tech Stack Row -->
            <div class="tech-row">
              {item.technologies.slice(0, 4).map((tech) => (
                <span class="tech-badge">{tech}</span>
              ))}
            </div>
          </div>

          <!-- Bottom Action Buttons (Always Aligned to Bottom) -->
          <div class="card-action-footer">
            <a href={`/experience/${item.id}`} class="btn-role-detail">
              <span data-en="View role & tasks" data-vi="Chi tiết công việc & nhiệm vụ">View role & tasks</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>

            {item.orgHref && (
              <a href={item.orgHref} target="_blank" rel="noreferrer" class="btn-org-link" aria-label={`Visit ${item.orgName}`}>
                <span data-en="Website" data-vi="Trang web">Website</span>
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .experience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .experience-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 26px 28px 24px;
    border-radius: 20px;
    border: 1px solid var(--border-default);
    background: linear-gradient(160deg, rgb(15 32 24 / 70%), rgb(6 14 11 / 85%));
    backdrop-filter: blur(14px);
    transition:
      transform var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease;
  }

  .experience-card:hover {
    transform: translateY(-4px);
    border-color: rgb(24 199 133 / 45%);
    box-shadow: 0 16px 36px -10px rgb(0 0 0 / 60%), 0 0 24px -4px rgb(24 199 133 / 12%);
  }

  .card-inner-top {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
  }

  .org-brand-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  /* Strict Logo Frame Constraints */
  .company-logo-frame {
    width: 46px;
    height: 46px;
    min-width: 46px;
    max-width: 46px;
    min-height: 46px;
    max-height: 46px;
    border-radius: 12px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 4px 14px -2px rgba(0, 0, 0, 0.35);
  }

  .company-logo-img {
    max-width: 100% !important;
    max-height: 100% !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain;
    display: block;
  }

  .org-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .org-title {
    margin: 0;
    font-size: 1.12rem;
    letter-spacing: -0.025em;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .period-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .period-pill i {
    font-size: 0.54rem;
  }

  /* Badge Pill */
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge-current {
    background: rgb(24 199 133 / 12%);
    border: 1px solid rgb(24 199 133 / 35%);
    color: #4eedb0;
  }

  .badge-enterprise {
    background: rgb(59 130 246 / 10%);
    border: 1px solid rgb(59 130 246 / 35%);
    color: #93c5fd;
  }

  .badge-core {
    background: rgb(168 85 247 / 10%);
    border: 1px solid rgb(168 85 247 / 35%);
    color: #c084fc;
  }

  .badge-team {
    background: rgb(245 158 11 / 10%);
    border: 1px solid rgb(245 158 11 / 35%);
    color: #fcd34d;
  }

  .pulse-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
    animation: beaconPulse 2s infinite ease-in-out;
  }

  /* Role Row */
  .role-row {
    margin-bottom: 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .role-name {
    margin: 0;
    font-size: 1rem;
    color: var(--brand-soft);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .location-text {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .location-text i {
    font-size: 0.58rem;
  }

  /* Connected Product Box (Strict Min-Height for Uniformity) */
  .connected-product-box {
    min-height: 58px;
    padding: 9px 13px;
    border-radius: 10px;
    background: rgb(6 14 11 / 55%);
    border: 1px solid rgb(255 255 255 / 4%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    margin-bottom: 14px;
  }

  .product-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }

  .product-name {
    color: var(--text-main);
    font-size: 0.82rem;
    letter-spacing: -0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Tech Row */
  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
    min-height: 26px;
  }

  .tech-badge {
    padding: 3px 8px;
    border-radius: 6px;
    background: rgb(255 255 255 / 3%);
    border: 1px solid rgb(255 255 255 / 6%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.56rem;
  }

  /* Footer Actions */
  .card-action-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 5%);
    margin-top: auto;
  }

  .btn-role-detail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 10px;
    background: rgb(24 199 133 / 14%);
    border: 1px solid rgb(24 199 133 / 40%);
    color: var(--brand-soft);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-role-detail:hover {
    background: var(--brand-green);
    color: #030806;
    border-color: var(--brand-green);
    transform: translateX(2px);
  }

  .btn-org-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    background: rgb(255 255 255 / 3%);
    border: 1px solid rgb(255 255 255 / 8%);
    color: var(--text-secondary);
    font-size: 0.68rem;
    text-decoration: none;
    transition: all var(--duration-fast) ease;
  }

  .btn-org-link:hover {
    background: rgb(255 255 255 / 6%);
    color: var(--text-main);
    border-color: rgb(255 255 255 / 20%);
  }

  @keyframes beaconPulse {
    0%, 100% {
      opacity: 0.7;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  @media (max-width: 980px) {
    .experience-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .experience-card {
      padding: 20px 18px;
    }

    .card-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .badge-pill {
      align-self: flex-start;
    }
  }
</style>
