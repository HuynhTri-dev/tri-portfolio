---
/**
 * @name ExperienceSection.astro
 * @description Showcases professional workplaces, engineering roles, and associated projects/systems.
 */
import SectionHeading from "../ui/SectionHeading.astro";
import { experiences } from "../../data/portfolio";
---

<section class="section shell" id="experience">
  <SectionHeading
    index="02 / TRACK RECORD"
    titleEn="Work & Affiliations"
    titleVi="Nơi làm việc & Tổ chức"
    descriptionEn="Professional workplaces, engineering teams, and core architectural responsibilities connecting code to real-world operational impact."
    descriptionVi="Môi trường làm việc chuyên nghiệp, các đội ngũ kỹ thuật và trọng trách kiến trúc cốt lõi gắn liền với sản phẩm thực tế."
  />

  <div class="experience-grid">
    {
      experiences.map((item) => (
        <article class:list={["experience-card", "panel", `type-${item.badgeType}`]}>
          <div class="card-header">
            <div class="org-meta">
              <span class="org-icon" aria-hidden="true">
                {item.id === "idb" && <i class="fa-solid fa-building-shield"></i>}
                {item.id === "ritavo" && <i class="fa-solid fa-boxes-stacked"></i>}
                {item.id === "vinagreen" && <i class="fa-solid fa-leaf"></i>}
                {item.id === "omnimer" && <i class="fa-solid fa-brain"></i>}
              </span>
              <div>
                <h3 class="org-title">{item.orgName}</h3>
                <span class="period-tag" data-en={item.periodEn} data-vi={item.periodVi}>
                  <i class="fa-regular fa-clock" aria-hidden="true"></i>
                  {item.periodEn}
                </span>
              </div>
            </div>

            <span class:list={["badge-pill", `badge-${item.badgeType}`]}>
              {item.badgeType === "current" && <span class="pulse-indicator" aria-hidden="true"></span>}
              <span data-en={item.badgeEn} data-vi={item.badgeVi}>{item.badgeEn}</span>
            </span>
          </div>

          <div class="role-block">
            <h4 class="role-title" data-en={item.roleEn} data-vi={item.roleVi}>
              {item.roleEn}
            </h4>
            <p class="role-overview" data-en={item.overviewEn} data-vi={item.overviewVi}>
              {item.overviewEn}
            </p>
          </div>

          <div class="associated-box">
            <div class="associated-top">
              <span class="associated-kicker" data-en="CONNECTED SYSTEM / PRODUCT" data-vi="SẢN PHẨM / DỰ ÁN GẮN LIỀN">
                CONNECTED SYSTEM / PRODUCT
              </span>
              <span class="status-indicator" data-en={item.project.statusEn} data-vi={item.project.statusVi}>
                {item.project.statusEn}
              </span>
            </div>

            <h5 class="project-name" data-en={item.project.titleEn} data-vi={item.project.titleVi}>
              {item.project.titleEn}
            </h5>

            <p class="project-desc" data-en={item.project.descriptionEn} data-vi={item.project.descriptionVi}>
              {item.project.descriptionEn}
            </p>

            <div class="action-links flex flex-wrap gap-2">
              {item.project.links.map((link) => (
                <a
                  class="action-button"
                  href={link.href}
                  target={link.isExternal ? "_blank" : undefined}
                  rel={link.isExternal ? "noreferrer" : undefined}
                >
                  <span data-en={link.labelEn} data-vi={link.labelVi}>{link.labelEn}</span>
                  <span class="link-icon" aria-hidden="true">
                    {link.icon === "fa-github" ? (
                      <i class="fa-brands fa-github"></i>
                    ) : link.icon === "fa-folder-open" ? (
                      <i class="fa-regular fa-folder-open"></i>
                    ) : (
                      <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    )}
                  </span>
                </a>
              ))}
            </div>
          </div>

          <div class="tech-footer">
            <span class="tech-label" data-en="Stack" data-vi="Công nghệ">Stack:</span>
            <div class="tech-pills flex flex-wrap gap-1.5">
              {item.technologies.map((tech) => (
                <span class="tech-badge">{tech}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .experience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .experience-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px;
    border-radius: 22px;
    border: 1px solid var(--border-default);
    background:
      linear-gradient(155deg, rgb(255 255 255 / 2.5%), transparent 60%),
      rgb(5 14 11 / 88%);
    backdrop-filter: blur(14px);
    transition:
      transform var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease;
  }

  .experience-card:hover {
    transform: translateY(-4px);
    border-color: rgb(24 199 133 / 42%);
    box-shadow: 0 16px 40px rgb(0 0 0 / 38%);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .org-meta {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .org-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid rgb(124 183 255 / 20%);
    border-radius: 12px;
    background: rgb(59 130 246 / 7%);
    color: var(--brand-soft);
    font-size: 1.15rem;
  }

  .type-current .org-icon {
    border-color: rgb(24 199 133 / 35%);
    background: rgb(24 199 133 / 9%);
    color: var(--brand-green);
  }

  .type-core .org-icon {
    border-color: rgb(117 230 178 / 26%);
    background: rgb(117 230 178 / 8%);
    color: var(--brand-soft);
  }

  .type-team .org-icon {
    border-color: rgb(168 85 247 / 32%);
    background: rgb(168 85 247 / 9%);
    color: #c084fc;
  }

  .org-title {
    margin: 0 0 4px;
    color: var(--text-main);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .period-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--technical-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-default);
    background: rgb(255 255 255 / 2.5%);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .badge-current {
    border-color: rgb(24 199 133 / 45%);
    background: rgb(24 199 133 / 10%);
    color: var(--brand-green);
  }

  .badge-enterprise {
    border-color: rgb(124 183 255 / 35%);
    background: rgb(59 130 246 / 9%);
    color: var(--technical-soft);
  }

  .badge-core {
    border-color: rgb(117 230 178 / 32%);
    background: rgb(18 128 92 / 12%);
    color: var(--brand-soft);
  }

  .badge-team {
    border-color: rgb(168 85 247 / 38%);
    background: rgb(168 85 247 / 11%);
    color: #d8b4fe;
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 10px var(--brand-green);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  .role-block {
    margin-bottom: 22px;
  }

  .role-title {
    margin: 0 0 8px;
    color: var(--brand-soft);
    font-size: 1.18rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .role-overview {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .associated-box {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid rgb(124 183 255 / 14%);
    background:
      linear-gradient(160deg, rgb(124 183 255 / 3%), transparent 65%),
      rgb(4 11 9 / 68%);
    margin-bottom: 22px;
  }

  .associated-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .associated-kicker {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
  }

  .status-indicator {
    padding: 2px 7px;
    border-radius: 5px;
    border: 1px solid rgb(124 183 255 / 18%);
    background: rgb(255 255 255 / 2%);
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.04em;
  }

  .project-name {
    margin: 0 0 8px;
    color: var(--text-main);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .project-desc {
    margin: 0 0 16px;
    color: var(--text-muted);
    font-size: 0.81rem;
    line-height: 1.55;
  }

  .action-links {
    margin-top: auto;
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-small);
    background: rgb(255 255 255 / 3%);
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .action-button:hover {
    transform: translateY(-2px);
    border-color: var(--brand-green);
    background: rgb(24 199 133 / 8%);
    color: var(--text-main);
  }

  .action-button .link-icon {
    color: var(--brand-green);
    font-size: 0.65rem;
    transition: transform var(--duration-fast) ease;
  }

  .action-button:hover .link-icon {
    transform: translate(1px, -1px);
  }

  .tech-footer {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 4%);
  }

  .tech-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .tech-badge {
    padding: 3px 8px;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    background: rgb(255 255 255 / 2%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  @media (max-width: 980px) {
    .experience-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .experience-card {
      padding: 24px;
    }

    .card-header {
      flex-direction: column;
      gap: 12px;
    }

    .role-title {
      font-size: 1.08rem;
    }

    .associated-box {
      padding: 16px;
    }

    .associated-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
