<div class="forest-growth-track" aria-hidden="true">
  <span></span>
</div>

<script>
  const revealSelectors = [
    ".section-heading",
    ".education-card",
    ".project-card",
    "#technical-skill astro-island",
    ".soft-card",
    ".achievement-card",
    ".beyond-card",
    ".contact-copy",
    ".contact-links",
  ].join(",");

  const revealElements = Array.from(
    document.querySelectorAll<HTMLElement>(revealSelectors),
  );

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealElements.forEach((element) => element.classList.add("is-grown"));
  } else {
    revealElements.forEach((element) => {
      element.dataset.forestReveal = element.classList.contains("section-heading")
        ? "canopy"
        : "card";

      const siblings = element.parentElement
        ? Array.from(element.parentElement.children).filter((child) =>
            (child as Element).matches?.(revealSelectors),
          )
        : [];
      const siblingIndex = Math.max(0, siblings.indexOf(element));
      element.style.setProperty(
        "--forest-delay",
        `${Math.min(siblingIndex * 90, 270)}ms`,
      );
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).classList.add("is-grown");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -8% 0px",
      },
    );

    revealElements.forEach((element) => observer.observe(element));
  }

  const track = document.querySelector<HTMLElement>(".forest-growth-track");
  let frame = 0;

  function updateGrowthTrack() {
    frame = 0;
    if (!track) return;
    const scrollRange =
      document.documentElement.scrollHeight - window.innerHeight;
    const progress =
      scrollRange > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollRange)) : 0;
    track.style.setProperty("--forest-progress", String(progress));
  }

  function requestGrowthTrackUpdate() {
    if (frame) return;
    frame = window.requestAnimationFrame(updateGrowthTrack);
  }

  if (!reduceMotion) {
    updateGrowthTrack();
    window.addEventListener("scroll", requestGrowthTrackUpdate, {
      passive: true,
    });
    window.addEventListener("resize", requestGrowthTrackUpdate);
  }
</script>

<style is:global>
  .forest-growth-track {
    position: fixed;
    top: 28%;
    bottom: 20%;
    left: 18px;
    z-index: 20;
    width: 1px;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(117 230 178 / 12%) 14%,
      rgb(117 230 178 / 12%) 86%,
      transparent
    );
    opacity: 0.7;
    pointer-events: none;
  }

  .forest-growth-track span {
    position: absolute;
    inset: 0;
    transform: scaleY(var(--forest-progress, 0));
    transform-origin: top;
    background: linear-gradient(
      to bottom,
      var(--brand-green),
      var(--brand-soft) 70%,
      transparent
    );
    box-shadow: 0 0 14px rgb(24 199 133 / 48%);
  }

  .forest-growth-track span::after {
    position: absolute;
    right: -3px;
    bottom: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-soft);
    box-shadow:
      0 0 0 5px rgb(24 199 133 / 8%),
      0 0 18px rgb(24 199 133 / 58%);
    content: "";
  }

  .home-motion-ready body.home-page main
    :is(
      .section-heading,
      .education-card,
      .project-card,
      #technical-skill astro-island,
      .soft-card,
      .achievement-card,
      .beyond-card,
      .contact-copy,
      .contact-links
    ):not(.is-grown) {
    opacity: 0;
    transform: translateY(46px) scale(0.985);
    clip-path: inset(10% 0 0 round 20px);
    filter: blur(7px) saturate(0.72);
  }

  .home-motion-ready body.home-page main [data-forest-reveal].is-grown {
    animation: forest-grow 760ms cubic-bezier(0.2, 0.72, 0.24, 1)
      var(--forest-delay, 0ms) backwards;
  }

  .home-motion-ready
    body.home-page
    main
    [data-forest-reveal="canopy"].is-grown {
    animation-name: forest-canopy;
    animation-duration: 680ms;
  }

  @keyframes forest-grow {
    from {
      opacity: 0;
      transform: translateY(46px) scale(0.985);
      clip-path: inset(10% 0 0 round 20px);
      filter: blur(7px) saturate(0.72);
    }
    68% {
      filter: blur(0) saturate(1.08)
        drop-shadow(0 18px 30px rgb(24 199 133 / 9%));
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      clip-path: inset(0 round 0);
      filter: none;
    }
  }

  @keyframes forest-canopy {
    from {
      opacity: 0;
      transform: translate(-24px, 26px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translate(0);
      filter: none;
    }
  }

  @media (max-width: 820px) {
    .forest-growth-track {
      top: 32%;
      bottom: 14%;
      left: 7px;
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .forest-growth-track {
      display: none;
    }

    .home-motion-ready body.home-page main
      :is(
        .section-heading,
        .education-card,
        .project-card,
        #technical-skill astro-island,
        .soft-card,
        .achievement-card,
        .beyond-card,
        .contact-copy,
        .contact-links
      ) {
      opacity: 1;
      transform: none;
      clip-path: none;
      filter: none;
      animation: none;
    }
  }
</style>
