---
/**
 * @name ProjectsSection.astro
 * @description Value-first featured projects showcase on the homepage with 4-layer
 *              whole-card clickable dossiers, impact metrics, and direct CTAs to /projects and /blog.
 */
import { getCollection } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProjects = allProjects.slice(0, 6);
---

<section class="section shell" id="projects">
  <SectionHeading
    index="01 / SELECTED WORK"
    titleEn="Systems I’ve built"
    titleVi="Hệ thống đã xây dựng"
    descriptionEn="Production systems and product prototypes focused on real-world workflows and measurable outcomes."
    descriptionVi="Các hệ thống vận hành thực tế và sản phẩm tập trung vào bài toán cốt lõi cùng kết quả đo lường được."
  />

  <div class="project-grid">
    {
      featuredProjects.map((project) => (
        <article class="project-card panel">
          <!-- Layer 1: Visual 16:9 Media Preview -->
          <div class="project-media">
            {project.data.image ? (
              <img src={project.data.image} alt={project.data.title} loading="lazy" />
            ) : (
              <div class="media-fallback" aria-hidden="true">
                <i class="fa-solid fa-layer-group" />
              </div>
            )}
            <div class="media-overlay" aria-hidden="true" />
            <div class="media-badge">
              <span class="pulse-dot" aria-hidden="true" />
              <span data-en={project.data.type} data-vi={project.data.typeVi}>
                {project.data.type}
              </span>
            </div>
            <span class="media-period">{project.data.period}</span>
          </div>

          <!-- Layers 2-4: Title (Whole-Card Clickable), Value Summary, Impact Metrics -->
          <div class="project-card-inner">
            <h3 class="project-title">
              <a class="project-card-link" href={`/projects/${project.id}`}>
                {project.data.title}
              </a>
            </h3>

            <p
              data-en={project.data.summary}
              data-vi={project.data.summaryVi}
              class="project-summary-text"
            >
              {project.data.summary}
            </p>

            {project.data.metrics && project.data.metrics.length > 0 && (
              <div class="project-metrics">
                {project.data.metrics.slice(0, 3).map((metric) => (
                  <div class="metric-item">
                    <strong>{metric.value}</strong>
                    <span data-en={metric.label} data-vi={metric.labelVi}>
                      {metric.label}
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="section-cta-bar">
    <a class="btn btn--primary" href="/projects">
      <span data-en="Explore all projects & open-source repos" data-vi="Xem toàn bộ dự án & mã nguồn mở">
        Explore all projects &amp; open-source repos
      </span>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </a>
    <a class="btn btn--secondary" href="/blog">
      <i class="fa-solid fa-book-bookmark" aria-hidden="true"></i>
      <span data-en="Engineering Notes & D1 Knowledge Base" data-vi="Blog Kỹ thuật & Kho Tri Thức D1">
        Engineering Notes &amp; D1 Knowledge Base
      </span>
    </a>
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(170deg, rgb(14 30 23 / 72%), rgb(7 16 12 / 88%));
    border: 1px solid var(--border-default);
    cursor: pointer;
    transition:
      transform var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgb(24 199 133 / 50%);
    box-shadow: 0 18px 38px -10px rgb(0 0 0 / 65%), 0 0 24px -4px rgb(24 199 133 / 15%);
  }

  .project-card:focus-within {
    outline: 2px solid var(--brand-soft);
    outline-offset: 4px;
  }

  .project-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 248px;
    overflow: hidden;
    background: #040906;
    flex-shrink: 0;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-card:hover .project-media img {
    transform: scale(1.04);
  }

  .media-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 2rem;
    opacity: 0.35;
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 42%, rgb(7 16 12 / 94%) 100%);
    pointer-events: none;
  }

  .media-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    background: rgb(7 16 12 / 86%);
    border: 1px solid rgb(24 199 133 / 35%);
    color: #4eedb0;
    font-family: var(--font-mono);
    font-size: var(--text-xs, 0.75rem);
    font-weight: 600;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2;
  }

  .media-period {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: rgb(5 11 9 / 80%);
    border: 1px solid rgb(255 255 255 / 10%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-micro, 0.7rem);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 2;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #18c785;
    box-shadow: 0 0 6px #18c785;
  }

  .project-card-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 26px 24px;
  }

  .project-title {
    margin: 0;
    font-size: 1.24rem;
    letter-spacing: -0.03em;
    line-height: 1.28;
  }

  .project-card-link {
    color: var(--text-main);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  /* Whole-card stretched link */
  .project-card-link::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
  }

  .project-card:hover .project-card-link {
    color: var(--brand-soft);
  }

  .project-summary-text {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10px 12px;
    border: 1px solid rgb(255 255 255 / 7%);
    border-radius: var(--radius-small);
    background: rgb(5 11 9 / 54%);
    overflow: hidden;
  }

  .metric-item strong {
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .metric-item span {
    color: var(--text-muted);
    font-size: var(--text-micro, 0.7rem);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .section-cta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  @media (max-width: 960px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .project-card-inner {
      padding: 18px 20px 20px;
    }

    .project-title {
      font-size: 1.15rem;
    }

    .project-metrics {
      grid-template-columns: 1fr;
    }

    .section-cta-bar {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
