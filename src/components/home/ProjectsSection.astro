---
/**
 * @name ProjectsSection.astro
 * @description Home page featured projects showcase with visual 16:9 preview screenshots, uniform heights, and direct case study dossiers.
 */
import { getCollection } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="section shell" id="projects">
  <SectionHeading
    index="03 / SELECTED WORK"
    titleEn="Systems I’ve built"
    titleVi="Hệ thống đã xây dựng"
    descriptionEn="Two environments, one consistent approach: understand the workflow, design the system and measure the outcome."
    descriptionVi="Hai môi trường, một cách tiếp cận nhất quán: hiểu quy trình, thiết kế hệ thống và đo lường kết quả."
  />

  <div class="project-grid">
    {
      projects.map((project) => (
        <article class="project-card panel">
          <!-- Visual 16:9 Media Preview -->
          <a href={`/projects/${project.id}`} class="project-media" aria-label={project.data.title}>
            {project.data.image ? (
              <img src={project.data.image} alt={project.data.title} loading="lazy" />
            ) : (
              <div class="media-fallback"><i class="fa-solid fa-layer-group"></i></div>
            )}
            <div class="media-overlay"></div>
            <div class="media-badge">
              <span class="pulse-dot"></span>
              <span data-en={project.data.type} data-vi={project.data.typeVi}>
                {project.data.type}
              </span>
            </div>
          </a>

          <!-- Uniform Card Body -->
          <div class="project-card-inner">
            <div class="project-topline">
              <span class="project-id">{project.data.projectId}</span>
              <span class="project-date">{project.data.period}</span>
            </div>

            <div class="project-text-wrap">
              <h3 class="project-title">
                <a href={`/projects/${project.id}`}>{project.data.title}</a>
              </h3>
              <p
                data-en={project.data.summary}
                data-vi={project.data.summaryVi}
                class="project-summary-text"
              >
                {project.data.summary}
              </p>
            </div>

            <!-- Tech Tags (Fixed Height Row) -->
            <div class="tag-row">
              {project.data.technologies.slice(0, 4).map((tech) => (
                <span>{tech}</span>
              ))}
            </div>

            <!-- Metrics Row (Uniform 3-Column Grid) -->
            {project.data.metrics && project.data.metrics.length > 0 && (
              <div class="project-metrics">
                {project.data.metrics.slice(0, 3).map((metric) => (
                  <div class="metric-item">
                    <strong>{metric.value}</strong>
                    <span data-en={metric.label} data-vi={metric.labelVi}>
                      {metric.label}
                    </span>
                  </div>
                ))}
              </div>
            )}

            <!-- Pinned Bottom Action Link -->
            <a class="project-link" href={`/projects/${project.id}`}>
              <span data-en="Open project dossier" data-vi="Mở hồ sơ dự án">
                Open project dossier
              </span>
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(170deg, rgb(14 30 23 / 70%), rgb(7 16 12 / 85%));
    border: 1px solid var(--border-default);
    transition:
      transform var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgb(24 199 133 / 48%);
    box-shadow: 0 16px 36px -10px rgb(0 0 0 / 65%), 0 0 24px -4px rgb(24 199 133 / 14%);
  }

  /* 16:9 Visual Preview Image */
  .project-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 250px;
    overflow: hidden;
    background: #040906;
    flex-shrink: 0;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-card:hover .project-media img {
    transform: scale(1.04);
  }

  .media-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 2rem;
    opacity: 0.3;
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(7 16 12 / 94%) 100%);
    pointer-events: none;
  }

  .media-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgb(7 16 12 / 85%);
    border: 1px solid rgb(24 199 133 / 35%);
    color: #4eedb0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
    z-index: 2;
  }

  .pulse-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #18c785;
    box-shadow: 0 0 6px #18c785;
  }

  /* Card Inner Body */
  .project-card-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 22px 26px 24px;
  }

  .project-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }

  .project-id {
    color: var(--brand-green);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .project-date {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .project-text-wrap {
    margin-bottom: 12px;
  }

  /* Uniform Title Height */
  .project-title {
    height: 3.2rem;
    margin: 0 0 8px;
    font-size: 1.22rem;
    letter-spacing: -0.035em;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-title a {
    color: var(--text-main);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .project-title a:hover {
    color: var(--brand-soft);
  }

  /* Uniform Summary Height */
  .project-summary-text {
    height: 2.8rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tag Row (Fixed Single Row Height) */
  .tag-row {
    height: 28px;
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    margin-bottom: 14px;
    overflow: hidden;
  }

  .tag-row span {
    padding: 3px 8px;
    border: 1px solid var(--border-default);
    border-radius: 6px;
    background: rgb(255 255 255 / 2%);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Metrics Grid (Uniform 3-Column Box) */
  .project-metrics {
    height: 58px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: auto;
    margin-bottom: 16px;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 7px 10px;
    border: 1px solid rgb(255 255 255 / 5%);
    border-radius: var(--radius-small);
    background: rgb(5 11 9 / 45%);
    overflow: hidden;
  }

  .metric-item strong {
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .metric-item span {
    color: var(--text-muted);
    font-size: 0.52rem;
    margin-top: 3px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Action Link */
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 5%);
    color: var(--brand-soft);
    font-size: 0.74rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--duration-fast) ease;
  }

  .project-link:hover {
    transform: translateX(3px);
  }

  @media (max-width: 960px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .project-card-inner {
      padding: 18px 20px 20px;
    }

    .project-title {
      font-size: 1.15rem;
      min-height: auto;
    }

    .project-summary-text {
      min-height: auto;
    }

    .project-metrics {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }
</style>
