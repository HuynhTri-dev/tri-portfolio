---
/**
 * @name Hero.astro
 * @description "The Awakening" hero section featuring metallic emerald shimmer typography,
 *              overhead canopy spotlight, tilted 3D spatial orbits, and biome index links.
 */
import { profileLinks } from "../../data/portfolio";
---

<section class="hero shell" id="home">
  <div class="hero-copy">
    <div class="eyebrow">
      <span class="status-dot"></span>
      <a
        href="https://idb.com.vn/All/Support"
        target="_blank"
        rel="noreferrer"
        style="color: inherit; text-decoration: none;"
      >
        <span
          data-en="Software Engineer @ IDB Group · Available for opportunities"
          data-vi="Kỹ sư phần mềm @ Tập đoàn IDB · Sẵn sàng cho cơ hội mới"
        >
          Software Engineer @ IDB Group · Available for opportunities
        </span>
      </a>
    </div>
    <h1>HUỲNH<br />MINH TRÍ</h1>
    <p
      class="hero-summary"
      data-en="A systems thinker who turns complex problems into practical, working products."
      data-vi="Người có tư duy hệ thống, biến những vấn đề phức tạp thành sản phẩm thực tiễn có thể vận hành."
    >
      A systems thinker who turns complex problems into practical, working
      products.
    </p>
    <div class="hero-actions flex flex-wrap gap-3">
      <a class="button button-primary" href="#projects">
        <span data-en="View projects" data-vi="Xem dự án">View projects</span>
        <span aria-hidden="true"><i class="fa-solid fa-arrow-down"></i></span>
      </a>
      <a
        class="button button-secondary"
        href="/Huynh-Minh-Tri-Software-Engineer-CV.pdf"
        download
      >
        <span data-en="Download CV" data-vi="Tải CV">Download CV</span>
        <span aria-hidden="true"><i class="fa-solid fa-download"></i></span>
      </a>
    </div>
  </div>

  <div class="portrait-stage">
    <div class="canopy-spotlight" aria-hidden="true"></div>
    <div class="orbit orbit-one" aria-hidden="true"></div>
    <div class="orbit orbit-two" aria-hidden="true"></div>
    <div class="portrait-frame" aria-label="Portrait of Huynh Minh Tri">
      <img
        src="/images/avatar.png"
        alt="Huỳnh Minh Trí - Software Developer Avatar"
        class="portrait-image"
        width="340"
        height="410"
      />
    </div>
    <div class="identity-card card-product">
      <strong>
        <span class="mb-2" data-en="PRODUCT" data-vi="KIẾN TẠO">PRODUCT</span>
        <span data-en="BUILDER" data-vi="SẢN PHẨM">BUILDER</span>
      </strong>
      <small
        data-en="From problem to working product"
        data-vi="Từ vấn đề đến sản phẩm thực tế"
      >
        From problem to working product
      </small>
    </div>
  </div>

  <div class="hero-index">
    <span class="index-kicker" data-en="Profile index" data-vi="Mục lục hồ sơ"
      >Profile index</span
    >
    <h2>SOFTWARE DEVELOPER<br /><em>& UX/UI DESIGNER</em></h2>
    <div class="index-list">
      {
        profileLinks.map((item) => (
          <a href={item.href}>
            <span class="index-number">{item.number}</span>
            <span data-en={item.en} data-vi={item.vi}>
              {item.en}
            </span>
            <span class="index-arrow" aria-hidden="true">
              <i class="fa-solid fa-arrow-right" />
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <a class="hero-scroll" href="#education">
    <span data-en="Scroll to explore" data-vi="Cuộn để khám phá"
      >Scroll to explore</span
    >
    <span aria-hidden="true"><i class="fa-solid fa-arrow-down"></i></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 720px;
    grid-template-columns: 1fr 0.84fr 0.9fr;
    align-items: center;
    gap: 42px;
    padding-top: 105px;
    padding-bottom: 64px;
  }

  .hero::before {
    position: absolute;
    inset: 14% 17% 7%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(18 128 92 / 10%), transparent 68%);
    content: "";
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs, 0.75rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow:
      0 0 0 5px rgb(24 199 133 / 12%),
      0 0 18px var(--brand-green);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 5vw, 4.65rem);
    font-weight: 800;
    letter-spacing: -0.065em;
    line-height: 0.94;
    background: linear-gradient(
      110deg,
      #f2f7f4 32%,
      #75e6b2 46%,
      #38bdf8 51%,
      #f2f7f4 66%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: heroNameShimmer 7.5s ease-in-out infinite;
  }

  @keyframes heroNameShimmer {
    0%,
    100% {
      background-position: 100% 50%;
    }
    50% {
      background-position: 0% 50%;
    }
  }

  .hero-summary {
    max-width: 540px;
    margin: 28px 0 30px;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-size: 0.83rem;
    font-weight: 700;
    transition:
      transform var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      background var(--duration-normal) ease;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button-primary {
    background: var(--brand-green);
    box-shadow: 0 12px 32px rgb(24 199 133 / 18%);
    color: #03140d;
  }

  .button-primary:hover {
    background: var(--brand-soft);
  }

  .button-secondary {
    border-color: var(--border-default);
    background: rgb(255 255 255 / 2.5%);
  }

  .button-secondary:hover {
    border-color: var(--border-active);
  }

  .portrait-stage {
    position: relative;
    display: grid;
    min-height: 485px;
    place-items: center;
    perspective: 900px;
  }

  .canopy-spotlight {
    position: absolute;
    top: -90px;
    width: 310px;
    height: 420px;
    z-index: 1;
    background: conic-gradient(
      from 168deg at 50% 0%,
      transparent 0deg,
      rgba(24, 199, 133, 0.14) 18deg,
      rgba(56, 189, 248, 0.1) 30deg,
      transparent 48deg
    );
    filter: blur(26px);
    pointer-events: none;
    animation: canopyAwaken 2.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes canopyAwaken {
    from {
      opacity: 0;
      transform: translateY(-30px) scaleY(0.75);
    }
    to {
      opacity: 1;
      transform: translateY(0) scaleY(1);
    }
  }

  .portrait-frame {
    position: relative;
    z-index: 2;
    width: min(100%, 340px);
    aspect-ratio: 0.83;
    padding: 12px;
    border: 6px solid var(--wood-dark);
    border-radius: 47% 47% 42% 42% / 40% 40% 52% 52%;
    background: linear-gradient(
      145deg,
      var(--wood-soft),
      var(--wood-dark) 38%,
      #261910
    );
    box-shadow:
      0 0 0 1px rgb(184 136 96 / 75%),
      0 0 0 4px rgb(24 199 133 / 22%),
      0 0 50px rgb(24 199 133 / 18%),
      0 30px 80px rgb(0 0 0 / 48%);
    overflow: hidden;
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    border: 1px solid rgb(117 230 178 / 38%);
    border-radius: 43% 43% 38% 38% / 36% 36% 48% 48%;
  }

  .orbit {
    position: absolute;
    border: 1px solid rgb(117 230 178 / 18%);
    border-radius: 50%;
    transform-style: preserve-3d;
  }

  .orbit-one {
    width: 420px;
    height: 420px;
    border-top-color: rgb(24 199 133 / 48%);
    animation: orbitSpinOne 22s linear infinite;
  }

  .orbit-two {
    width: 370px;
    height: 446px;
    border-color: rgb(124 183 255 / 14%);
    border-bottom-color: rgb(56 189 248 / 45%);
    animation: orbitSpinTwo 28s linear infinite reverse;
  }

  @keyframes orbitSpinOne {
    from {
      transform: rotateX(56deg) rotateY(16deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(56deg) rotateY(16deg) rotateZ(360deg);
    }
  }

  @keyframes orbitSpinTwo {
    from {
      transform: rotateX(48deg) rotateY(-22deg) rotateZ(0deg);
    }
    to {
      transform: rotateX(48deg) rotateY(-22deg) rotateZ(360deg);
    }
  }

  .identity-card {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-default);
    border-radius: 14px;
    background:
      linear-gradient(145deg, rgb(24 199 133 / 11%), transparent 55%),
      rgb(5 14 11 / 94%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 4%),
      0 16px 42px rgb(0 0 0 / 42%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .identity-card strong {
    display: flex;
    flex-direction: column;
    margin: 0 0 8px;
    color: var(--brand-soft);
    font-size: 1.28rem;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .identity-card small {
    color: var(--text-secondary);
    font-size: var(--text-micro, 0.7rem);
    line-height: 1.4;
  }

  .card-product {
    bottom: 18px;
    left: -48px;
    width: 206px;
    padding: 16px 18px 17px;
    border-color: rgb(24 199 133 / 42%);
  }

  .card-product strong {
    font-size: 1.52rem;
  }

  .card-systems {
    top: 42px;
    right: -42px;
    width: 168px;
    padding: 14px 15px 15px;
    border-color: rgb(124 183 255 / 28%);
    background:
      linear-gradient(145deg, rgb(59 130 246 / 9%), transparent 58%),
      rgb(5 14 11 / 94%);
  }

  .card-systems strong {
    font-size: 1.08rem;
  }

  .hero-index {
    padding-left: 10px;
  }

  .index-kicker {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs, 0.75rem);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-index h2 {
    margin: 14px 0 30px;
    font-size: clamp(2rem, 3.1vw, 3rem);
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  .hero-index h2 em {
    display: inline-block;
    font-style: normal;
    background: linear-gradient(135deg, #75e6b2 0%, #18c785 52%, #38bdf8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .index-list {
    border-top: 1px solid var(--border-default);
  }

  .index-list a {
    display: grid;
    min-height: 52px;
    grid-template-columns: 42px 1fr 24px;
    align-items: center;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 600;
    transition:
      padding var(--duration-fast) ease,
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .index-list a:hover {
    padding-inline: 8px;
    background: rgb(24 199 133 / 5.5%);
    color: var(--text-main);
  }

  .index-number {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs, 0.75rem);
  }

  .index-arrow {
    color: var(--brand-green);
    transition: transform var(--duration-fast) ease;
  }

  .index-list a:hover .index-arrow {
    transform: translate(4px, 4px);
  }

  .hero-scroll {
    position: absolute;
    bottom: 10px;
    left: 50%;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 6px 14px;
    transform: translateX(-50%);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro, 0.7rem);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: color var(--duration-fast) ease;
  }

  .hero-scroll span:last-child {
    color: var(--brand-green);
    font-size: var(--text-xs, 0.75rem);
    animation: rootDiveBounce 2.2s ease-in-out infinite;
  }

  @keyframes rootDiveBounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  .hero-scroll:hover {
    color: var(--brand-soft);
  }

  :global(#education) {
    border-top: 0;
  }

  @media (max-width: 1120px) {
    .hero {
      grid-template-columns: 1fr 0.9fr;
      gap: 40px;
    }

    .hero-index {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      align-items: end;
      padding-left: 0;
    }

    .hero-index h2 {
      margin-bottom: 0;
    }
    .index-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 56px;
      padding-bottom: 82px;
    }

    .portrait-stage {
      grid-row: 1;
      min-height: 400px;
    }
    .portrait-frame {
      width: min(72vw, 300px);
      aspect-ratio: 1;
    }
    .portrait-placeholder {
      border-radius: 45% 45% 42% 42%;
    }
    .orbit-one {
      width: 340px;
      height: 340px;
    }
    .orbit-two {
      width: 310px;
      height: 360px;
    }
    .card-product {
      bottom: 4px;
      left: calc(50% - 194px);
    }
    .card-systems {
      top: 25px;
      right: calc(50% - 188px);
    }

    .hero-copy {
      grid-row: 2;
      text-align: center;
    }
    .eyebrow,
    .hero-actions {
      justify-content: center;
    }
    h1 {
      font-size: clamp(3rem, 11vw, 4.6rem);
    }
    .hero-summary {
      margin-inline: auto;
    }

    .hero-index {
      grid-row: 3;
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-index h2 {
      margin: 12px 0 25px;
    }
    .index-list {
      grid-template-columns: repeat(2, 1fr);
      text-align: left;
    }
    .hero-scroll {
      bottom: 20px;
    }
  }

  @media (max-width: 540px) {
    .hero {
      padding-top: 40px;
    }
    .portrait-stage {
      min-height: 345px;
    }
    .portrait-frame {
      width: min(72vw, 250px);
    }
    .orbit-one {
      width: 280px;
      height: 280px;
    }
    .orbit-two {
      width: 260px;
      height: 300px;
    }
    .portrait-placeholder strong {
      font-size: 3rem;
    }
    .identity-card {
      border-radius: 11px;
    }

    .card-product {
      bottom: 5px;
      left: 0;
      width: 164px;
      padding: 13px 14px;
    }

    .card-product strong {
      font-size: 1.25rem;
    }

    .card-systems {
      top: 22px;
      right: 0;
      width: 142px;
      padding: 12px;
    }

    .card-systems strong {
      font-size: 0.94rem;
    }
    .identity-card small {
      font-size: var(--text-micro, 0.7rem);
    }
    h1 {
      font-size: 2.9rem;
    }
    .hero-summary {
      font-size: 0.92rem;
    }
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .button {
      gap: 10px;
      padding-inline: 12px;
      font-size: 0.76rem;
    }
    .hero-index h2 {
      font-size: 2rem;
    }
    .index-list {
      gap: 0 12px;
    }
    .index-list a {
      grid-template-columns: 32px 1fr 16px;
      font-size: var(--text-xs, 0.75rem);
    }
    .hero-scroll {
      font-size: var(--text-micro, 0.7rem);
    }
  }
</style>
