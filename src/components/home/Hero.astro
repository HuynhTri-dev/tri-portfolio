---
import { profileLinks } from "../../data/portfolio";
---

<section class="hero shell" id="home">
  <div class="hero-copy">
    <div class="eyebrow">
      <span class="status-dot"></span>
      <span
        data-en="Available for software opportunities"
        data-vi="Sẵn sàng cho cơ hội phát triển phần mềm"
      >
        Available for software opportunities
      </span>
    </div>
    <h1>HUỲNH<br />MINH TRÍ</h1>
    <p
      class="hero-summary"
      data-en="Software Developer focused on building practical, future-ready products across industries using modern software engineering, Artificial Intelligence and IoT."
      data-vi="Lập trình viên phần mềm định hướng sản phẩm, tập trung xây dựng các giải pháp thực tiễn cho nhiều lĩnh vực bằng kỹ thuật phần mềm hiện đại, Trí tuệ nhân tạo và IoT."
    >
      Software Developer focused on building practical, future-ready products
      across industries using modern software engineering, Artificial
      Intelligence and IoT.
    </p>
    <div class="hero-actions flex flex-wrap gap-3">
      <a class="button button-primary" href="#projects">
        <span data-en="View projects" data-vi="Xem dự án">View projects</span>
        <span aria-hidden="true">↘</span>
      </a>
      <a
        class="button button-secondary"
        href="/Huynh-Minh-Tri-Software-Engineer-CV.pdf"
        download
      >
        <span data-en="Download CV" data-vi="Tải CV">Download CV</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>

  <div class="portrait-stage">
    <div class="orbit orbit-one" aria-hidden="true"></div>
    <div class="orbit orbit-two" aria-hidden="true"></div>
    <div class="portrait-frame" aria-label="Portrait of Huynh Minh Tri">
      <img
        src="/images/avatar.png"
        alt="Huỳnh Minh Trí"
        class="portrait-image"
        width="340"
        height="410"
      />
    </div>
    <div class="portrait-chip chip-left">
      <span>3.61</span><small>GPA / 4.00</small>
    </div>
    <div class="portrait-chip chip-right">
      <span>2026</span>
      <small data-en="GRADUATION" data-vi="TỐT NGHIỆP">GRADUATION</small>
    </div>
  </div>

  <div class="hero-index">
    <span class="index-kicker" data-en="Profile index" data-vi="Mục lục hồ sơ"
      >Profile index</span
    >
    <h2>SOFTWARE<br /><em>DEVELOPER</em></h2>
    <div class="index-list">
      {
        profileLinks.map((item) => (
          <a href={item.href}>
            <span class="index-number">{item.number}</span>
            <span data-en={item.en} data-vi={item.vi}>
              {item.en}
            </span>
            <span class="index-arrow" aria-hidden="true">
              ↘
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="hero-signal" aria-hidden="true">
    <span>BACKEND</span><i></i><span>AGENTIC AI</span><i></i><span>IoT</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 720px;
    grid-template-columns: 1fr 0.84fr 0.9fr;
    align-items: center;
    gap: 42px;
    padding-top: 105px;
    padding-bottom: 64px;
  }

  .hero::before {
    position: absolute;
    inset: 14% 17% 7%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(18 128 92 / 10%), transparent 68%);
    content: "";
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow:
      0 0 0 5px rgb(24 199 133 / 10%),
      0 0 18px var(--brand-green);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 5vw, 4.65rem);
    font-weight: 800;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .hero-summary {
    max-width: 540px;
    margin: 28px 0 30px;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-size: 0.83rem;
    font-weight: 700;
    transition:
      transform var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      background var(--duration-normal) ease;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button-primary {
    background: var(--brand-green);
    box-shadow: 0 12px 32px rgb(24 199 133 / 18%);
    color: #03140d;
  }

  .button-primary:hover {
    background: var(--brand-soft);
  }

  .button-secondary {
    border-color: var(--border-default);
    background: rgb(255 255 255 / 2.5%);
  }

  .button-secondary:hover {
    border-color: var(--border-active);
  }

  .portrait-stage {
    position: relative;
    display: grid;
    min-height: 485px;
    place-items: center;
  }

  .portrait-frame {
    position: relative;
    z-index: 2;
    width: min(100%, 340px);
    aspect-ratio: 0.83;
    padding: 12px;
    border: 8px solid var(--wood-dark);
    border-radius: 47% 47% 42% 42% / 40% 40% 52% 52%;
    background: linear-gradient(
      145deg,
      var(--wood-soft),
      var(--wood-dark) 38%,
      #261910
    );
    box-shadow:
      0 0 0 1px rgb(168 122 82 / 75%),
      0 0 0 4px rgb(24 199 133 / 15%),
      0 0 45px rgb(24 199 133 / 14%),
      0 30px 80px rgb(0 0 0 / 48%);
    overflow: hidden;
  }

  .portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    border: 1px solid rgb(117 230 178 / 35%);
    border-radius: 43% 43% 38% 38% / 36% 36% 48% 48%;
  }

  .orbit {
    position: absolute;
    border: 1px solid rgb(117 230 178 / 10%);
    border-radius: 50%;
  }

  .orbit-one {
    width: 420px;
    height: 420px;
    transform: rotate(22deg);
  }
  .orbit-two {
    width: 360px;
    height: 450px;
    transform: rotate(-18deg);
    border-color: rgb(124 183 255 / 9%);
  }

  .portrait-chip {
    position: absolute;
    z-index: 3;
    display: flex;
    min-width: 94px;
    flex-direction: column;
    padding: 10px 12px;
    border: 1px solid var(--border-default);
    border-radius: 10px;
    background: rgb(5 14 11 / 90%);
    box-shadow: 0 12px 35px rgb(0 0 0 / 35%);
  }

  .portrait-chip span {
    color: var(--brand-soft);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .portrait-chip small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
  }

  .chip-left {
    bottom: 55px;
    left: -10px;
  }
  .chip-right {
    top: 65px;
    right: -16px;
  }
  .hero-index {
    padding-left: 10px;
  }

  .index-kicker {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-index h2 {
    margin: 14px 0 30px;
    font-size: clamp(2rem, 3.1vw, 3rem);
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .hero-index h2 em {
    color: transparent;
    font-style: normal;
    -webkit-text-stroke: 1px rgb(117 230 178 / 62%);
  }

  .index-list {
    border-top: 1px solid var(--border-default);
  }

  .index-list a {
    display: grid;
    min-height: 52px;
    grid-template-columns: 38px 1fr 20px;
    align-items: center;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    transition:
      padding var(--duration-fast) ease,
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .index-list a:hover {
    padding-inline: 8px;
    background: rgb(24 199 133 / 4.5%);
    color: var(--text-main);
  }

  .index-number {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .index-arrow {
    color: var(--brand-green);
    transition: transform var(--duration-fast) ease;
  }
  .index-list a:hover .index-arrow {
    transform: translate(4px, 4px);
  }

  .hero-signal {
    position: absolute;
    right: 0;
    bottom: 18px;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    color: rgb(182 195 188 / 46%);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.15em;
  }

  .hero-signal i {
    width: 34px;
    height: 1px;
    background: var(--border-default);
  }

  @media (max-width: 1120px) {
    .hero {
      grid-template-columns: 1fr 0.9fr;
      gap: 40px;
    }

    .hero-index {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      align-items: end;
      padding-left: 0;
    }

    .hero-index h2 {
      margin-bottom: 0;
    }
    .index-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 56px;
      padding-bottom: 82px;
    }

    .portrait-stage {
      grid-row: 1;
      min-height: 400px;
    }
    .portrait-frame {
      width: min(72vw, 300px);
      aspect-ratio: 1;
    }
    .portrait-placeholder {
      border-radius: 45% 45% 42% 42%;
    }
    .orbit-one {
      width: 340px;
      height: 340px;
    }
    .orbit-two {
      width: 310px;
      height: 360px;
    }
    .chip-left {
      bottom: 28px;
      left: calc(50% - 175px);
    }
    .chip-right {
      top: 40px;
      right: calc(50% - 178px);
    }

    .hero-copy {
      grid-row: 2;
      text-align: center;
    }
    .eyebrow,
    .hero-actions {
      justify-content: center;
    }
    h1 {
      font-size: clamp(3rem, 11vw, 4.6rem);
    }
    .hero-summary {
      margin-inline: auto;
    }

    .hero-index {
      grid-row: 3;
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-index h2 {
      margin: 12px 0 25px;
    }
    .index-list {
      grid-template-columns: repeat(2, 1fr);
      text-align: left;
    }
    .hero-signal {
      bottom: 24px;
    }
  }

  @media (max-width: 540px) {
    .hero {
      padding-top: 40px;
    }
    .portrait-stage {
      min-height: 345px;
    }
    .portrait-frame {
      width: min(72vw, 250px);
    }
    .orbit-one {
      width: 280px;
      height: 280px;
    }
    .orbit-two {
      width: 260px;
      height: 300px;
    }
    .portrait-placeholder strong {
      font-size: 3rem;
    }
    .portrait-chip {
      min-width: 84px;
      padding: 8px 10px;
    }
    .chip-left {
      bottom: 25px;
      left: 0;
    }
    .chip-right {
      top: 35px;
      right: 0;
    }
    h1 {
      font-size: 2.9rem;
    }
    .hero-summary {
      font-size: 0.92rem;
    }
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .button {
      gap: 10px;
      padding-inline: 12px;
      font-size: 0.74rem;
    }
    .hero-index h2 {
      font-size: 2rem;
    }
    .index-list {
      gap: 0 12px;
    }
    .index-list a {
      grid-template-columns: 28px 1fr 14px;
      font-size: 0.7rem;
    }
    .hero-signal {
      gap: 10px;
      font-size: 0.46rem;
    }
    .hero-signal i {
      width: 16px;
    }
  }
</style>
