---
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="section shell" id="education">
  <SectionHeading
    index="01 / FOUNDATION"
    titleEn="Education"
    titleVi="Học vấn"
    descriptionEn="A software engineering foundation shaped by academic rigor, product competitions and hands-on system building."
    descriptionVi="Nền tảng kỹ thuật phần mềm được hình thành từ học thuật, các cuộc thi sản phẩm và quá trình xây dựng hệ thống thực tế."
  />

  <article class="education-card panel">
    <div class="education-main">
      <a
        class="school-mark"
        href="https://www.hutech.edu.vn/"
        target="_blank"
        rel="noreferrer"
      >
        <img
          src="/images/hutech-logo.png"
          alt="HUTECH logo"
          width="80"
          height="81"
        />
        <span><strong>HUTECH</strong></span>
      </a>
      <div class="education-content">
        <span class="date">SEP 2022 — OCT 2026</span>
        <h3
          data-en="Ho Chi Minh City University of Technology"
          data-vi="Trường Đại học Bách khoa — ĐHQG TP.HCM"
        >
          Ho Chi Minh City University of Technology
        </h3>
        <p
          class="degree"
          data-en="Information Technology · Software Engineering"
          data-vi="Công nghệ Thông tin · Kỹ thuật Phần mềm"
        >
          Information Technology · Software Engineering
        </p>
        <p
          data-en="Expected graduation in October 2026. The program supports a strong base in software design, data systems and collaborative product development."
          data-vi="Dự kiến tốt nghiệp tháng 10/2026. Chương trình xây dựng nền tảng vững chắc về thiết kế phần mềm, hệ thống dữ liệu và phát triển sản phẩm theo nhóm."
        >
          Expected graduation in October 2026. The program supports a strong
          base in software design, data systems and collaborative product
          development.
        </p>
        <a
          class="text-link"
          href="https://www.hutech.edu.vn/"
          target="_blank"
          rel="noreferrer"
        >
          <span data-en="Visit university website" data-vi="Xem website trường"
            >Visit university website</span
          >
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="education-score">
      <div class="score-ring"><span>3.61</span><small>/ 4.00 GPA</small></div>
      <div class="education-milestone">
        <span></span>
        <p>
          <small data-en="CURRENT MILESTONE" data-vi="CỘT MỐC HIỆN TẠI"
            >CURRENT MILESTONE</small
          >
          <strong data-en="Final-year student" data-vi="Sinh viên năm cuối"
            >Final-year student</strong
          >
        </p>
      </div>
    </div>
  </article>
</section>

<style>
  .education-card {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(290px, 0.6fr);
    overflow: hidden;
    border-radius: var(--radius-feature);
  }

  .education-main {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 40px;
    padding: 50px;
  }

  .school-mark {
    display: flex;
    width: 150px;
    height: 150px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgb(124 183 255 / 28%);
    border-radius: 20px;
    background: rgb(59 130 246 / 5.5%);
    transition:
      border var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .school-mark:hover {
    transform: translateY(-3px);
    border-color: rgb(124 183 255 / 62%);
  }
  .school-mark img {
    width: 62px;
    height: 63px;
    object-fit: contain;
  }
  .school-mark span {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }
  .school-mark small {
    color: var(--technical-soft);
    font-family: var(--font-mono);
    font-size: 0.47rem;
  }
  .school-mark strong {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }

  .education-content h3 {
    max-width: 650px;
    margin: 15px 0 8px;
    font-size: clamp(1.45rem, 2.2vw, 2.15rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .education-content > p {
    max-width: 660px;
    color: var(--text-muted);
  }
  .education-content .degree {
    margin: 0 0 20px;
    color: var(--brand-soft);
    font-weight: 600;
  }

  .education-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    padding: 45px;
    border-left: 1px solid var(--border-default);
    background:
      linear-gradient(rgb(124 183 255 / 2.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(124 183 255 / 2.5%) 1px, transparent 1px),
      rgb(5 15 21 / 34%);
    background-size: 28px 28px;
  }

  .score-ring {
    position: relative;
    display: grid;
    width: 170px;
    height: 170px;
    place-content: center;
    border: 1px solid rgb(124 183 255 / 22%);
    border-radius: 50%;
    text-align: center;
    box-shadow: inset 0 0 38px rgb(59 130 246 / 6%);
  }

  .score-ring::before {
    position: absolute;
    inset: 11px;
    transform: rotate(32deg);
    border: 3px solid transparent;
    border-top-color: var(--technical-blue);
    border-right-color: var(--brand-green);
    border-radius: 50%;
    content: "";
  }

  .score-ring span {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 600;
  }
  .score-ring small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }
  .education-milestone {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .education-milestone > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 16px var(--brand-green);
  }
  .education-milestone p {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .education-milestone small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
  }
  .education-milestone strong {
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .education-card {
      grid-template-columns: 1fr;
    }
    .education-main {
      grid-template-columns: 110px 1fr;
      gap: 26px;
      padding: 34px;
    }
    .school-mark {
      width: 110px;
      height: 110px;
    }
    .school-mark img {
      width: 52px;
      height: 53px;
    }
    .education-score {
      flex-direction: row;
      border-top: 1px solid var(--border-default);
      border-left: 0;
    }
    .score-ring {
      width: 140px;
      height: 140px;
    }
  }

  @media (max-width: 540px) {
    .education-main {
      grid-template-columns: 1fr;
      padding: 26px;
    }
    .school-mark {
      width: 100%;
      height: 92px;
      flex-direction: row;
    }
    .education-content h3 {
      font-size: 1.34rem;
    }
    .education-score {
      align-items: center;
      padding: 28px 20px;
    }
    .score-ring {
      width: 116px;
      height: 116px;
      flex: 0 0 auto;
    }
    .score-ring span {
      font-size: 1.7rem;
    }
  }
</style>
