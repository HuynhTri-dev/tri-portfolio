---
/**
 * @name EducationSection.astro
 * @description "The Deep Academic Roots" education section featuring accurate university
 *              branding and an interactive Bioluminescent SVG Progress Arc (91.25% GPA gauge)
 *              with scroll-triggered count-up animation.
 */
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="section shell" id="education">
  <SectionHeading
    index="01 / FOUNDATION"
    titleEn="Education"
    titleVi="Học vấn"
    descriptionEn="A software engineering foundation shaped by academic rigor, product competitions and hands-on system building."
    descriptionVi="Nền tảng kỹ thuật phần mềm được hình thành từ học thuật, các cuộc thi sản phẩm và quá trình xây dựng hệ thống thực tế."
  />

  <article class="education-card panel">
    <div class="education-main">
      <a
        class="school-mark"
        href="https://www.hutech.edu.vn/"
        target="_blank"
        rel="noreferrer"
      >
        <img
          src="/images/hutech-logo.png"
          alt="HUTECH logo"
          width="80"
          height="81"
        />
        <span><strong>HUTECH</strong></span>
      </a>
      <div class="education-content">
        <span class="date">SEP 2022 — JAN 2026</span>
        <h3
          data-en="Ho Chi Minh City University of Technology (HUTECH)"
          data-vi="Trường Đại học Công nghệ TP.HCM (HUTECH)"
        >
          Ho Chi Minh City University of Technology (HUTECH)
        </h3>
        <p
          class="degree"
          data-en="Information Technology · Software Engineering"
          data-vi="Công nghệ Thông tin · Kỹ thuật Phần mềm"
        >
          Information Technology · Software Engineering
        </p>
        <p
          data-en="Expected graduation in January 2026. The program supports a strong base in software design, data systems and collaborative product development."
          data-vi="Dự kiến tốt nghiệp tháng 1/2026. Chương trình xây dựng nền tảng vững chắc về thiết kế phần mềm, hệ thống dữ liệu và phát triển sản phẩm theo nhóm."
        >
          Expected graduation in January 2026. The program supports a strong
          base in software design, data systems and collaborative product
          development.
        </p>
        <a
          class="text-link"
          href="https://www.hutech.edu.vn/"
          target="_blank"
          rel="noreferrer"
        >
          <span data-en="Visit university website" data-vi="Xem website trường"
            >Visit university website</span
          >
          <span aria-hidden="true"
            ><i class="fa-solid fa-arrow-up-right-from-square"></i></span
          >
        </a>
      </div>
    </div>

    <div class="education-score">
      <div
        class="score-ring"
        data-gpa-gauge
        role="img"
        aria-label="GPA 3.65 out of 4.00 (91.25%)"
      >
        <svg class="gpa-svg" viewBox="0 0 170 170" aria-hidden="true">
          <defs>
            <linearGradient id="gpaBioGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8" />
              <stop offset="55%" stop-color="#18c785" />
              <stop offset="100%" stop-color="#75e6b2" />
            </linearGradient>
          </defs>
          <circle
            class="gpa-track"
            cx="85"
            cy="85"
            r="72"
            fill="none"
            stroke-width="4"
          />
          <circle
            class="gpa-ticks"
            cx="85"
            cy="85"
            r="63"
            fill="none"
            stroke-width="1"
            stroke-dasharray="3 6"
          />
          <circle
            class="gpa-progress"
            cx="85"
            cy="85"
            r="72"
            fill="none"
            stroke="url(#gpaBioGradient)"
            stroke-width="5"
            stroke-linecap="round"
          />
        </svg>
        <div class="score-readout">
          <span data-gpa-value>3.65</span>
          <small>/ 4.00 GPA</small>
        </div>
      </div>

      <div class="education-milestone">
        <span></span>
        <p>
          <small data-en="CURRENT STATUS" data-vi="TRẠNG THÁI HIỆN TẠI"
            >CURRENT STATUS</small
          >
          <a
            class="milestone-link"
            href="https://idb.com.vn/All/Support"
            target="_blank"
            rel="noreferrer"
          >
            <strong
              data-en="Working at IDB Group"
              data-vi="Đang làm việc tại Tập đoàn IDB"
              >Working at IDB Group</strong
            >
            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
          </a>
        </p>
      </div>
    </div>
  </article>
</section>

<script>
  /**
   * Animates the Bioluminescent GPA Gauge arc (91.25%) and numeric count-up
   * once the Education card enters the viewport.
   */
  const gaugeEl = document.querySelector<HTMLElement>("[data-gpa-gauge]");
  const valEl = document.querySelector<HTMLElement>("[data-gpa-value]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (gaugeEl && valEl) {
    if (reduceMotion || !("IntersectionObserver" in window)) {
      gaugeEl.classList.add("is-active");
      valEl.textContent = "3.65";
    } else {
      const targetGpa = 3.65;
      const durationMs = 1350;

      const animateGpa = () => {
        gaugeEl.classList.add("is-active");
        const start = performance.now();

        const step = (now: number) => {
          const elapsed = Math.min(1, (now - start) / durationMs);
          const eased = 1 - Math.pow(1 - elapsed, 3);
          valEl.textContent = (targetGpa * eased).toFixed(2);
          if (elapsed < 1) {
            window.requestAnimationFrame(step);
          } else {
            valEl.textContent = "3.65";
          }
        };

        window.requestAnimationFrame(step);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animateGpa();
            observer.disconnect();
          });
        },
        { threshold: 0.35 },
      );

      observer.observe(gaugeEl);
    }
  }
</script>

<style>
  .education-card {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(290px, 0.6fr);
    overflow: hidden;
    border-radius: var(--radius-feature);
  }

  .education-main {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 40px;
    padding: 50px;
  }

  .school-mark {
    display: flex;
    width: 150px;
    height: 150px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgb(124 183 255 / 28%);
    border-radius: 20px;
    background: rgb(59 130 246 / 5.5%);
    transition:
      border var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .school-mark:hover {
    transform: translateY(-3px);
    border-color: rgb(124 183 255 / 62%);
  }

  .school-mark img {
    width: 62px;
    height: 63px;
    object-fit: contain;
  }

  .school-mark span {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  .school-mark small {
    color: var(--technical-soft);
    font-family: var(--font-mono);
    font-size: var(--text-micro, 0.7rem);
  }

  .school-mark strong {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }

  .education-content h3 {
    max-width: 650px;
    margin: 15px 0 8px;
    font-size: clamp(1.45rem, 2.2vw, 2.15rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .education-content > p {
    max-width: 660px;
    color: var(--text-muted);
  }

  .education-content .degree {
    margin: 0 0 20px;
    color: var(--brand-soft);
    font-weight: 600;
  }

  .education-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    padding: 45px;
    border-left: 1px solid var(--border-default);
    background:
      linear-gradient(rgb(124 183 255 / 2.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(124 183 255 / 2.5%) 1px, transparent 1px),
      rgb(5 15 21 / 34%);
    background-size: 28px 28px;
  }

  .score-ring {
    position: relative;
    display: grid;
    width: 174px;
    height: 174px;
    place-items: center;
    border-radius: 50%;
    text-align: center;
    box-shadow: inset 0 0 38px rgb(24 199 133 / 8%);
  }

  .gpa-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    overflow: visible;
  }

  .gpa-track {
    stroke: rgba(124, 183, 255, 0.14);
  }

  .gpa-ticks {
    stroke: rgba(117, 230, 178, 0.22);
  }

  .gpa-progress {
    /* Circumference = 2 * PI * 72 = 452.39; 91.25% fill => dashoffset 39.58 */
    stroke-dasharray: 452.39;
    stroke-dashoffset: 452.39;
    filter: drop-shadow(0 0 8px rgba(24, 199, 133, 0.55));
    transition: stroke-dashoffset 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .score-ring.is-active .gpa-progress {
    stroke-dashoffset: 39.58;
  }

  .score-readout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .score-readout span {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1.05;
    color: var(--text-main);
  }

  .score-readout small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs, 0.75rem);
  }

  .education-milestone {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .education-milestone > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 16px var(--brand-green);
  }

  .education-milestone p {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .education-milestone small {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro, 0.7rem);
    letter-spacing: 0.08em;
  }

  .education-milestone strong {
    font-size: 0.84rem;
  }

  .milestone-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-main);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .milestone-link:hover {
    color: var(--brand-green);
  }

  .milestone-link i {
    font-size: var(--text-micro, 0.7rem);
    color: var(--brand-soft);
  }

  @media (max-width: 820px) {
    .education-card {
      grid-template-columns: 1fr;
    }
    .education-main {
      grid-template-columns: 110px 1fr;
      gap: 26px;
      padding: 34px;
    }
    .school-mark {
      width: 110px;
      height: 110px;
    }
    .school-mark img {
      width: 52px;
      height: 53px;
    }
    .education-score {
      flex-direction: row;
      border-top: 1px solid var(--border-default);
      border-left: 0;
    }
    .score-ring {
      width: 142px;
      height: 142px;
    }
  }

  @media (max-width: 540px) {
    .education-main {
      grid-template-columns: 1fr;
      padding: 26px;
    }
    .school-mark {
      width: 100%;
      height: 92px;
      flex-direction: row;
    }
    .education-content h3 {
      font-size: 1.34rem;
    }
    .education-score {
      align-items: center;
      padding: 28px 20px;
    }
    .score-ring {
      width: 120px;
      height: 120px;
      flex: 0 0 auto;
    }
    .score-readout span {
      font-size: 1.68rem;
    }
  }
</style>
