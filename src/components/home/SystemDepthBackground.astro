---
/**
 * @name SystemDepthBackground.astro
 * @description Interactive 3D WebGL Knowledge Forest (The Cyber-Arboretum) featuring
 *              procedural synaptic trees with circuit traces, a contour-highlighted LiDAR
 *              wireframe terrain with scroll ground-resonance ripples, proximity-activated
 *              monolith beacons, capability-reactive biome color shifting, and cursor-repelled data spores.
 */

interface Props {
  isHome?: boolean;
}

const { isHome = true } = Astro.props;
---

<div
  class:list={["system-depth-container", { "is-subpage": !isHome }]}
  aria-hidden="true"
>
  <canvas id="system-depth-canvas"></canvas>
  <div class="system-depth-overlay"></div>
</div>

<script>
  /**
   * @name systemDepthEngine
   * @description Initializes and orchestrates the Three.js Cyber-Arboretum WebGL scene.
   *              Manages terrain ground-resonance waves, breathing synaptic foliage,
   *              beacon proximity lighting, capability hue transitions, and spore physics.
   */

  interface TreeConfig {
    x: number;
    y: number;
    z: number;
    scale: number;
    type: "pine" | "crystal" | "ancient";
    hueShift?: number;
  }

  interface SporeState {
    bx: number;
    by: number;
    bz: number;
    phase: number;
    speed: number;
  }

  const CAPABILITY_PALETTES: Record<string, { core: number; accent: number }> = {
    BE: { core: 0x18c785, accent: 0x38bdf8 },
    AI: { core: 0x3b82f6, accent: 0x60a5fa },
    DT: { core: 0xa855f7, accent: 0x38bdf8 },
    DV: { core: 0xf59e0b, accent: 0x18c785 },
    UI: { core: 0x2dd4bf, accent: 0x75e6b2 },
  };

  /**
   * Initializes the Three.js WebGL scene asynchronously after dynamic import.
   * @returns Cleanup callback function to teardown event listeners and GPU buffers.
   */
  async function initSystemDepth(): Promise<() => void> {
    const canvas = document.getElementById(
      "system-depth-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return () => {};

    const container = canvas.parentElement;
    if (!container) return () => {};

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const THREE = await import("three");

    // --- Scene & Atmospheric Bioluminescent Fog ---
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x050b09, 0.021);

    const width = container.clientWidth || window.innerWidth;
    const height = container.clientHeight || window.innerHeight;

    const camera = new THREE.PerspectiveCamera(46, width / height, 0.1, 145);
    camera.position.set(0, 2.3, 14.2);

    const isMobile = window.innerWidth < 768;
    const maxPixelRatio = isMobile ? 1.0 : 1.35;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: !isMobile,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(
      Math.min(window.devicePixelRatio || 1, maxPixelRatio),
    );
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.22;

    // --- Dynamic Lighting Setup ---
    const ambientLight = new THREE.AmbientLight(0x7ea995, 0.88);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xbde8d5, 1.28);
    keyLight.position.set(8, 14, 10);
    scene.add(keyLight);

    const cyanPointLight = new THREE.PointLight(0x38bdf8, 18, 34);
    cyanPointLight.position.set(-7, 3.5, 2);
    scene.add(cyanPointLight);

    const emeraldPointLight = new THREE.PointLight(0x18c785, 22, 36);
    emeraldPointLight.position.set(7, 3, -12);
    scene.add(emeraldPointLight);

    const movingCoreLight = new THREE.PointLight(0x18c785, 16, 30);
    movingCoreLight.position.set(0, 1.2, -16);
    scene.add(movingCoreLight);

    // Dedicated beacon spotlight that intensifies near active biome monoliths
    const beaconSpotLight = new THREE.PointLight(0x4eedb0, 6, 20);
    beaconSpotLight.position.set(-5.2, 2.2, 6);
    scene.add(beaconSpotLight);

    const targetCoreColor = new THREE.Color(0x18c785);
    const targetAccentColor = new THREE.Color(0x38bdf8);

    const worldGroup = new THREE.Group();
    scene.add(worldGroup);

    // =========================================================================
    // 1. TOPOLOGICAL LIDAR WIREFRAME TERRAIN WITH CONTOUR HIGHLIGHTS
    // =========================================================================
    const terrainWidth = 86;
    const terrainDepth = 104;
    const segX = isMobile ? 24 : 48;
    const segZ = isMobile ? 28 : 52;

    const terrainGeo = new THREE.PlaneGeometry(
      terrainWidth,
      terrainDepth,
      segX,
      segZ,
    );
    terrainGeo.rotateX(-Math.PI / 2);

    const posAttr = terrainGeo.attributes.position;
    const vertexCount = posAttr.count;
    const baseTerrainY = new Float32Array(vertexCount);
    const terrainColors = new Float32Array(vertexCount * 3);

    const deepColor = new THREE.Color(0x0d3326);
    const contourColor = new THREE.Color(0x18c785);
    const ridgeColor = new THREE.Color(0x289976);
    const tempColor = new THREE.Color();

    for (let i = 0; i < vertexCount; i++) {
      const vx = posAttr.getX(i);
      const vz = posAttr.getZ(i);

      const distFromCenter = Math.abs(vx);
      let yElev = -2.35;

      if (distFromCenter > 3.5) {
        const ridge = Math.pow(distFromCenter - 3.5, 1.24) * 0.36;
        const wave =
          Math.sin(vx * 0.36 + vz * 0.22) * 0.55 +
          Math.cos(vx * 0.18 - vz * 0.3) * 0.4;
        yElev += ridge + wave;
      } else {
        yElev += Math.sin(vz * 0.24) * 0.1;
      }

      posAttr.setY(i, yElev);
      baseTerrainY[i] = yElev;

      // Highlight topological contour bands with emerald bioluminescence
      const normalizedHeight = Math.min(1, Math.max(0, (yElev + 2.4) / 5.5));
      const isContourBand = Math.abs(((yElev + 10) * 1.6) % 1 - 0.5) < 0.14;
      if (isContourBand && distFromCenter > 3.2) {
        tempColor.copy(contourColor).lerp(ridgeColor, normalizedHeight * 0.5);
      } else {
        tempColor.copy(deepColor).lerp(ridgeColor, normalizedHeight * 0.45);
      }

      terrainColors[i * 3] = tempColor.r;
      terrainColors[i * 3 + 1] = tempColor.g;
      terrainColors[i * 3 + 2] = tempColor.b;
    }

    terrainGeo.setAttribute(
      "color",
      new THREE.BufferAttribute(terrainColors, 3),
    );
    posAttr.needsUpdate = true;
    terrainGeo.computeVertexNormals();

    const terrainBaseMat = new THREE.MeshStandardMaterial({
      color: 0x04100c,
      roughness: 0.92,
      metalness: 0.08,
      flatShading: true,
    });
    const terrainBaseMesh = new THREE.Mesh(terrainGeo, terrainBaseMat);
    terrainBaseMesh.position.set(0, -0.03, -22);
    worldGroup.add(terrainBaseMesh);

    const wireframeMat = new THREE.MeshBasicMaterial({
      vertexColors: true,
      wireframe: true,
      transparent: true,
      opacity: isMobile ? 0.34 : 0.52,
    });
    const terrainWireMesh = new THREE.Mesh(terrainGeo, wireframeMat);
    terrainWireMesh.position.set(0, 0, -22);
    worldGroup.add(terrainWireMesh);

    // =========================================================================
    // 2. MONOLITH GUIDE BEACONS & BIOME PORTALS
    // =========================================================================
    const portalGroup = new THREE.Group();
    worldGroup.add(portalGroup);

    const beaconZPositions = [6, -3, -12, -21, -30, -39];
    const beaconGeo = new THREE.BoxGeometry(0.16, 4.8, 0.16);
    const ringGeo = new THREE.TorusGeometry(0.58, 0.022, 6, 28);
    const ringMat = new THREE.MeshBasicMaterial({
      color: 0x4eedb0,
      transparent: true,
      opacity: 0.68,
    });

    interface BeaconNode {
      z: number;
      x: number;
      mat: InstanceType<typeof THREE.MeshStandardMaterial>;
      ring: InstanceType<typeof THREE.Mesh>;
    }

    const beaconNodes: BeaconNode[] = [];
    const disposableBeaconMats: InstanceType<typeof THREE.MeshStandardMaterial>[] = [];

    beaconZPositions.forEach((bz, idx) => {
      const isLeft = idx % 2 === 0;
      const bx = isLeft ? -5.1 : 5.1;

      const individualBeaconMat = new THREE.MeshStandardMaterial({
        color: 0x0b251b,
        emissive: 0x18c785,
        emissiveIntensity: 0.35,
        roughness: 0.28,
        metalness: 0.82,
      });
      disposableBeaconMats.push(individualBeaconMat);

      const beacon = new THREE.Mesh(beaconGeo, individualBeaconMat);
      beacon.position.set(bx, 0.15, bz);
      portalGroup.add(beacon);

      const ring = new THREE.Mesh(ringGeo, ringMat);
      ring.position.set(bx, 1.85, bz);
      ring.rotation.x = Math.PI / 2;
      portalGroup.add(ring);

      beaconNodes.push({ z: bz, x: bx, mat: individualBeaconMat, ring });
    });

    // Subtle aerial arch portals framing key biomes
    const portalArchGeo = new THREE.BufferGeometry();
    const archVerts = new Float32Array([
      -5.1, -2.2, 0, -5.1, 3.8, 0,
      -5.1, 3.8, 0, -3.2, 4.8, 0,
       5.1, -2.2, 0,  5.1, 3.8, 0,
       5.1, 3.8, 0,  3.2, 4.8, 0,
    ]);
    portalArchGeo.setAttribute(
      "position",
      new THREE.BufferAttribute(archVerts, 3),
    );
    const portalArchMat = new THREE.LineBasicMaterial({
      color: 0x18c785,
      transparent: true,
      opacity: 0.24,
    });
    [-3, -21, -35].forEach((az) => {
      const arch = new THREE.LineSegments(portalArchGeo, portalArchMat);
      arch.position.set(0, 0, az);
      portalGroup.add(arch);
    });

    // =========================================================================
    // 3. BIOLUMINESCENT SYNAPTIC KNOWLEDGE TREES
    // =========================================================================
    const sharedTrunkGeo = new THREE.CylinderGeometry(0.18, 0.34, 2.45, 6);
    const sharedPineConeGeos = [
      new THREE.ConeGeometry(1.42, 1.9, 6),
      new THREE.ConeGeometry(1.12, 1.7, 6),
      new THREE.ConeGeometry(0.82, 1.5, 6),
    ];
    const sharedCrystalGeo1 = new THREE.IcosahedronGeometry(1.12, 0);
    const sharedCrystalGeo2 = new THREE.IcosahedronGeometry(0.76, 0);
    const sharedNodeGeo = new THREE.OctahedronGeometry(0.09, 0);

    const trunkMat = new THREE.MeshStandardMaterial({
      color: 0x0c1e16,
      emissive: 0x05120d,
      roughness: 0.84,
      metalness: 0.18,
      flatShading: true,
    });

    const nodeMat = new THREE.MeshBasicMaterial({
      color: 0x75e6b2,
      transparent: true,
      opacity: 0.88,
    });

    const wireframeConeMats = [
      new THREE.LineBasicMaterial({
        color: 0x2fb88a,
        transparent: true,
        opacity: 0.46,
      }),
      new THREE.LineBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.42,
      }),
    ];

    const sharedCircuitGeo = new THREE.BufferGeometry();
    sharedCircuitGeo.setAttribute(
      "position",
      new THREE.BufferAttribute(
        new Float32Array([
          // Root trace 1 -> Trunk spiral -> Canopy
          -0.55, 0.02, 0.35, -0.22, 0.18, 0.14,
          -0.22, 0.18, 0.14,  0.22, 0.92, -0.12,
           0.22, 0.92, -0.12, -0.18, 1.68, 0.14,
          -0.18, 1.68, 0.14,  0.14, 2.35, 0.06,
          // Root trace 2 -> Secondary circuit vein
           0.52, 0.02, -0.32,  0.22, 0.2, -0.14,
           0.22, 0.2, -0.14, -0.2, 1.05, -0.15,
          -0.2, 1.05, -0.15,  0.16, 1.95, 0.12,
        ]),
        3,
      ),
    );
    const sharedCircuitMat = new THREE.LineBasicMaterial({
      color: 0x4eedb0,
      transparent: true,
      opacity: 0.68,
    });

    const pulsingMaterials: InstanceType<typeof THREE.MeshStandardMaterial>[] = [];
    const breathingCrowns: { group: InstanceType<typeof THREE.Group>; z: number }[] = [];
    const crystalCrowns: InstanceType<typeof THREE.Group>[] = [];

    /**
     * Creates a procedural Knowledge Tree with root/trunk PCB circuit veins and synaptic crown.
     * @param type - Tree morphology ('pine', 'crystal', or 'ancient')
     * @param scale - Uniform scale multiplier
     * @param treeZ - World Z coordinate used to phase-offset breathing animation
     * @param hueShift - Hex color offset for organic diversity
     * @returns Assembled Three.js Group
     */
    function createKnowledgeTree(
      type: "pine" | "crystal" | "ancient",
      scale: number,
      treeZ: number,
      hueShift = 0,
    ): InstanceType<typeof THREE.Group> {
      const tree = new THREE.Group();

      const trunkMesh = new THREE.Mesh(sharedTrunkGeo, trunkMat);
      trunkMesh.position.y = 1.22;
      tree.add(trunkMesh);

      const trunkLines = new THREE.LineSegments(
        sharedCircuitGeo,
        sharedCircuitMat,
      );
      tree.add(trunkLines);

      // Glowing synaptic junction node on trunk
      const junctionNode = new THREE.Mesh(sharedNodeGeo, nodeMat);
      junctionNode.position.set(0.22, 0.92, -0.12);
      tree.add(junctionNode);

      const crownGroup = new THREE.Group();
      tree.add(crownGroup);
      breathingCrowns.push({ group: crownGroup, z: treeZ });

      if (type === "pine" || type === "ancient") {
        const foliageTiers = [
          { y: 2.32, color: 0x144937, emissive: 0x0b3325 },
          { y: 3.32, color: 0x1a5c45, emissive: 0x104532 },
          { y: 4.22, color: 0x227558, emissive: 0x155940 },
        ];

        foliageTiers.forEach((tier, tIdx) => {
          const leafMat = new THREE.MeshStandardMaterial({
            color: tier.color + hueShift,
            emissive: tier.emissive,
            emissiveIntensity: 0.36,
            roughness: 0.44,
            metalness: 0.24,
            flatShading: true,
          });
          pulsingMaterials.push(leafMat);

          const coneMesh = new THREE.Mesh(sharedPineConeGeos[tIdx], leafMat);
          coneMesh.position.y = tier.y;
          coneMesh.rotation.y = tIdx * 0.78;
          crownGroup.add(coneMesh);

          if ((tIdx === 2 || type === "ancient") && !isMobile) {
            const wireGeo = new THREE.WireframeGeometry(
              sharedPineConeGeos[tIdx],
            );
            const wireMesh = new THREE.LineSegments(
              wireGeo,
              wireframeConeMats[tIdx % 2],
            );
            wireMesh.position.y = tier.y;
            wireMesh.rotation.y = tIdx * 0.78;
            wireMesh.scale.setScalar(1.03);
            crownGroup.add(wireMesh);
          }
        });
      } else {
        const crystalMat = new THREE.MeshStandardMaterial({
          color: 0x1b674e + hueShift,
          emissive: 0x12523c,
          emissiveIntensity: 0.46,
          roughness: 0.28,
          metalness: 0.42,
          flatShading: true,
        });
        pulsingMaterials.push(crystalMat);
        crystalCrowns.push(crownGroup);

        const crown1 = new THREE.Mesh(sharedCrystalGeo1, crystalMat);
        crown1.position.y = 2.55;
        crownGroup.add(crown1);

        const crown2 = new THREE.Mesh(sharedCrystalGeo2, crystalMat);
        crown2.position.set(0.35, 3.45, 0.1);
        crownGroup.add(crown2);

        if (!isMobile) {
          const wireGeo = new THREE.WireframeGeometry(sharedCrystalGeo1);
          const wireMesh = new THREE.LineSegments(
            wireGeo,
            wireframeConeMats[1],
          );
          wireMesh.position.y = 2.55;
          wireMesh.scale.setScalar(1.045);
          crownGroup.add(wireMesh);
        }
      }

      tree.scale.setScalar(scale);
      return tree;
    }

    const treeGroup = new THREE.Group();
    worldGroup.add(treeGroup);

    const treeConfigs: TreeConfig[] = [
      { x: -5.6, y: -2.3, z: 8, scale: 1.15, type: "pine" },
      { x: -7.6, y: -2.1, z: 3, scale: 1.45, type: "crystal", hueShift: 0x04160a },
      { x: -5.4, y: -2.3, z: -3, scale: 0.98, type: "pine" },
      { x: -8.5, y: -2.0, z: -10, scale: 1.62, type: "ancient", hueShift: 0x061e0d },
      { x: -6.2, y: -2.25, z: -18, scale: 1.18, type: "crystal" },
      { x: -7.5, y: -2.15, z: -27, scale: 1.42, type: "pine" },
      { x: -5.8, y: -2.3, z: -37, scale: 1.12, type: "crystal" },
      { x: 5.6, y: -2.3, z: 9, scale: 1.1, type: "crystal" },
      { x: 7.8, y: -2.15, z: 4, scale: 1.42, type: "pine", hueShift: 0x05180c },
      { x: 5.5, y: -2.3, z: -2, scale: 0.96, type: "crystal" },
      { x: 8.2, y: -2.0, z: -9, scale: 1.66, type: "ancient" },
      { x: 6.4, y: -2.25, z: -18, scale: 1.2, type: "pine", hueShift: 0x041408 },
      { x: 7.6, y: -2.15, z: -28, scale: 1.46, type: "crystal" },
      { x: 5.9, y: -2.3, z: -38, scale: 1.08, type: "pine" },
    ];

    treeConfigs.forEach((cfg) => {
      const tree = createKnowledgeTree(cfg.type, cfg.scale, cfg.z, cfg.hueShift);
      tree.position.set(cfg.x, cfg.y, cfg.z);
      tree.rotation.y = Math.random() * Math.PI * 2;
      treeGroup.add(tree);
    });

    // =========================================================================
    // 4. INTERACTIVE KNOWLEDGE SPORES & SYNAPTIC FIREFLIES
    // =========================================================================
    const sporeCount = isMobile ? 260 : 720;
    const sporePositions = new Float32Array(sporeCount * 3);
    const sporeColors = new Float32Array(sporeCount * 3);
    const sporeStates: SporeState[] = [];

    for (let i = 0; i < sporeCount; i++) {
      const bx = (Math.random() - 0.5) * 32;
      const by = -2.0 + Math.random() * 11.5;
      const bz = 12 - Math.random() * 62;

      sporePositions[i * 3] = bx;
      sporePositions[i * 3 + 1] = by;
      sporePositions[i * 3 + 2] = bz;

      sporeStates.push({
        bx,
        by,
        bz,
        phase: Math.random() * Math.PI * 2,
        speed: 0.55 + Math.random() * 0.85,
      });

      const randColor = Math.random();
      if (randColor > 0.76) {
        // Technical Cyan (#38bdf8)
        sporeColors[i * 3] = 0.22;
        sporeColors[i * 3 + 1] = 0.74;
        sporeColors[i * 3 + 2] = 0.97;
      } else if (randColor > 0.64) {
        // Firefly Warm Gold (#facc15)
        sporeColors[i * 3] = 0.98;
        sporeColors[i * 3 + 1] = 0.8;
        sporeColors[i * 3 + 2] = 0.08;
      } else {
        // Bioluminescent Emerald (#18c785)
        sporeColors[i * 3] = 0.09;
        sporeColors[i * 3 + 1] = 0.78;
        sporeColors[i * 3 + 2] = 0.52;
      }
    }

    const sporeGeo = new THREE.BufferGeometry();
    const sporePosAttr = new THREE.BufferAttribute(sporePositions, 3);
    sporeGeo.setAttribute("position", sporePosAttr);
    sporeGeo.setAttribute("color", new THREE.BufferAttribute(sporeColors, 3));

    const sporeMat = new THREE.PointsMaterial({
      size: isMobile ? 0.06 : 0.08,
      vertexColors: true,
      transparent: true,
      opacity: 0.84,
      sizeAttenuation: true,
    });
    const sporeSystem = new THREE.Points(sporeGeo, sporeMat);
    scene.add(sporeSystem);

    // =========================================================================
    // 5. INTERACTION TRACKING, SCROLL RESONANCE & CAPABILITY CHANNEL SYNC
    // =========================================================================
    let targetProgress = 0;
    let currentProgress = 0;
    let scrollResonance = 0;
    let lastScrollY = window.scrollY;
    let channelImpulse = 0;

    let targetMouseX = 0;
    let currentMouseX = 0;
    let targetMouseY = 0;
    let currentMouseY = 0;

    function onScroll(): void {
      const currentY = window.scrollY;
      const delta = Math.abs(currentY - lastScrollY);
      lastScrollY = currentY;
      scrollResonance = Math.min(1.0, scrollResonance + delta * 0.004);

      const maxScroll = Math.max(
        1,
        document.documentElement.scrollHeight - window.innerHeight,
      );
      targetProgress = Math.min(1, Math.max(0, currentY / maxScroll));
    }

    function onPointerMove(e: MouseEvent): void {
      targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    }

    function onCapabilityChange(event: Event): void {
      const shortCode = (event as CustomEvent<{ short?: string }>).detail?.short ?? "BE";
      const palette = CAPABILITY_PALETTES[shortCode] ?? CAPABILITY_PALETTES.BE;
      targetCoreColor.setHex(palette.core);
      targetAccentColor.setHex(palette.accent);
      channelImpulse = 1.0;
    }

    let resizeTimer = 0;
    function onResize(): void {
      if (!canvas || !container) return;
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        const w = container.clientWidth || window.innerWidth;
        const h = container.clientHeight || window.innerHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }, 100);
    }

    onScroll();
    currentProgress = targetProgress;

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("portfolio:capability-change", onCapabilityChange);
    if (!isMobile) {
      window.addEventListener("mousemove", onPointerMove, { passive: true });
    }
    window.addEventListener("resize", onResize, { passive: true });

    // =========================================================================
    // 6. ANIMATION & RENDER LOOP
    // =========================================================================
    let animId = 0;
    let startTime = performance.now();
    let isVisible = true;

    function onVisibilityChange(): void {
      isVisible = !document.hidden;
      if (isVisible) {
        startTime = performance.now();
        if (!animId) animId = requestAnimationFrame(animate);
      } else if (animId) {
        cancelAnimationFrame(animId);
        animId = 0;
      }
    }
    document.addEventListener("visibilitychange", onVisibilityChange);

    function animate(): void {
      animId = requestAnimationFrame(animate);
      if (!isVisible) return;

      const elapsed = (performance.now() - startTime) * 0.001;

      const lerpFactor = prefersReducedMotion ? 0.03 : 0.055;
      currentProgress += (targetProgress - currentProgress) * lerpFactor;
      currentMouseX += (targetMouseX - currentMouseX) * 0.045;
      currentMouseY += (targetMouseY - currentMouseY) * 0.045;

      // Decay impulses smoothly
      scrollResonance *= 0.94;
      channelImpulse *= 0.95;

      // Smoothly interpolate scene palette toward active TechTrail capability channel
      movingCoreLight.color.lerp(targetCoreColor, 0.05);
      cyanPointLight.color.lerp(targetAccentColor, 0.05);
      ringMat.color.lerp(targetCoreColor, 0.05);

      // 6-Biome Spatial Camera Trajectory (Canopy -> Roots -> Trail -> Grove -> Portals -> Sanctuary)
      const startZ = 14.2;
      const endZ = -35.0;
      const targetCamZ = startZ + (endZ - startZ) * currentProgress;

      const lateralSway = Math.sin(currentProgress * Math.PI * 2.0) * 0.55;
      const targetCamX = currentMouseX * 0.82 + lateralSway;
      const targetCamY = 2.15 - currentProgress * 0.95 + currentMouseY * 0.28;

      camera.position.z = targetCamZ;
      camera.position.y = targetCamY;
      camera.position.x = targetCamX;

      const lookTargetZ = targetCamZ - 12;
      camera.lookAt(lateralSway * 0.45, 0.45, lookTargetZ);

      // Ground Resonance: subtle wave traveling outward from camera along terrain
      if (!isMobile && scrollResonance > 0.015) {
        for (let i = 0; i < vertexCount; i++) {
          const worldZ = posAttr.getZ(i) - 22;
          const distZ = Math.abs(worldZ - targetCamZ);
          const ripple =
            Math.sin(distZ * 0.45 - elapsed * 5.0) *
            Math.exp(-distZ * 0.08) *
            0.22 *
            scrollResonance;
          posAttr.setY(i, baseTerrainY[i] + ripple);
        }
        posAttr.needsUpdate = true;
      }

      // Moving core light & proximity-activated Beacon PointLight (5 -> 25 intensity)
      movingCoreLight.position.z = targetCamZ - 7;
      movingCoreLight.position.x = targetCamX;
      movingCoreLight.intensity =
        15 + Math.sin(elapsed * 1.8) * 3 + channelImpulse * 10;
      cyanPointLight.intensity = 17 + Math.cos(elapsed * 1.4) * 2.5;

      let closestBeacon: BeaconNode | null = null;
      let minBeaconDist = Infinity;

      beaconNodes.forEach((node, idx) => {
        node.ring.rotation.z = elapsed * (0.65 + idx * 0.1) + channelImpulse * 1.2;
        const dist = Math.abs(targetCamZ - 6 - node.z);
        const proximity = Math.max(0, 1 - dist / 12);
        node.mat.emissiveIntensity = 0.28 + proximity * 0.95 + channelImpulse * 0.4;
        node.ring.scale.setScalar(1 + proximity * 0.22);

        if (dist < minBeaconDist) {
          minBeaconDist = dist;
          closestBeacon = node;
        }
      });

      if (closestBeacon) {
        const activeNode = closestBeacon as BeaconNode;
        const beaconProximity = Math.max(0, 1 - minBeaconDist / 12);
        beaconSpotLight.position.set(activeNode.x, 2.2, activeNode.z);
        beaconSpotLight.intensity = 5 + beaconProximity * 20;
      }

      // Breathing synaptic crowns & crystal channel resonance
      breathingCrowns.forEach(({ group, z }) => {
        const breath = 1 + Math.sin(elapsed * 1.5 + z * 0.35) * 0.026;
        group.scale.set(breath, 1 + (breath - 1) * 1.35, breath);
      });

      crystalCrowns.forEach((crown, idx) => {
        crown.rotation.y =
          elapsed * 0.18 + idx * 0.9 + channelImpulse * Math.PI * 0.35;
      });

      pulsingMaterials.forEach((mat, mIdx) => {
        mat.emissiveIntensity =
          0.3 +
          Math.sin(elapsed * 2.1 + mIdx * 0.45) * 0.14 +
          channelImpulse * 0.35;
      });

      // Interactive Spores (Perlin-style float + cursor magnetic repulsion)
      if (!isMobile) {
        const mouseWorldX = currentMouseX * 7.2 + lateralSway;
        const mouseWorldY = 1.2 - currentMouseY * 3.8;

        for (let i = 0; i < sporeCount; i++) {
          const state = sporeStates[i];
          let px = state.bx + Math.sin(elapsed * state.speed + state.phase) * 0.38;
          let py =
            state.by + Math.cos(elapsed * state.speed * 0.82 + state.phase) * 0.32;
          const pz = state.bz;

          const zNearCamera = Math.abs(pz - (targetCamZ - 8)) < 16;
          if (zNearCamera) {
            const dx = px - mouseWorldX;
            const dy = py - mouseWorldY;
            const distSq = dx * dx + dy * dy;

            if (distSq < 11.5) {
              const dist = Math.sqrt(distSq) || 0.001;
              const push = (3.4 - dist) * 0.24;
              px += (dx / dist) * push;
              py += (dy / dist) * push;
            }
          }

          sporePositions[i * 3] = px;
          sporePositions[i * 3 + 1] = py;
          sporePositions[i * 3 + 2] = pz;
        }
        sporePosAttr.needsUpdate = true;
      }

      sporeSystem.rotation.y = elapsed * 0.006;

      renderer.render(scene, camera);
    }

    renderer.render(scene, camera);

    requestAnimationFrame(() => {
      canvas.classList.add("is-visible");
    });

    if (!prefersReducedMotion) {
      animate();
    }

    return () => {
      if (animId) cancelAnimationFrame(animId);
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("portfolio:capability-change", onCapabilityChange);
      window.removeEventListener("mousemove", onPointerMove);
      window.removeEventListener("resize", onResize);
      document.removeEventListener("visibilitychange", onVisibilityChange);

      terrainGeo.dispose();
      terrainBaseMat.dispose();
      wireframeMat.dispose();
      beaconGeo.dispose();
      disposableBeaconMats.forEach((m) => m.dispose());
      ringGeo.dispose();
      ringMat.dispose();
      portalArchGeo.dispose();
      portalArchMat.dispose();
      sharedTrunkGeo.dispose();
      sharedPineConeGeos.forEach((g) => g.dispose());
      sharedCrystalGeo1.dispose();
      sharedCrystalGeo2.dispose();
      sharedNodeGeo.dispose();
      sharedCircuitGeo.dispose();
      sharedCircuitMat.dispose();
      trunkMat.dispose();
      nodeMat.dispose();
      wireframeConeMats.forEach((m) => m.dispose());
      pulsingMaterials.forEach((m) => m.dispose());
      sporeGeo.dispose();
      sporeMat.dispose();
      renderer.dispose();
    };
  }

  /**
   * Schedules initialization of 3D system depth using an idle/interaction strategy
   * so critical DOM, fonts, and LCP imagery paint first with zero blocking.
   */
  function scheduleSystemDepth(): void {
    try {
      const testCanvas = document.createElement("canvas");
      const gl =
        testCanvas.getContext("webgl") ||
        testCanvas.getContext("experimental-webgl");
      if (!gl) return;
    } catch {
      return;
    }

    let hasStarted = false;

    const start = () => {
      if (hasStarted) return;
      hasStarted = true;
      cleanupListeners();
      initSystemDepth();
    };

    const cleanupListeners = () => {
      window.removeEventListener("scroll", onFirstInteraction);
      window.removeEventListener("pointerdown", onFirstInteraction);
      window.removeEventListener("touchstart", onFirstInteraction);
      window.removeEventListener("keydown", onFirstInteraction);
    };

    const onFirstInteraction = () => {
      start();
    };

    window.addEventListener("scroll", onFirstInteraction, {
      passive: true,
      once: true,
    });
    window.addEventListener("pointerdown", onFirstInteraction, {
      passive: true,
      once: true,
    });
    window.addEventListener("touchstart", onFirstInteraction, {
      passive: true,
      once: true,
    });
    window.addEventListener("keydown", onFirstInteraction, {
      passive: true,
      once: true,
    });

    const deferUntilIdle = () => {
      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(
          () => {
            setTimeout(start, 200);
          },
          { timeout: 2000 },
        );
      } else {
        setTimeout(start, 400);
      }
    };

    if (document.readyState === "complete") {
      deferUntilIdle();
    } else {
      window.addEventListener("load", deferUntilIdle, { once: true });
    }
  }

  scheduleSystemDepth();
</script>

<style>
  .system-depth-container {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    transform: translateZ(0);
  }

  .system-depth-container.is-subpage {
    opacity: 0.62;
  }

  #system-depth-canvas {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity;
  }

  #system-depth-canvas.is-visible {
    opacity: 1;
  }

  /* Soft gradient vignette to guarantee WCAG AAA foreground text legibility */
  .system-depth-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 50%,
      transparent 30%,
      rgba(5, 11, 9, 0.54) 80%,
      rgba(5, 11, 9, 0.9) 100%
    );
  }
</style>
