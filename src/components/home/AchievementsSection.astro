---
import SectionHeading from "../ui/SectionHeading.astro";
import { achievements } from "../../data/portfolio";
---

<section class="section shell" id="achievements">
  <SectionHeading
    index="05 / MILESTONES"
    titleEn="Achievements"
    titleVi="Thành tựu"
    descriptionEn="Recognition across product thinking, open-source engineering and measurable AI system quality."
    descriptionVi="Dấu ấn trong tư duy sản phẩm, kỹ thuật phần mềm nguồn mở và chất lượng hệ thống AI có thể đo lường."
  />

  <div class="achievement-grid">
    {achievements.map((achievement, index) => {
      const external = achievement.href.startsWith("http");
      return (
        <article class:list={["achievement-card", "panel", { featured: index === 0 }]}>
          <div class="achievement-visual">
            <span>{achievement.metric}</span>
            <i aria-hidden="true"></i>
          </div>
          <div class="achievement-copy">
            <span class="achievement-tag" data-en={achievement.tagEn} data-vi={achievement.tagVi}>{achievement.tagEn}</span>
            <h3 data-en={achievement.titleEn} data-vi={achievement.titleVi}>{achievement.titleEn}</h3>
            <small data-en={achievement.metaEn} data-vi={achievement.metaVi}>{achievement.metaEn}</small>
            <p data-en={achievement.descriptionEn} data-vi={achievement.descriptionVi}>{achievement.descriptionEn}</p>
            {achievement.href && (
              <a
                class="text-link"
                href={achievement.href}
                target={external ? "_blank" : undefined}
                rel={external ? "noreferrer" : undefined}
              >
                <span data-en="View related work" data-vi="Xem dự án liên quan">View related work</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .achievement-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

  .achievement-card {
    display: grid;
    min-height: 310px;
    grid-template-columns: 190px 1fr;
    overflow: hidden;
    border-radius: 20px;
  }

  .achievement-card.featured { grid-column: span 2; grid-template-columns: minmax(280px, 0.7fr) 1fr; }

  .achievement-visual {
    position: relative;
    display: grid;
    min-height: 100%;
    place-items: center;
    overflow: hidden;
    border-right: 1px solid var(--border-default);
    background:
      linear-gradient(45deg, transparent 49%, rgb(117 230 178 / 7%) 50%, transparent 51%),
      linear-gradient(-45deg, transparent 49%, rgb(124 183 255 / 5%) 50%, transparent 51%),
      radial-gradient(circle, rgb(24 199 133 / 15%), transparent 55%),
      #07130f;
    background-size: 34px 34px, 34px 34px, auto, auto;
  }

  .achievement-visual::before {
    position: absolute;
    width: 120px;
    height: 120px;
    border: 1px solid rgb(117 230 178 / 20%);
    border-radius: 50%;
    box-shadow: 0 0 0 14px rgb(117 230 178 / 2.5%), 0 0 0 28px rgb(117 230 178 / 1.8%);
    content: "";
  }

  .featured .achievement-visual::before { width: 170px; height: 170px; }
  .achievement-visual span { z-index: 2; color: var(--brand-soft); font-family: var(--font-mono); font-size: 1rem; font-weight: 600; }
  .achievement-visual i { position: absolute; width: 8px; height: 8px; transform: translate(63px, -63px); border-radius: 50%; background: var(--technical-blue); box-shadow: 0 0 18px var(--technical-blue); }
  .achievement-copy { display: flex; flex-direction: column; justify-content: center; padding: 34px; }
  .achievement-tag { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.1em; }
  h3 { margin: 12px 0 7px; font-size: 1.3rem; letter-spacing: -0.025em; }
  .achievement-copy > small { color: var(--technical-soft); font-size: 0.66rem; }
  p { margin: 18px 0 0; color: var(--text-muted); font-size: 0.82rem; }

  @media (max-width: 820px) {
    .achievement-grid { grid-template-columns: 1fr; }
    .achievement-card,
    .achievement-card.featured { grid-column: span 1; grid-template-columns: 150px 1fr; }
  }

  @media (max-width: 540px) {
    .achievement-card,
    .achievement-card.featured { grid-template-columns: 1fr; }
    .achievement-visual { min-height: 190px; border-right: 0; border-bottom: 1px solid var(--border-default); }
    .achievement-copy { padding: 28px; }
  }
</style>
