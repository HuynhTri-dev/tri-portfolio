---
/**
 * @name CyberForestHud.astro
 * @description Provides 2D symbiotic SVG circuit vines with flowing data pulses,
 *              glassmorphic crystal leaves, a real-time Technical Field HUD
 *              (Bio-Metrics, Compass, Scroll Depth & Biome tracker), and a
 *              delegated Magnetic Spotlight Border tracker for glass panels.
 */

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<!-- Symbiotic SVG Circuit Vines & Glassmorphic Leaves -->
<div class="cyber-vines-layer" aria-hidden="true">
  <!-- Left Root-to-Canopy Circuit Vine -->
  <svg
    class="circuit-vine circuit-vine--left"
    viewBox="0 0 220 800"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="vineGradLeft" x1="0" y1="800" x2="120" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#7d553d" stop-opacity="0.55" />
        <stop offset="48%" stop-color="#18c785" stop-opacity="0.38" />
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.14" />
      </linearGradient>
    </defs>

    <!-- Primary organic-PCB trunk conduit -->
    <path
      class="vine-conduit"
      d="M 16 800 C 24 670, 68 590, 52 465 C 36 340, 88 245, 64 115 C 54 62, 32 24, 18 0"
      stroke="url(#vineGradLeft)"
      stroke-width="1.6"
    />
    <!-- Animated bioluminescent sap pulse -->
    <path
      class="vine-pulse vine-pulse--primary"
      d="M 16 800 C 24 670, 68 590, 52 465 C 36 340, 88 245, 64 115 C 54 62, 32 24, 18 0"
      stroke="#75e6b2"
      stroke-width="2"
      stroke-linecap="round"
    />

    <!-- PCB Micro-branch offshoots -->
    <path
      class="vine-branch-trace"
      d="M 55 540 L 92 504 L 136 504 M 48 395 L 88 355 L 122 355 M 72 225 L 108 190 L 146 190"
      stroke="rgba(117, 230, 178, 0.22)"
      stroke-width="1.1"
    />
    <path
      class="vine-pulse vine-pulse--secondary"
      d="M 55 540 L 92 504 L 136 504 M 72 225 L 108 190 L 146 190"
      stroke="#38bdf8"
      stroke-width="1.5"
      stroke-linecap="round"
    />

    <!-- Circuit Junction Nodes -->
    <circle cx="55" cy="540" r="3" fill="#18c785" fill-opacity="0.7" />
    <circle cx="136" cy="504" r="2.5" fill="#75e6b2" fill-opacity="0.85" />
    <circle cx="48" cy="395" r="2.8" fill="#18c785" fill-opacity="0.65" />
    <circle cx="122" cy="355" r="2.2" fill="#38bdf8" fill-opacity="0.8" />
    <circle cx="72" cy="225" r="3" fill="#18c785" fill-opacity="0.7" />
    <circle cx="146" cy="190" r="2.5" fill="#75e6b2" fill-opacity="0.85" />
  </svg>

  <!-- Right Canopy-to-Root Circuit Vine -->
  <svg
    class="circuit-vine circuit-vine--right"
    viewBox="0 0 220 800"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="vineGradRight" x1="200" y1="0" x2="100" y2="800" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.28" />
        <stop offset="52%" stop-color="#18c785" stop-opacity="0.36" />
        <stop offset="100%" stop-color="#7d553d" stop-opacity="0.45" />
      </linearGradient>
    </defs>

    <path
      class="vine-conduit"
      d="M 202 0 C 188 135, 148 230, 166 360 C 184 490, 138 595, 168 720 C 176 756, 192 782, 204 800"
      stroke="url(#vineGradRight)"
      stroke-width="1.5"
    />
    <path
      class="vine-pulse vine-pulse--delayed"
      d="M 204 800 C 192 782, 176 756, 168 720 C 138 595, 184 490, 166 360 C 148 230, 188 135, 202 0"
      stroke="#4eedb0"
      stroke-width="2"
      stroke-linecap="round"
    />

    <path
      class="vine-branch-trace"
      d="M 164 280 L 126 244 L 88 244 M 162 510 L 122 474 L 84 474"
      stroke="rgba(124, 183, 255, 0.2)"
      stroke-width="1.1"
    />
    <circle cx="164" cy="280" r="2.8" fill="#38bdf8" fill-opacity="0.7" />
    <circle cx="88" cy="244" r="2.4" fill="#75e6b2" fill-opacity="0.8" />
    <circle cx="162" cy="510" r="2.8" fill="#18c785" fill-opacity="0.7" />
    <circle cx="84" cy="474" r="2.4" fill="#38bdf8" fill-opacity="0.8" />
  </svg>

  <!-- Glassmorphic Bioluminescent Leaves -->
  <div class="glass-leaf glass-leaf--left-low">
    <span class="leaf-vein"></span>
  </div>
  <div class="glass-leaf glass-leaf--left-high">
    <span class="leaf-vein"></span>
  </div>
  <div class="glass-leaf glass-leaf--right-mid">
    <span class="leaf-vein"></span>
  </div>
</div>

<!-- Subtle Technical Field HUD -->
<aside
  class="forest-field-hud"
  data-forest-hud
  data-is-home={isHome ? "true" : "false"}
  aria-hidden="true"
>
  <div class="hud-top-row">
    <span class="hud-beacon"></span>
    <span class="hud-status">BIO-METRICS: ACTIVE</span>
    <span class="hud-node">SG_CORE_1109</span>
  </div>

  <div class="hud-body-row">
    <div class="hud-compass" title="Spatial Vector Compass">
      <svg viewBox="0 0 36 36" width="32" height="32">
        <circle
          cx="18"
          cy="18"
          r="15"
          fill="none"
          stroke="rgba(117, 230, 178, 0.24)"
          stroke-width="1"
          stroke-dasharray="3 3"
        />
        <circle
          cx="18"
          cy="18"
          r="9"
          fill="none"
          stroke="rgba(56, 189, 248, 0.22)"
          stroke-width="1"
        />
        <g data-hud-needle style="transform-origin: 18px 18px;">
          <polygon points="18,5 20.6,18 18,15.8 15.4,18" fill="#18c785" />
          <polygon points="18,31 20,18 18,20.2 16,18" fill="rgba(182, 195, 188, 0.38)" />
        </g>
      </svg>
    </div>

    <div class="hud-telemetry">
      <div class="hud-metric-line">
        <span class="hud-key">BIOME</span>
        <strong class="hud-val hud-biome" data-hud-biome>CANOPY HORIZON</strong>
      </div>
      <div class="hud-metric-line">
        <span class="hud-key">DEPTH</span>
        <strong class="hud-val" data-hud-depth>-00.0m</strong>
        <span class="hud-sep">·</span>
        <span class="hud-coords" data-hud-coords>10.762°N 106.660°E</span>
      </div>
    </div>
  </div>
</aside>

<script>
  /**
   * @name cyberForestInteractionController
   * @description Updates the Technical Field HUD (scroll depth, active biome,
   *              spatial compass vector) and drives the delegated Magnetic
   *              Spotlight Border glow across all `.panel` surfaces.
   */
  const BIOME_STAGES = [
    { max: 0.14, name: "CANOPY HORIZON" },
    { max: 0.3, name: "MYCELIUM ROOTS" },
    { max: 0.48, name: "PRODUCTION TRAIL" },
    { max: 0.68, name: "CRYSTAL GROVE" },
    { max: 0.86, name: "MONOLITH PORTALS" },
    { max: 1.01, name: "SANCTUARY GLADE" },
  ];

  const depthEl = document.querySelector<HTMLElement>("[data-hud-depth]");
  const biomeEl = document.querySelector<HTMLElement>("[data-hud-biome]");
  const coordsEl = document.querySelector<HTMLElement>("[data-hud-coords]");
  const needleEl = document.querySelector<SVGGElement>("[data-hud-needle]");
  const hudRoot = document.querySelector<HTMLElement>("[data-forest-hud]");

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let scrollTicking = false;
  function updateHudScroll(): void {
    scrollTicking = false;
    const maxScroll = Math.max(
      1,
      document.documentElement.scrollHeight - window.innerHeight,
    );
    const ratio = Math.min(1, Math.max(0, window.scrollY / maxScroll));
    const meters = (ratio * 48.0).toFixed(1).padStart(4, "0");

    if (depthEl) {
      depthEl.textContent = `-${meters}m`;
    }

    if (biomeEl) {
      const stage =
        BIOME_STAGES.find((s) => ratio <= s.max) ??
        BIOME_STAGES[BIOME_STAGES.length - 1];
      biomeEl.textContent = stage.name;
    }
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!scrollTicking) {
        scrollTicking = true;
        window.requestAnimationFrame(updateHudScroll);
      }
    },
    { passive: true },
  );
  updateHudScroll();

  // Delegated Pointer Tracking for Compass + Magnetic Card Spotlight Border
  let activeCard: HTMLElement | null = null;
  let pointerRaf = 0;
  let lastClientX = 0;
  let lastClientY = 0;

  function processPointerFrame(): void {
    pointerRaf = 0;

    // 1. Update HUD compass & micro-coordinates
    if (hudRoot && window.innerWidth >= 860) {
      const normX = lastClientX / window.innerWidth - 0.5;
      const normY = lastClientY / window.innerHeight - 0.5;
      const angleDeg = Math.atan2(normY, normX) * (180 / Math.PI) + 90;

      if (needleEl && !reduceMotion) {
        needleEl.style.transform = `rotate(${angleDeg.toFixed(1)}deg)`;
      }
      if (coordsEl) {
        const lat = (10.762 + normY * -0.008).toFixed(3);
        const lng = (106.66 + normX * 0.008).toFixed(3);
        coordsEl.textContent = `${lat}°N ${lng}°E`;
      }
    }

    // 2. Update Magnetic Spotlight coordinates on hovered card
    if (activeCard) {
      const rect = activeCard.getBoundingClientRect();
      const relX = lastClientX - rect.left;
      const relY = lastClientY - rect.top;
      activeCard.style.setProperty("--spot-x", `${relX.toFixed(1)}px`);
      activeCard.style.setProperty("--spot-y", `${relY.toFixed(1)}px`);
    }
  }

  if (!reduceMotion) {
    document.addEventListener(
      "pointermove",
      (e: PointerEvent) => {
        if (e.pointerType === "touch") return;
        lastClientX = e.clientX;
        lastClientY = e.clientY;

        const target = e.target as HTMLElement | null;
        const nextCard =
          target?.closest<HTMLElement>(
            ".panel, .beyond-card, .work-availability-card",
          ) ?? null;

        if (activeCard && activeCard !== nextCard) {
          activeCard.removeAttribute("data-spot-active");
        }
        if (nextCard) {
          nextCard.setAttribute("data-spot-active", "true");
        }
        activeCard = nextCard;

        if (!pointerRaf) {
          pointerRaf = window.requestAnimationFrame(processPointerFrame);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .cyber-vines-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    contain: paint;
  }

  .circuit-vine {
    position: absolute;
    width: 210px;
    height: 86vh;
    opacity: 0.72;
  }

  .circuit-vine--left {
    left: 0;
    bottom: 0;
  }

  .circuit-vine--right {
    right: 0;
    top: 4vh;
  }

  .vine-pulse {
    stroke-dasharray: 28 280;
    stroke-dashoffset: 308;
    filter: drop-shadow(0 0 6px rgb(24 199 133 / 65%));
    animation: sapFlow 5.4s linear infinite;
  }

  .vine-pulse--secondary {
    stroke-dasharray: 14 160;
    stroke-dashoffset: 174;
    filter: drop-shadow(0 0 5px rgb(56 189 248 / 65%));
    animation: sapFlowSecondary 4.2s linear infinite 1.1s;
  }

  .vine-pulse--delayed {
    animation-duration: 6.2s;
    animation-delay: 1.8s;
  }

  @keyframes sapFlow {
    from {
      stroke-dashoffset: 308;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes sapFlowSecondary {
    from {
      stroke-dashoffset: 174;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Glassmorphic Crystal Leaves */
  .glass-leaf {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(117, 230, 178, 0.24);
    border-radius: 68% 32% 64% 36% / 62% 38% 62% 38%;
    background: linear-gradient(
      135deg,
      rgba(24, 199, 133, 0.09),
      rgba(56, 189, 248, 0.03) 65%,
      rgba(5, 14, 10, 0.18)
    );
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 28px rgba(0, 0, 0, 0.22);
    transform: translateZ(0);
  }

  .leaf-vein {
    width: 68%;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(117, 230, 178, 0.55),
      rgba(56, 189, 248, 0.25),
      transparent
    );
    box-shadow: 0 0 8px rgba(24, 199, 133, 0.45);
    transform: rotate(-14deg);
  }

  .glass-leaf--left-low {
    bottom: 14%;
    left: 26px;
    width: 96px;
    height: 54px;
    transform: rotate(-18deg) translateZ(0);
    opacity: 0.65;
  }

  .glass-leaf--left-high {
    top: 26%;
    left: 34px;
    width: 78px;
    height: 44px;
    transform: rotate(14deg) translateZ(0);
    opacity: 0.48;
  }

  .glass-leaf--right-mid {
    top: 34%;
    right: 30px;
    width: 88px;
    height: 48px;
    transform: rotate(162deg) translateZ(0);
    opacity: 0.52;
  }

  /* Technical Field HUD */
  .forest-field-hud {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 35;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 10px 13px;
    border: 1px solid rgba(117, 230, 178, 0.24);
    border-radius: 14px;
    background: linear-gradient(
      155deg,
      rgba(8, 22, 17, 0.86),
      rgba(4, 11, 8, 0.92)
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 12px 30px rgba(0, 0, 0, 0.45);
    font-family: var(--font-mono);
    pointer-events: none;
    user-select: none;
    transform: translateZ(0);
  }

  .hud-top-row {
    display: flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(142, 190, 166, 0.14);
    font-size: var(--text-micro, 0.7rem);
    letter-spacing: 0.06em;
  }

  .hud-beacon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 8px var(--brand-green);
    animation: hudPulse 2.2s ease-in-out infinite;
  }

  @keyframes hudPulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  .hud-status {
    color: var(--brand-soft);
    font-weight: 600;
  }

  .hud-node {
    margin-left: auto;
    color: var(--text-muted);
  }

  .hud-body-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hud-compass {
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .hud-telemetry {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hud-metric-line {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-micro, 0.7rem);
    line-height: 1.35;
    white-space: nowrap;
  }

  .hud-key {
    color: var(--text-muted);
  }

  .hud-val {
    color: var(--text-main);
    font-weight: 600;
  }

  .hud-biome {
    color: var(--brand-soft);
    letter-spacing: 0.04em;
  }

  .hud-sep,
  .hud-coords {
    color: var(--text-muted);
  }

  @media (max-width: 1180px) {
    .circuit-vine {
      width: 140px;
      opacity: 0.45;
    }

    .glass-leaf--left-high,
    .glass-leaf--right-mid {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .forest-field-hud {
      display: none;
    }

    .circuit-vine--right,
    .glass-leaf {
      display: none;
    }

    .circuit-vine--left {
      width: 96px;
      opacity: 0.28;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vine-pulse,
    .hud-beacon {
      animation: none;
    }
  }
</style>

