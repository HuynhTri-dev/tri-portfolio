---
interface Props {
  index: string;
  titleEn: string;
  titleVi: string;
  descriptionEn: string;
  descriptionVi: string;
}

const { index, titleEn, titleVi, descriptionEn, descriptionVi } = Astro.props;
---

<div class="section-heading">
  <div>
    <span class="section-index">{index}</span>
    <h2 data-en={titleEn} data-vi={titleVi}>{titleEn}</h2>
  </div>
  <p data-en={descriptionEn} data-vi={descriptionVi}>{descriptionEn}</p>
</div>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.65fr);
    gap: 80px;
    align-items: end;
    margin-bottom: 48px;
  }

  h2 {
    margin: 12px 0 0;
    font-size: clamp(2.15rem, 4vw, 3.7rem);
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  p {
    max-width: 550px;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 820px) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }

  @media (max-width: 540px) {
    .section-heading { margin-bottom: 34px; }
    h2 { font-size: 2.15rem; }
    p { font-size: 0.84rem; }
  }
</style>
