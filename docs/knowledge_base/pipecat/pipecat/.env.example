# Sao chép thành /opt/pipecat-voicebot/.env trên VM (hoặc merge vào .env lab)

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
# ElevenLabs API id: eleven_v4_turbo (turbo v4)
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# Chỉ dùng với turbo/flash v2_5 — bỏ trống khi dùng eleven_v4_turbo
# ELEVENLABS_TTS_OPTIMIZE_LATENCY=3
# Khớp VAD_STOP_SECS (~0.2s): benchmark hoặc 0.8–1.0 cho phản hồi nhanh
ELEVENLABS_STT_TTFS_P99_LATENCY=0.85

OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:cloud
OLLAMA_TEMPERATURE=0.4
OLLAMA_MAX_COMPLETION_TOKENS=280

PIPECAT_HOST=127.0.0.1
PIPECAT_PORT=10003
# Khớp Asterisk Dial: c(slin16) = PCM 16 kHz (ulaw PJSIP transcoding lab)
PIPECAT_SAMPLE_RATE=16000
MEDIA_READY_DELAY_SECS=0.3
# Chặn mic vào STT khi bot nói + tail sau BotStoppedSpeaking (giảm vang loa)
STT_ECHO_GATE_TAIL_SECS=0.18
# Chen lời: cắt TTS khi khách nói; echo gate dùng VAD để mở mic trong lúc bot đọc
PIPECAT_ENABLE_INTERRUPTIONS=true
STT_ECHO_GATE_BARGE_IN=true

VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
# Im lặng trước khi chốt lượt → gửi STT/LLM (0.2–0.25 nhanh; 0.55 chậm hơn ~300ms+)
VAD_STOP_SECS=0.22
VAD_MIN_VOLUME=0.5

LOG_LEVEL=INFO

# Tùy chọn: VM đẩy WAV khi MixMonitor xong (cần SSH key VM → máy dev, Mac bật Remote Login)
# AUDIO_SYNC_DEST=user@171.253.156.99:/Users/macbookair/Downloads/idb/06-10-2026/audio
