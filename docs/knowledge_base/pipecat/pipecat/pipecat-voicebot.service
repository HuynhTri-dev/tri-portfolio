[Unit]
Description=Pipecat bank voicebot (Asterisk WebSocket :10003)
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
WorkingDirectory=/opt/pipecat-voicebot
EnvironmentFile=/opt/pipecat-voicebot/.env
ExecStart=/opt/pipecat-voicebot/venv/bin/python /opt/pipecat-voicebot/main.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
